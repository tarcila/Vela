+// A generic test operation kind whose behaviour each test scripts.
+struct FakeOp
+{
+  int runs{0};
+  std::function<Step(StepContext &, int)> script;
+
+  Executor executor()
+  {
+    return [this](StepContext &ctx) {
+      ++runs;
+      if (script)
+        return script(ctx, runs);
+      Step s;
+      s.result = "done";
+      return s;
+    };
+  }
+};
