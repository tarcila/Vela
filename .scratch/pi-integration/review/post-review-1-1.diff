+namespace vsr::integration::render {
+
+/*
+ * Revision-pinned rendering of a registered view (spec §12, deadlines §5).
+ *
+ * A render names a view plus the scene/view revision tokens the client
+ * observed. At the safe point both must still be current, the view's
+ * dimensions valid (1..1024 per axis, owned by the view, never clamped) and
+ * its scene synchronization-ready; otherwise the request ends superseded /
+ * invalid_request / sync_required without backend work. The same token and
+ * readiness checks repeat when the backend finishes, so a relevant change
+ * mid-render prevents success.
+ *
+ * The host supplies one RenderBackend per view and calls pump() from its
+ * loop so in-flight backend work is re-examined at a later safe point.
+ * Cancelled/timed-out work never succeeds from a late image; its backend
+ * resources (and scene slot) stay held until RenderBackend::release()
+ * reports safe release. While any render holds the view's backend resources
+ * new renders of that view reject busy before admission (one frame per
+ * view; ticket 91 records this assumption).
+ *
+ * Threading: registerView() before any render; setDimensions(), pump(),
+ * submit*() and result*() are thread-safe. Backends are only driven on the
+ * servicing thread.
+ */
+
+using identity::SceneRevision;
+using identity::ViewRevision;
+using operations::LocalAdmission;
+using operations::LocalRef;
+using operations::OperationRef;
+using operations::Outcome;
+
+constexpr std::uint32_t MAX_RENDER_DIMENSION = 1024;
+constexpr double RENDER_DEADLINE_SECONDS = 30.0;
+
+inline bool validDimensions(std::uint32_t w, std::uint32_t h)
+{
+  return w >= 1 && h >= 1 && w <= MAX_RENDER_DIMENSION
+      && h <= MAX_RENDER_DIMENSION;
+}
+
+enum class BackendState
+{
+  PENDING,
+  DONE,
+  FAULT // an actual backend-reported fault
+};
+
+// Host-owned rendering resources of one view. Called on the servicing thread.
+struct RenderBackend
+{
+  virtual ~RenderBackend() = default;
+  // Starts one frame at exactly these dimensions; false on failure.
+  virtual bool begin(std::uint32_t width, std::uint32_t height) = 0;
+  // Non-blocking.
+  virtual BackendState poll() = 0;
+  // Valid after DONE until release().
+  virtual image::SourceImage image() = 0;
+  // Releases frame resources; false while release is not yet safe (retried
+  // at later safe points, indefinitely if necessary).
+  virtual bool release() = 0;
+};
+
+struct RenderRequest
+{
+  ViewId view{INVALID_VIEW_ID};
+  SceneRevision sceneRevision;
+  ViewRevision viewRevision;
+};
+
+struct RenderResult
+{
+  Outcome outcome{Outcome::OK};
+  // Present on success only.
+  std::uint32_t width{0};
+  std::uint32_t height{0};
+  std::vector<std::uint8_t> png;
+  bool imageEvicted{false};
+  SceneRevision sceneRevision; // exactly the matched tokens
+  ViewRevision viewRevision;
+  std::uint64_t capture{0}; // unique per fresh capture; replays keep it
+};
+
+class RenderService
+{
+ public:
+  RenderService(Integration &integration,
+      operations::OperationEngine &engine,
+      const sync::SyncService &sync,
+      activity::ActivityLog &log);
+  ~RenderService();
+  RenderService(const RenderService &) = delete;
+  RenderService &operator=(const RenderService &) = delete;
+
+  // Host: a registered view, its scene identity, revision tracker and
+  // backend. All must outlive this service.
+  bool attachView(ViewId view,
+      identity::SceneIdentity &scene,
+      identity::ViewRevisionTracker &tracker,
+      RenderBackend &backend);
+  // Host: view-owned dimensions (also advance the view revision).
+  void setDimensions(ViewId view, std::uint32_t width, std::uint32_t height);
+
+  // Invalid dimensions and views with resources held by abandoned work
+  // reject before admission (invalid_request / busy).
+  operations::Admission submit(const operations::Credentials &credentials,
+      const OperationRef &ref,
+      RenderRequest request);
+  LocalAdmission submitLocal(RenderRequest request);
+
+  std::optional<RenderResult> result(const OperationRef &ref) const;
+  std::optional<RenderResult> resultLocal(LocalRef ref) const;
+
+  // Host loop: re-examines in-flight backend work at the next safe point.
+  void pump();
+  // Backend begin() calls so far (fresh-capture evidence for tests/metrics).
+  std::uint64_t backendStarts() const;
+
+ private:
+  struct Job
+  {
+    bool started{false};
+    bool viewHeld{false};
+    // Guard/fault terminated the request but release was not yet safe.
+    std::optional<Outcome> pendingOutcome;
+    std::function<void()> wake;
+    std::optional<RenderResult> result;
+    std::optional<RenderResult> pendingResult; // until safe release
+    std::optional<OperationRef> ref;
+    std::optional<LocalRef> localRef;
+    std::optional<activity::ActivityLog::Id> logId;
+  };
+  using JobPtr = std::shared_ptr<Job>;
+
+  struct View
+  {
+    identity::SceneIdentity *scene{nullptr};
+    identity::ViewRevisionTracker *tracker{nullptr};
+    RenderBackend *backend{nullptr};
+    std::uint32_t width{0};
+    std::uint32_t height{0};
+    Job *holder{nullptr}; // job holding backend resources
+    bool holderAbandoned{false};
+  };
+
+  std::optional<Outcome> preAdmission(const RenderRequest &request) const;
+  operations::Request makeRequest(RenderRequest request, JobPtr job);
+  operations::Step step(
+      const RenderRequest &request, Job &job, operations::StepContext &ctx);
+  operations::Step finishJob(Job &job, Outcome outcome);
+  void record(Job &job, ViewId view);
+  void completeSuccess(Job &job, ViewId view, operations::Step &s);
+
+  Integration &m_integration;
+  operations::OperationEngine &m_engine;
+  const sync::SyncService &m_sync;
+  activity::ActivityLog &m_log;
+  std::shared_ptr<bool> m_alive;
+
+  mutable std::mutex m_mutex;
+  std::map<ViewId, View> m_views;
+  std::map<std::pair<std::string, std::uint64_t>, JobPtr> m_results;
+  std::map<std::uint64_t, JobPtr> m_localResults;
+  std::vector<std::weak_ptr<Job>> m_inFlight;
+  std::uint64_t m_starts{0};
+  std::uint64_t m_captures{0};
+};
+
+///////////////////////////////////////////////////////////////////////////////
+// Inlined definitions ////////////////////////////////////////////////////////
+///////////////////////////////////////////////////////////////////////////////
+
+namespace detail {
+
+template <typename R>
+inline std::string revisionText(const R &r)
+{
+  return std::to_string(r.launch.activation) + "."
+      + std::to_string(r.launch.nonce) + "." + std::to_string(r.domain) + "."
+      + std::to_string(r.value);
+}
+
+} // namespace detail
+
+inline RenderService::RenderService(Integration &integration,
+    operations::OperationEngine &engine,
+    const sync::SyncService &sync,
+    activity::ActivityLog &log)
+    : m_integration(integration),
+      m_engine(engine),
+      m_sync(sync),
+      m_log(log),
+      m_alive(std::make_shared<bool>(true))
+{}
+
+inline RenderService::~RenderService()
+{
+  m_alive.reset();
+}
+
+inline bool RenderService::attachView(ViewId view,
+    identity::SceneIdentity &scene,
+    identity::ViewRevisionTracker &tracker,
+    RenderBackend &backend)
+{
+  if (!m_integration.isRegisteredView(view))
+    return false;
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto &v = m_views[view];
+  v.scene = &scene;
+  v.tracker = &tracker;
+  v.backend = &backend;
+  return true;
+}
+
+inline void RenderService::setDimensions(
+    ViewId view, std::uint32_t width, std::uint32_t height)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto it = m_views.find(view);
+  if (it == m_views.end())
+    return;
+  it->second.width = width;
+  it->second.height = height;
+  it->second.tracker->setDimensions(width, height);
+}
+
+inline std::optional<Outcome> RenderService::preAdmission(
+    const RenderRequest &request) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto it = m_views.find(request.view);
+  if (it == m_views.end())
+    return Outcome::INVALID_REQUEST;
+  if (!validDimensions(it->second.width, it->second.height))
+    return Outcome::INVALID_REQUEST; // never clamped or resized
+  if (it->second.holder)
+    return Outcome::BUSY; // necessary view resources held (see ticket 91)
+  return std::nullopt;
+}
+
+inline operations::Request RenderService::makeRequest(
+    RenderRequest request, JobPtr job)
+{
+  operations::Request r;
+  r.kind = "render";
+  r.target = session::Target::view(request.view);
+  r.capability = session::Capability::RENDER;
+  r.canonicalArguments = "render;view=" + std::to_string(request.view)
+      + ";scene=" + detail::revisionText(request.sceneRevision)
+      + ";view_revision=" + detail::revisionText(request.viewRevision);
+  r.deadlineSeconds = RENDER_DEADLINE_SECONDS;
+  std::weak_ptr<bool> alive = m_alive;
+  r.executor = [this, alive, request, job](operations::StepContext &ctx) {
+    if (!alive.lock())
+      return operations::Step{};
+    return step(request, *job, ctx);
+  };
+  return r;
+}
+
+inline operations::Step RenderService::finishJob(Job &job, Outcome outcome)
+{
+  operations::Step s;
+  s.status = operations::Step::Status::COMPLETE;
+  s.outcome = outcome;
+  if (!job.result)
+    job.result = RenderResult{};
+  job.result->outcome = outcome;
+  return s;
+}
+
+inline operations::Step RenderService::step(
+    const RenderRequest &request, Job &job, operations::StepContext &ctx)
+{
+  using S = operations::Step::Status;
+  View *v = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_views.find(request.view);
+    if (it != m_views.end())
+      v = &it->second;
+  }
+
+  // Abandoned work only releases resources; never produces an image.
+  if (ctx.abandoned) {
+    if (job.viewHeld && v) {
+      {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        v->holderAbandoned = true;
+      }
+      if (!v->backend->release()) {
+        operations::Step s;
+        s.status = S::BACKEND_PENDING;
+        return s;
+      }
+      std::lock_guard<std::mutex> lock(m_mutex);
+      v->holder = nullptr;
+      v->holderAbandoned = false;
+      job.viewHeld = false;
+    }
+    return operations::Step{};
+  }
+
+  if (!v)
+    return finishJob(job, Outcome::INVALID_REQUEST);
+
+  auto tokensMatch = [&] {
+    return v->scene->sceneRevision() == request.sceneRevision
+        && v->tracker->revision() == request.viewRevision;
+  };
+  auto releaseOrHold = [&](Outcome outcome) {
+    if (!v->backend->release()) {
+      // Guard terminated the request; resources stay held until safe.
+      std::lock_guard<std::mutex> lock(m_mutex);
+      v->holderAbandoned = true;
+      job.pendingOutcome = outcome;
+      operations::Step s;
+      s.status = S::BACKEND_PENDING;
+      return s;
+    }
+    std::lock_guard<std::mutex> lock(m_mutex);
+    v->holder = nullptr;
+    v->holderAbandoned = false;
+    job.viewHeld = false;
+    return finishJob(job, outcome);
+  };
+
+  job.wake = ctx.wake;
+  if (job.pendingOutcome) {
+    const Outcome o = *job.pendingOutcome;
+    job.pendingOutcome.reset();
+    if (o == Outcome::OK) {
+      // Success waits on safe release too; not reported before it.
+      operations::Step s = releaseOrHold(Outcome::OK);
+      if (s.status == S::COMPLETE)
+        completeSuccess(job, request.view, s);
+      else
+        job.pendingOutcome = Outcome::OK;
+      return s;
+    }
+    return releaseOrHold(o);
+  }
+
+  if (!job.started) {
+    if (!tokensMatch())
+      return finishJob(job, Outcome::SUPERSEDED);
+    std::uint32_t w, h;
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      w = v->width;
+      h = v->height;
+      if (v->holder)
+        return finishJob(job, Outcome::BUSY);
+    }
+    if (!validDimensions(w, h))
+      return finishJob(job, Outcome::INVALID_REQUEST);
+    if (!m_sync.viewReady(request.view))
+      return finishJob(job, Outcome::SYNC_REQUIRED);
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      v->holder = &job;
+      v->holderAbandoned = false;
+      job.viewHeld = true;
+      job.started = true;
+      job.wake = ctx.wake;
+      ++m_starts;
+    }
+    if (!v->backend->begin(w, h)) {
+      operations::Step s = releaseOrHold(Outcome::UNKNOWN);
+      s.backendFault = true;
+      return s;
+    }
+    operations::Step s;
+    s.status = S::BACKEND_PENDING;
+    return s;
+  }
+
+  switch (v->backend->poll()) {
+  case BackendState::PENDING: {
+    operations::Step s;
+    s.status = S::BACKEND_PENDING;
+    return s;
+  }
+  case BackendState::FAULT: {
+    operations::Step s = releaseOrHold(Outcome::UNKNOWN);
+    s.backendFault = true;
+    return s;
+  }
+  case BackendState::DONE:
+    break;
+  }
+
+  // Completion guards: relevant changes and readiness loss prevent success.
+  if (!tokensMatch())
+    return releaseOrHold(Outcome::SUPERSEDED);
+  if (!m_sync.viewReady(request.view))
+    return releaseOrHold(Outcome::SYNC_REQUIRED);
+
+  auto normalized = image::normalizeToPng(v->backend->image());
+  if (!normalized.ok())
+    return releaseOrHold(Outcome::UNKNOWN);
+  RenderResult r;
+  r.width = normalized.image.width;
+  r.height = normalized.image.height;
+  r.png = std::move(normalized.image.png);
+  r.sceneRevision = request.sceneRevision;
+  r.viewRevision = request.viewRevision;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    r.capture = ++m_captures;
+  }
+  job.pendingResult = std::move(r);
+  operations::Step s = releaseOrHold(Outcome::OK);
+  if (s.status == S::COMPLETE)
+    completeSuccess(job, request.view, s);
+  return s;
+}
+
+inline void RenderService::completeSuccess(
+    Job &job, ViewId view, operations::Step &s)
+{
+  job.result = std::move(job.pendingResult);
+  job.pendingResult.reset();
+  job.result->outcome = Outcome::OK;
+  record(job, view);
+  s.result = "{\"width\":" + std::to_string(job.result->width)
+      + ",\"height\":" + std::to_string(job.result->height)
+      + ",\"scene_revision\":\""
+      + detail::revisionText(job.result->sceneRevision)
+      + "\",\"view_revision\":\""
+      + detail::revisionText(job.result->viewRevision)
+      + "\",\"capture\":" + std::to_string(job.result->capture) + "}";
+}
+
+inline void RenderService::record(Job &job, ViewId view)
+{
+  // Completed image stored through the activity model and its image budget.
+  activity::Entry e;
+  e.ref = job.ref;
+  e.localRef = job.localRef;
+  e.kind = activity::OperationKind::RENDER;
+  e.targets = activity::coveredTargets(activity::OperationKind::RENDER,
+      session::Target::view(view),
+      m_integration);
+  e.terminal = Outcome::OK;
+  e.image = job.result->png;
+  job.logId = m_log.append(std::move(e));
+  if (!job.logId) {
+    job.result->imageEvicted = true;
+    return;
+  }
+  auto stored = m_log.get(*job.logId);
+  job.result->imageEvicted = !stored || stored->imageEvicted;
+}
+
+inline operations::Admission RenderService::submit(
+    const operations::Credentials &credentials,
+    const OperationRef &ref,
+    RenderRequest request)
+{
+  bool known = false;
+  {
+    // Identical retries replay without new work, even when now busy.
+    std::lock_guard<std::mutex> lock(m_mutex);
+    known = m_results.count({ref.sessionId, ref.requestId}) > 0;
+  }
+  if (!known) {
+    if (auto rejected = preAdmission(request)) {
+      operations::Admission a;
+      a.code = *rejected;
+      return a;
+    }
+  }
+  auto job = std::make_shared<Job>();
+  job->ref = ref;
+  auto a = m_engine.submit(credentials, ref, makeRequest(request, job));
+  if (a.code == Outcome::OK && !a.replayed) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_results[{ref.sessionId, ref.requestId}] = job;
+    m_inFlight.push_back(job);
+  }
+  return a;
+}
+
+inline LocalAdmission RenderService::submitLocal(RenderRequest request)
+{
+  if (auto rejected = preAdmission(request)) {
+    LocalAdmission a;
+    a.code = *rejected;
+    return a;
+  }
+  auto job = std::make_shared<Job>();
+  auto a = m_engine.submitLocal(makeRequest(request, job));
+  if (a.code == Outcome::OK) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    job->localRef = a.ref;
+    m_localResults[a.ref.id] = job;
+    m_inFlight.push_back(job);
+  }
+  return a;
+}
+
+inline std::optional<RenderResult> RenderService::result(
+    const OperationRef &ref) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto it = m_results.find({ref.sessionId, ref.requestId});
+  if (it == m_results.end())
+    return std::nullopt;
+  return it->second->result;
+}
+
+inline std::optional<RenderResult> RenderService::resultLocal(
+    LocalRef ref) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto it = m_localResults.find(ref.id);
+  if (it == m_localResults.end())
+    return std::nullopt;
+  return it->second->result;
+}
+
+inline void RenderService::pump()
+{
+  std::vector<std::function<void()>> wakes;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    std::vector<std::weak_ptr<Job>> keep;
+    for (auto &w : m_inFlight) {
+      auto j = w.lock();
+      if (!j)
+        continue;
+      if (j->wake)
+        wakes.push_back(j->wake);
+      keep.push_back(w);
+    }
+    m_inFlight.swap(keep);
+  }
+  for (auto &w : wakes)
+    w();
+}
+
+inline std::uint64_t RenderService::backendStarts() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_starts;
+}
+
+} // namespace vsr::integration::render
diff --git a/src/vsr/integration/restore/BatchRestore.hpp b/src/vsr/integration/restore/BatchRestore.hpp
new file mode 100644
index 0000000000..e982043a81
--- /dev/null
+++ b/src/vsr/integration/restore/BatchRestore.hpp
@@ -0,0 +1,447 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// Header-only: the vsr_integration library globs only top-level sources (see
+// ticket 19).
+
+#include "vsr/integration/edit/AgentEdit.hpp"
+// std
+#include <algorithm>
+#include <functional>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace vsr::integration::restore {
+
+/*
+ * One-way Batch Restoration (spec §11): return an eligible Agent Edit Batch's
+ * parameters to their recorded prior values, completely or not at all.
+ *
+ * A restoration explicitly names its batch with `target_batch_ref`; external
+ * work carries its own Operation Reference, local work uses host-local
+ * correlation and host authority. Both go through the OperationEngine, so
+ * they share admission, safe-point permission checks and serialization with
+ * edits. At the safe point every affected object's current parameter version
+ * must still equal the batch's recorded post-commit version; otherwise the
+ * restore rejects with `conflict` and nothing mutates. Versions only advance,
+ * so a conflict is permanent: the batch becomes CONFLICTING (its payload is
+ * released, never consumed) and later attempts report `conflict` again. A
+ * commit consumes eligibility even if the normal-synchronization hook then
+ * fails. With an ActivitySink installed, the log is authoritative: a batch it
+ * no longer marks eligible (expired or evicted) reports `outcome_unavailable`,
+ * and commit/conflict update its Eligibility to RESTORED/CONFLICTING.
+ * A restoration is never itself restorable: there is no redo.
+ *
+ * Threading: submit*() and queries are thread-safe; execution happens on the
+ * servicing thread. The service must outlive every service() call that may
+ * still run one of its steps.
+ */
+
+using edit::BatchRef;
+using edit::EditService;
+using identity::ParameterVersionToken;
+using identity::SceneIdentity;
+using identity::SceneRevision;
+using operations::Admission;
+using operations::LocalAdmission;
+using operations::LocalRef;
+using operations::OperationEngine;
+using operations::OperationRef;
+using operations::Outcome;
+
+struct RestoreRequest
+{
+  // The scene the batch belongs to; the operation's registered target.
+  SceneId scene{INVALID_SCENE_ID};
+  BatchRef targetBatchRef;
+};
+
+struct RestoreResult
+{
+  Outcome outcome{Outcome::OK};
+  bool committed{false};
+  BatchRef targetBatchRef;
+  std::optional<SceneRevision> sceneRevision; // resulting, on commit
+  std::vector<ParameterVersionToken> versions; // resulting, per object
+  // outcome_unavailable because the log/store expired the batch; unknown
+  // and wrong-launch references leave this false (addendum 04 §7).
+  bool expired{false};
+};
+
+// Test seam for preparation failures; return true to fail preparation.
+using RestoreFaultInjector = std::function<bool()>;
+
+class RestoreService
+{
+ public:
+  RestoreService(OperationEngine &engine, EditService &edits);
+  ~RestoreService();
+  RestoreService(const RestoreService &) = delete;
+  RestoreService &operator=(const RestoreService &) = delete;
+
+  // Host: associate a registered scene with its identity observer.
+  void attachScene(SceneId scene, SceneIdentity &identity);
+  void setFaultInjector(RestoreFaultInjector injector);
+
+  // External restoration under the current session.
+  Admission submit(const operations::Credentials &credentials,
+      const OperationRef &ref,
+      RestoreRequest request);
+  // Host-local Restore under host authority.
+  LocalAdmission submitLocal(RestoreRequest request);
+
+  std::optional<RestoreResult> result(const OperationRef &ref) const;
+  std::optional<RestoreResult> resultLocal(LocalRef ref) const;
+
+  // True while the batch is retained, not yet restored and not conflicting.
+  bool eligible(const BatchRef &ref) const;
+  bool restored(const BatchRef &ref) const;
+  bool conflicting(const BatchRef &ref) const;
+
+  static std::string canonicalArguments(const RestoreRequest &request);
+
+ private:
+  using Slot = std::shared_ptr<std::optional<RestoreResult>>;
+
+  static bool validEnvelope(const RestoreRequest &request);
+  operations::Request makeRequest(RestoreRequest request, Slot slot);
+  RestoreResult commit(
+      const RestoreRequest &request, operations::StepContext &ctx);
+  void markConflicting(const BatchRef &ref, operations::StepContext &ctx);
+
+  OperationEngine &m_engine;
+  EditService &m_edits;
+  RestoreFaultInjector m_fault;
+  std::shared_ptr<bool> m_alive;
+
+  mutable std::mutex m_mutex;
+  std::map<SceneId, SceneIdentity *> m_identities;
+  // Consumed / conflicting batch IDs (launch-qualified); payloads released.
+  std::set<std::string> m_consumed;
+  std::set<std::string> m_conflicting;
+  std::map<std::pair<std::string, std::uint64_t>, Slot> m_results;
+  std::map<std::uint64_t, Slot> m_localResults;
+};
+
+///////////////////////////////////////////////////////////////////////////////
+// Inlined definitions ////////////////////////////////////////////////////////
+///////////////////////////////////////////////////////////////////////////////
+
+namespace detail {
+
+inline std::string consumedKey(const BatchRef &ref)
+{
+  return ref.launchId + "/" + ref.batchId;
+}
+
+} // namespace detail
+
+inline RestoreService::RestoreService(
+    OperationEngine &engine, EditService &edits)
+    : m_engine(engine), m_edits(edits), m_alive(std::make_shared<bool>(true))
+{}
+
+inline RestoreService::~RestoreService()
+{
+  m_alive.reset();
+}
+
+inline void RestoreService::attachScene(SceneId scene, SceneIdentity &identity)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_identities[scene] = &identity;
+}
+
+inline void RestoreService::setFaultInjector(RestoreFaultInjector injector)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_fault = std::move(injector);
+}
+
+inline bool RestoreService::restored(const BatchRef &ref) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_consumed.count(detail::consumedKey(ref)) != 0;
+}
+
+inline bool RestoreService::conflicting(const BatchRef &ref) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_conflicting.count(detail::consumedKey(ref)) != 0;
+}
+
+inline bool RestoreService::eligible(const BatchRef &ref) const
+{
+  return !restored(ref) && !conflicting(ref)
+      && m_edits.restorations().find(ref).has_value();
+}
+
+inline bool RestoreService::validEnvelope(const RestoreRequest &request)
+{
+  return request.scene != INVALID_SCENE_ID
+      && !request.targetBatchRef.launchId.empty()
+      && !request.targetBatchRef.batchId.empty();
+}
+
+inline std::string RestoreService::canonicalArguments(
+    const RestoreRequest &request)
+{
+  return "restore;scene=" + std::to_string(request.scene)
+      + ";launch=" + request.targetBatchRef.launchId
+      + ";batch=" + request.targetBatchRef.batchId + ";";
+}
+
+inline operations::Request RestoreService::makeRequest(
+    RestoreRequest request, Slot slot)
+{
+  operations::Request r;
+  r.kind = "restore";
+  r.target = session::Target::scene(request.scene);
+  r.capability = session::Capability::EDIT;
+  r.canonicalArguments = canonicalArguments(request);
+  std::weak_ptr<bool> alive = m_alive;
+  auto shared = std::make_shared<RestoreRequest>(std::move(request));
+  auto committed = std::make_shared<std::optional<RestoreResult>>();
+  r.executor = [this, alive, shared, slot, committed](
+                   operations::StepContext &ctx) {
+    operations::Step step;
+    if (!alive.lock())
+      return step;
+    if (!*committed) {
+      if (ctx.abandoned)
+        return step; // never mutate for abandoned work
+      RestoreResult res = commit(*shared, ctx);
+      if (!res.committed) {
+        step.outcome = res.outcome;
+        if (res.expired)
+          step.result = "{\"reason\":\"expired\"}";
+        *slot = std::move(res);
+        return step;
+      }
+      *committed = std::move(res);
+      step.committed = true;
+      step.status = operations::Step::Status::SYNCHRONIZING;
+      return step;
+    }
+    RestoreResult res = std::move(**committed);
+    res.outcome = m_edits.synchronizeCommitted(shared->scene);
+    step.outcome = res.outcome;
+    step.committed = true;
+    step.result = "{\"target_batch_ref\":"
+        + edit::detail::batchRefJson(res.targetBatchRef) + ","
+        + edit::detail::commitDetailJson(true, res.sceneRevision, res.versions)
+        + "}";
+    *slot = std::move(res);
+    return step;
+  };
+  return r;
+}
+
+inline Admission RestoreService::submit(
+    const operations::Credentials &credentials,
+    const OperationRef &ref,
+    RestoreRequest request)
+{
+  if (!validEnvelope(request)) {
+    Admission a;
+    a.code = Outcome::INVALID_REQUEST;
+    return a;
+  }
+  auto slot = std::make_shared<std::optional<RestoreResult>>();
+  auto a =
+      m_engine.submit(credentials, ref, makeRequest(std::move(request), slot));
+  if (a.code == Outcome::OK && !a.replayed) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_results[{ref.sessionId, ref.requestId}] = slot;
+  }
+  return a;
+}
+
+inline LocalAdmission RestoreService::submitLocal(RestoreRequest request)
+{
+  if (!validEnvelope(request)) {
+    LocalAdmission a;
+    a.code = Outcome::INVALID_REQUEST;
+    return a;
+  }
+  auto slot = std::make_shared<std::optional<RestoreResult>>();
+  auto a = m_engine.submitLocal(makeRequest(std::move(request), slot));
+  if (a.code == Outcome::OK) {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_localResults[a.ref.id] = slot;
+  }
+  return a;
+}
+
+inline std::optional<RestoreResult> RestoreService::result(
+    const OperationRef &ref) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto it = m_results.find({ref.sessionId, ref.requestId});
+  if (it == m_results.end())
+    return std::nullopt;
+  return *it->second;
+}
+
+inline std::optional<RestoreResult> RestoreService::resultLocal(
+    LocalRef ref) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto it = m_localResults.find(ref.id);
+  if (it == m_localResults.end())
+    return std::nullopt;
+  return *it->second;
+}
+
+inline void RestoreService::markConflicting(
+    const BatchRef &ref, operations::StepContext &ctx)
+{
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_conflicting.insert(detail::consumedKey(ref));
+  }
+  m_edits.restorations().release(ref);
+  if (ctx.markConflicting)
+    ctx.markConflicting(ref.launchId, ref.batchId);
+}
+
+inline RestoreResult RestoreService::commit(
+    const RestoreRequest &request, operations::StepContext &ctx)
+{
+  scene::Scene &scene = ctx.scene;
+  RestoreResult res;
+  res.targetBatchRef = request.targetBatchRef;
+  SceneIdentity *ident = nullptr;
+  RestoreFaultInjector fault;
+  bool consumed = false;
+  bool conflicted = false;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_identities.find(request.scene);
+    if (it != m_identities.end())
+      ident = it->second;
+    fault = m_fault;
+    consumed = m_consumed.count(detail::consumedKey(request.targetBatchRef));
+    conflicted =
+        m_conflicting.count(detail::consumedKey(request.targetBatchRef));
+  }
+  if (!ident || ident->scene() != &scene) {
+    res.outcome = Outcome::INVALID_REQUEST;
+    return res;
+  }
+
+  // 1. Select exactly the named record; never fall back to another one. //
+
+  if (consumed) {
+    res.outcome = Outcome::ALREADY_RESTORED;
+    return res;
+  }
+  if (conflicted) {
+    res.outcome = Outcome::CONFLICT;
+    return res;
+  }
+  bool logExpired = false;
+  if (ctx.restorationRetained
+      && !ctx.restorationRetained(
+          request.targetBatchRef.launchId, request.targetBatchRef.batchId)) {
+    // The activity log expired or evicted it: keep the store in step.
+    logExpired = m_edits.restorations().find(request.targetBatchRef)
+        || m_edits.restorations().expired(request.targetBatchRef);
+    m_edits.restorations().expireUnless([&](const BatchRef &r) {
+      return ctx.restorationRetained(r.launchId, r.batchId);
+    });
+  }
+  auto record = m_edits.restorations().find(request.targetBatchRef);
+  if (!record || record->scene != request.scene) {
+    // Unknown, expired, wrong-launch or foreign-scene reference. Only a
+    // batch this launch issued and then expired carries a reason.
+    res.outcome = Outcome::OUTCOME_UNAVAILABLE;
+    res.expired = !record
+        && request.targetBatchRef.launchId == m_edits.launchId()
+        && (logExpired || m_edits.restorations().expired(request.targetBatchRef));
+    return res;
+  }
+
+  // 2. Eligibility: every affected object is unchanged since the commit. //
+
+  for (auto &v : record->resultingVersions) {
+    if (!ident->isCurrent(v)) {
+      markConflicting(request.targetBatchRef, ctx);
+      res.outcome = Outcome::CONFLICT;
+      return res;
+    }
+  }
+
+  // 3. Prepare in bounded temporary memory; nothing mutates on failure. //
+
+  struct Planned
+  {
+    scene::Object *object;
+    const edit::Change *change;
+  };
+  std::vector<Planned> plan;
+  std::vector<scene::Object *> objects;
+  try {
+    if (fault && fault())
+      throw std::bad_alloc();
+    plan.reserve(record->changes.size());
+    objects.reserve(record->resultingVersions.size());
+    for (auto &c : record->changes) {
+      auto *o = ident->resolve(c.object);
+      if (!o || !c.before.valid()
+          || !o->parameter(core::Token(c.parameter))) {
+        markConflicting(request.targetBatchRef, ctx);
+        res.outcome = Outcome::CONFLICT; // missing/incompatible reference
+        return res;
+      }
+      plan.push_back({o, &c});
+      if (std::find(objects.begin(), objects.end(), o) == objects.end())
+        objects.push_back(o);
+    }
+    res.versions.reserve(objects.size());
+  } catch (const std::bad_alloc &) {
+    res.outcome = Outcome::BUSY;
+    return res;
+  }
+
+  // 4. Commit: store every prior value, then flush signals. //
+
+  scene.beginUpdateBatch();
+  for (auto *o : objects)
+    o->beginParameterBatch();
+  for (auto &p : plan) {
+    p.object->setParameter(core::Token(p.change->parameter),
+        p.change->before.type(),
+        p.change->before.data());
+  }
+  for (auto *o : objects)
+    o->endParameterBatch();
+  scene.endUpdateBatch();
+
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_consumed.insert(detail::consumedKey(request.targetBatchRef));
+  }
+  m_edits.restorations().release(request.targetBatchRef);
+  if (ctx.markRestored)
+    ctx.markRestored(
+        request.targetBatchRef.launchId, request.targetBatchRef.batchId);
+  for (auto *o : objects) {
+    if (auto v = ident->parameterVersion(ident->handleOf(o)))
+      res.versions.push_back(*v);
+  }
+  res.committed = true;
+  res.sceneRevision = ident->sceneRevision();
+  m_edits.syncStates().beginHook(request.scene);
+  return res;
+}
+
+} // namespace vsr::integration::restore
diff --git a/src/vsr/integration/session/SessionAuthority.hpp b/src/vsr/integration/session/SessionAuthority.hpp
new file mode 100644
index 0000000000..6db37e4683
--- /dev/null
+++ b/src/vsr/integration/session/SessionAuthority.hpp
@@ -0,0 +1,710 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// Header-only: the vsr_integration library globs only top-level sources, and
+// this ticket may not edit that shared CMake file (see ticket 19).
+
+#include "vsr/integration/Integration.hpp"
+// std
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <string_view>
+#include <vector>
+// posix
+#if defined(__linux__)
+#include <sys/random.h>
+#endif
+
+namespace vsr::integration::session {
+
+/*
+ * Logical sessions, launch/session authentication and effective per-target
+ * capabilities for one activation of an Integration.
+ *
+ * One SessionAuthority is created per activation; it generates a fresh launch
+ * credential and public launch identity that are never reused. At most one
+ * external logical session exists at a time. Local host callers use host
+ * authority (the configured ceiling) and never consume the external slot.
+ *
+ * Restrictions (including Disable agent edits) belong to the application and
+ * persist across detach, expiry and replacement attachments. Only the host
+ * API can relax them, and never beyond the configured ceiling.
+ *
+ * No function here logs, and no returned text ever contains a secret.
+ */
+
+// Frozen semantic outcome codes (spec §9) produced by this module.
+enum class Code
+{
+  OK,
+  OCCUPIED,
+  UNAUTHENTICATED,
+  INVALID_SESSION_PROOF,
+  FORBIDDEN,
+  SESSION_EXPIRED
+};
+
+// Stable machine-readable name, e.g. "invalid_session_proof".
+const char *codeName(Code code);
+// Short human explanation; never contains request data or secrets.
+const char *codeMessage(Code code);
+
+enum class Capability
+{
+  READ,
+  RENDER,
+  EDIT,
+  RESYNCHRONIZE
+};
+
+struct Target
+{
+  enum class Kind
+  {
+    SCENE,
+    VIEW
+  };
+
+  Kind kind{Kind::SCENE};
+  std::uint32_t id{0};
+
+  static Target scene(SceneId id);
+  static Target view(ViewId id);
+};
+
+struct EffectiveCapabilities
+{
+  bool read{false};
+  bool render{false};
+  bool edit{false};
+  bool resynchronize{false};
+};
+
+// What a request presents. Transport adapters strip their carrier syntax
+// (e.g. "Bearer ") before filling this in.
+struct Credentials
+{
+  std::string launchCredential;
+  std::string sessionId;
+  std::string sessionProof;
+};
+
+struct Attachment
+{
+  Code code{Code::OK};
+  std::string sessionId; // 32 lowercase hex; public correlation only
+  std::string sessionSecret; // unpadded base64url of 32 random bytes
+  double leaseSeconds{0.0};
+  double renewalSeconds{0.0};
+};
+
+enum class EndReason
+{
+  DETACHED,
+  EXPIRED,
+  REVOKED
+};
+
+// Monotonic time in seconds.
+using MonotonicClock = std::function<double()>;
+// Session-ended signal for later tickets (cancellation, cursors).
+using SessionEndedCallback =
+    std::function<void(const std::string &sessionId, EndReason reason)>;
+
+MonotonicClock steadyClock();
+
+class SessionAuthority
+{
+ public:
+  // Returns null when the integration is inactive or secure randomness is
+  // unavailable.
+  static std::unique_ptr<SessionAuthority> create(
+      const Integration &integration, MonotonicClock clock = steadyClock());
+
+  SessionAuthority(const SessionAuthority &) = delete;
+  SessionAuthority &operator=(const SessionAuthority &) = delete;
+
+  // Launch values (host only; for descriptor publication) //
+
+  const std::string &launchId() const;
+  const std::string &launchCredential() const;
+
+  // External client calls //
+
+  // Launch-authenticated; creates the single external logical session.
+  Attachment attach(std::string_view launchCredential);
+  // Launch + current session proof; no capability needed.
+  Code authenticate(const Credentials &credentials);
+  // Explicit renewal extends the lease from now.
+  Code renew(const Credentials &credentials);
+  Code detach(const Credentials &credentials);
+  // Admission check for a session-scoped action on a target.
+  Code authorize(
+      const Credentials &credentials, Target target, Capability capability);
+  // Safe-point re-check for work admitted under sessionId.
+  Code authorizeExecution(
+      std::string_view sessionId, Target target, Capability capability);
+  EffectiveCapabilities effectiveCapabilities(Target target) const;
+
+  // Host / local operator //
+
+  // Local host authority: the configured ceiling, independent of the
+  // external restriction mask. Consumes no session slot.
+  bool authorizeLocal(Target target, Capability capability) const;
+  // Local whole-session revocation (viewer Disconnect).
+  bool revokeSession();
+  void setAgentEditsDisabled(bool disabled);
+  bool agentEditsDisabled() const;
+  void restrict(Target target, Capability capability);
+  // Relaxing can never exceed the configured ceiling.
+  void relax(Target target, Capability capability);
+  // Ends the current session if its lease has passed.
+  void expireIfDue();
+  bool hasSession() const;
+  void setSessionEndedCallback(SessionEndedCallback callback);
+
+ private:
+  struct Session
+  {
+    std::string id;
+    std::string secret;
+    double expiresAt{0.0};
+  };
+
+  struct EndedSession
+  {
+    std::string id;
+    std::string secret;
+    EndReason reason{EndReason::DETACHED};
+  };
+
+  SessionAuthority(const Integration &integration, MonotonicClock clock);
+
+  bool ceiling(Target target, Capability capability) const;
+  bool restricted(Target target, Capability capability) const;
+  bool effective(Target target, Capability capability) const;
+  Code checkSession(const Credentials &credentials, double now);
+  // Caller holds m_mutex; notify(ended) after unlocking.
+  void endSession(EndReason reason, std::vector<EndedSession> &ended);
+  void notify(const std::vector<EndedSession> &ended);
+
+  const Integration &m_integration;
+  MonotonicClock m_clock;
+  std::string m_launchId;
+  std::string m_launchCredential;
+
+  mutable std::mutex m_mutex;
+  std::unique_ptr<Session> m_session;
+  EndedSession m_lastEnded;
+  bool m_hasLastEnded{false};
+  bool m_agentEditsDisabled{false};
+  std::vector<std::array<bool, 4>> m_sceneRestrictions;
+  std::vector<std::array<bool, 4>> m_viewRestrictions;
+  SessionEndedCallback m_onEnded;
+};
+
+// Encoding helpers (exposed for tests and the descriptor ticket) //
+
+bool secureRandom(std::uint8_t *out, std::size_t size);
+std::string toLowerHex(const std::uint8_t *data, std::size_t size);
+std::string toBase64Url(const std::uint8_t *data, std::size_t size);
+bool constantTimeEqual(std::string_view a, std::string_view b);
+
+// Inlined definitions ////////////////////////////////////////////////////////
+
+inline const char *codeName(Code code)
+{
+  switch (code) {
+  case Code::OK:
+    return "ok";
+  case Code::OCCUPIED:
+    return "occupied";
+  case Code::UNAUTHENTICATED:
+    return "unauthenticated";
+  case Code::INVALID_SESSION_PROOF:
+    return "invalid_session_proof";
+  case Code::FORBIDDEN:
+    return "forbidden";
+  case Code::SESSION_EXPIRED:
+    return "session_expired";
+  }
+  return "unknown";
+}
+
+inline const char *codeMessage(Code code)
+{
+  switch (code) {
+  case Code::OK:
+    return "ok";
+  case Code::OCCUPIED:
+    return "the external session slot is occupied";
+  case Code::UNAUTHENTICATED:
+    return "missing or invalid launch credential";
+  case Code::INVALID_SESSION_PROOF:
+    return "missing, wrong or stale session proof";
+  case Code::FORBIDDEN:
+    return "capability absent or not exposed for this target";
+  case Code::SESSION_EXPIRED:
+    return "the session lease expired";
+  }
+  return "unknown";
+}
+
+inline Target Target::scene(SceneId id)
+{
+  return {Kind::SCENE, id};
+}
+
+inline Target Target::view(ViewId id)
+{
+  return {Kind::VIEW, id};
+}
+
+inline MonotonicClock steadyClock()
+{
+  return [] {
+    using namespace std::chrono;
+    return duration<double>(steady_clock::now().time_since_epoch()).count();
+  };
+}
+
+inline bool secureRandom(std::uint8_t *out, std::size_t size)
+{
+#if defined(__linux__)
+  std::size_t filled = 0;
+  while (filled < size) {
+    auto n = getrandom(out + filled, size - filled, 0);
+    if (n <= 0)
+      return false;
+    filled += std::size_t(n);
+  }
+  return true;
+#else
+  // Unvalidated platforms report unsupported rather than use a weak source.
+  (void)out;
+  (void)size;
+  return false;
+#endif
+}
+
+inline std::string toLowerHex(const std::uint8_t *data, std::size_t size)
+{
+  static const char *digits = "0123456789abcdef";
+  std::string s;
+  s.reserve(size * 2);
+  for (std::size_t i = 0; i < size; i++) {
+    s.push_back(digits[data[i] >> 4]);
+    s.push_back(digits[data[i] & 0xf]);
+  }
+  return s;
+}
+
+inline std::string toBase64Url(const std::uint8_t *data, std::size_t size)
+{
+  static const char *alphabet =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
+  std::string s;
+  std::uint32_t acc = 0;
+  int bits = 0;
+  for (std::size_t i = 0; i < size; i++) {
+    acc = (acc << 8) | data[i];
+    bits += 8;
+    while (bits >= 6) {
+      bits -= 6;
+      s.push_back(alphabet[(acc >> bits) & 0x3f]);
+    }
+  }
+  if (bits > 0)
+    s.push_back(alphabet[(acc << (6 - bits)) & 0x3f]);
+  return s;
+}
+
+inline bool constantTimeEqual(std::string_view a, std::string_view b)
+{
+  if (a.size() != b.size())
+    return false;
+  unsigned char diff = 0;
+  for (std::size_t i = 0; i < a.size(); i++)
+    diff |= static_cast<unsigned char>(a[i] ^ b[i]);
+  return diff == 0;
+}
+
+namespace detail {
+
+inline bool randomHex(std::string &out, std::size_t bytes)
+{
+  std::vector<std::uint8_t> buf(bytes);
+  if (!secureRandom(buf.data(), bytes))
+    return false;
+  out = toLowerHex(buf.data(), bytes);
+  return true;
+}
+
+inline bool randomBase64Url(std::string &out, std::size_t bytes)
+{
+  std::vector<std::uint8_t> buf(bytes);
+  if (!secureRandom(buf.data(), bytes))
+    return false;
+  out = toBase64Url(buf.data(), bytes);
+  return true;
+}
+
+inline std::size_t capIndex(Capability c)
+{
+  return static_cast<std::size_t>(c);
+}
+
+} // namespace detail
+
+inline std::unique_ptr<SessionAuthority> SessionAuthority::create(
+    const Integration &integration, MonotonicClock clock)
+{
+  if (!integration.active() || !clock)
+    return {};
+  std::unique_ptr<SessionAuthority> a(
+      new SessionAuthority(integration, std::move(clock)));
+  if (!detail::randomHex(a->m_launchId, 16)
+      || !detail::randomBase64Url(a->m_launchCredential, 32))
+    return {};
+  return a;
+}
+
+inline SessionAuthority::SessionAuthority(
+    const Integration &integration, MonotonicClock clock)
+    : m_integration(integration), m_clock(std::move(clock))
+{}
+
+inline const std::string &SessionAuthority::launchId() const
+{
+  return m_launchId;
+}
+
+inline const std::string &SessionAuthority::launchCredential() const
+{
+  return m_launchCredential;
+}
+
+inline Attachment SessionAuthority::attach(std::string_view launchCredential)
+{
+  Attachment result;
+  if (launchCredential.empty()
+      || !constantTimeEqual(launchCredential, m_launchCredential)) {
+    result.code = Code::UNAUTHENTICATED;
+    return result;
+  }
+
+  std::vector<EndedSession> ended;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const double now = m_clock();
+    if (m_session && now >= m_session->expiresAt)
+      endSession(EndReason::EXPIRED, ended);
+
+    if (m_session) {
+      result.code = Code::OCCUPIED;
+    } else {
+      auto s = std::make_unique<Session>();
+      if (!detail::randomHex(s->id, 16)
+          || !detail::randomBase64Url(s->secret, 32)) {
+        // No secure randomness: refuse rather than weaken.
+        result.code = Code::OCCUPIED;
+      } else {
+        const auto &timing = m_integration.timing();
+        s->expiresAt = now + timing.leaseSeconds;
+        result.sessionId = s->id;
+        result.sessionSecret = s->secret;
+        result.leaseSeconds = timing.leaseSeconds;
+        result.renewalSeconds = timing.renewalSeconds;
+        m_session = std::move(s);
+      }
+    }
+  }
+  notify(ended);
+  return result;
+}
+
+inline Code SessionAuthority::checkSession(
+    const Credentials &credentials, double now)
+{
+  if (credentials.launchCredential.empty()
+      || !constantTimeEqual(credentials.launchCredential, m_launchCredential))
+    return Code::UNAUTHENTICATED;
+  if (credentials.sessionId.empty() || credentials.sessionProof.empty())
+    return Code::INVALID_SESSION_PROOF;
+
+  if (m_session && credentials.sessionId == m_session->id
+      && constantTimeEqual(credentials.sessionProof, m_session->secret)) {
+    if (now >= m_session->expiresAt)
+      return Code::SESSION_EXPIRED; // caller ends the session
+    return Code::OK;
+  }
+
+  if (m_hasLastEnded && m_lastEnded.reason == EndReason::EXPIRED
+      && credentials.sessionId == m_lastEnded.id
+      && constantTimeEqual(credentials.sessionProof, m_lastEnded.secret))
+    return Code::SESSION_EXPIRED;
+
+  return Code::INVALID_SESSION_PROOF;
+}
+
+inline Code SessionAuthority::authenticate(const Credentials &credentials)
+{
+  std::vector<EndedSession> ended;
+  Code code;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    code = checkSession(credentials, m_clock());
+    if (code == Code::SESSION_EXPIRED && m_session
+        && credentials.sessionId == m_session->id)
+      endSession(EndReason::EXPIRED, ended);
+  }
+  notify(ended);
+  return code;
+}
+
+inline Code SessionAuthority::renew(const Credentials &credentials)
+{
+  std::vector<EndedSession> ended;
+  Code code;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    const double now = m_clock();
+    code = checkSession(credentials, now);
+    if (code == Code::OK)
+      m_session->expiresAt = now + m_integration.timing().leaseSeconds;
+    else if (code == Code::SESSION_EXPIRED && m_session
+        && credentials.sessionId == m_session->id)
+      endSession(EndReason::EXPIRED, ended);
+  }
+  notify(ended);
+  return code;
+}
+
+inline Code SessionAuthority::detach(const Credentials &credentials)
+{
+  std::vector<EndedSession> ended;
+  Code code;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    code = checkSession(credentials, m_clock());
+    if (code == Code::OK)
+      endSession(EndReason::DETACHED, ended);
+    else if (code == Code::SESSION_EXPIRED && m_session
+        && credentials.sessionId == m_session->id)
+      endSession(EndReason::EXPIRED, ended);
+  }
+  notify(ended);
+  return code;
+}
+
+inline Code SessionAuthority::authorize(
+    const Credentials &credentials, Target target, Capability capability)
+{
+  const Code code = authenticate(credentials);
+  if (code != Code::OK)
+    return code;
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return effective(target, capability) ? Code::OK : Code::FORBIDDEN;
+}
+
+inline Code SessionAuthority::authorizeExecution(
+    std::string_view sessionId, Target target, Capability capability)
+{
+  std::vector<EndedSession> ended;
+  Code code = Code::OK;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_session && sessionId == m_session->id) {
+      if (m_clock() >= m_session->expiresAt) {
+        endSession(EndReason::EXPIRED, ended);
+        code = Code::SESSION_EXPIRED;
+      } else if (!effective(target, capability)) {
+        code = Code::FORBIDDEN;
+      }
+    } else if (m_hasLastEnded && m_lastEnded.reason == EndReason::EXPIRED
+        && sessionId == m_lastEnded.id) {
+      code = Code::SESSION_EXPIRED;
+    } else {
+      code = Code::INVALID_SESSION_PROOF;
+    }
+  }
+  notify(ended);
+  return code;
+}
+
+inline EffectiveCapabilities SessionAuthority::effectiveCapabilities(
+    Target target) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  EffectiveCapabilities e;
+  e.read = effective(target, Capability::READ);
+  e.render = effective(target, Capability::RENDER);
+  e.edit = effective(target, Capability::EDIT);
+  e.resynchronize = effective(target, Capability::RESYNCHRONIZE);
+  return e;
+}
+
+inline bool SessionAuthority::authorizeLocal(
+    Target target, Capability capability) const
+{
+  return ceiling(target, capability);
+}
+
+inline bool SessionAuthority::revokeSession()
+{
+  std::vector<EndedSession> ended;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_session)
+      return false;
+    endSession(EndReason::REVOKED, ended);
+  }
+  notify(ended);
+  return true;
+}
+
+inline void SessionAuthority::setAgentEditsDisabled(bool disabled)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_agentEditsDisabled = disabled;
+}
+
+inline bool SessionAuthority::agentEditsDisabled() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_agentEditsDisabled;
+}
+
+inline void SessionAuthority::restrict(Target target, Capability capability)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto &table = target.kind == Target::Kind::SCENE ? m_sceneRestrictions
+                                                   : m_viewRestrictions;
+  if (table.size() <= target.id)
+    table.resize(std::size_t(target.id) + 1, {false, false, false, false});
+  table[target.id][detail::capIndex(capability)] = true;
+}
+
+inline void SessionAuthority::relax(Target target, Capability capability)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto &table = target.kind == Target::Kind::SCENE ? m_sceneRestrictions
+                                                   : m_viewRestrictions;
+  if (target.id < table.size())
+    table[target.id][detail::capIndex(capability)] = false;
+}
+
+inline void SessionAuthority::expireIfDue()
+{
+  std::vector<EndedSession> ended;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_session && m_clock() >= m_session->expiresAt)
+      endSession(EndReason::EXPIRED, ended);
+  }
+  notify(ended);
+}
+
+inline bool SessionAuthority::hasSession() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_session != nullptr;
+}
+
+inline void SessionAuthority::setSessionEndedCallback(
+    SessionEndedCallback callback)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_onEnded = std::move(callback);
+}
+
+inline bool SessionAuthority::ceiling(
+    Target target, Capability capability) const
+{
+  if (target.kind == Target::Kind::SCENE) {
+    if (!m_integration.isRegisteredScene(target.id))
+      return false;
+    const auto g = m_integration.sceneGrants(target.id);
+    switch (capability) {
+    case Capability::READ:
+      return g.read;
+    case Capability::EDIT:
+      return g.read && g.edit;
+    case Capability::RESYNCHRONIZE:
+      return g.read && g.resynchronize;
+    case Capability::RENDER:
+      return false; // scenes are not renderable targets
+    }
+    return false;
+  }
+
+  if (!m_integration.isRegisteredView(target.id))
+    return false;
+  const auto g = m_integration.viewGrants(target.id);
+  switch (capability) {
+  case Capability::READ:
+    return g.read;
+  case Capability::RENDER:
+    return g.read && g.render;
+  case Capability::EDIT:
+  case Capability::RESYNCHRONIZE:
+    return false; // views expose only read/render
+  }
+  return false;
+}
+
+inline bool SessionAuthority::restricted(
+    Target target, Capability capability) const
+{
+  const auto &table = target.kind == Target::Kind::SCENE ? m_sceneRestrictions
+                                                         : m_viewRestrictions;
+  return target.id < table.size()
+      && table[target.id][detail::capIndex(capability)];
+}
+
+inline bool SessionAuthority::effective(
+    Target target, Capability capability) const
+{
+  if (!ceiling(target, capability) || restricted(target, capability))
+    return false;
+  if (capability == Capability::EDIT && m_agentEditsDisabled)
+    return false;
+  // Actions depend on current read; withdrawing read withdraws them.
+  if (capability != Capability::READ && restricted(target, Capability::READ))
+    return false;
+  return true;
+}
+
+inline void SessionAuthority::endSession(
+    EndReason reason, std::vector<EndedSession> &ended)
+{
+  m_lastEnded = {m_session->id, m_session->secret, reason};
+  m_hasLastEnded = true;
+  ended.push_back({m_session->id, {}, reason});
+  m_session.reset();
+}
+
+inline void SessionAuthority::notify(const std::vector<EndedSession> &ended)
+{
+  if (ended.empty())
+    return;
+  SessionEndedCallback cb;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    cb = m_onEnded;
+  }
+  if (cb) {
+    for (const auto &e : ended)
+      cb(e.id, e.reason);
+  }
+}
+
+} // namespace vsr::integration::session
