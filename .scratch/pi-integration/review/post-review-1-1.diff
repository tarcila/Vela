+struct Decoded
+{
+  int w{0}, h{0};
+  std::vector<std::uint8_t> rgba;
+};
+
+Decoded decode(const std::vector<std::uint8_t> &png)
+{
+  Decoded d;
+  int ch = 0;
+  unsigned char *p = stbi_load_from_memory(
+      png.data(), int(png.size()), &d.w, &d.h, &ch, 4);
+  REQUIRE(p != nullptr);
+  d.rgba.assign(p, p + std::size_t(d.w) * d.h * 4);
+  stbi_image_free(p);
+  return d;
+}
