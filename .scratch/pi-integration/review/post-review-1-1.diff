+## SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+## SPDX-License-Identifier: Apache-2.0
+
+# Headless agent-integration core. Deliberately free of UI, Lua, Pi and
+# network dependencies. Sources, including those in module subdirectories, are
+# globbed so later additions need no edit to a shared CMake file.
+
+project(vsr_integration)
+
+project_add_library(STATIC)
+
+file(GLOB_RECURSE VSR_INTEGRATION_SOURCES CONFIGURE_DEPENDS
+  ${CMAKE_CURRENT_LIST_DIR}/*.cpp
+)
+project_sources(PRIVATE ${VSR_INTEGRATION_SOURCES})
+
+project_include_directories(
+PUBLIC
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}/../..>
+)
+
+find_package(Threads REQUIRED)
+project_link_libraries(PUBLIC vsr_scene Threads::Threads)
+# PNG deflate via the vendored stb writer; an implementation detail.
+project_link_libraries(PRIVATE $<BUILD_INTERFACE:vela_ext_stb_image>)
+
+# Embedded MCP server (header-only under mcp/); opt-in, no extra dependency.
+if (VSR_USE_INTEGRATION_MCP)
+  project_compile_definitions(PUBLIC VSR_USE_INTEGRATION_MCP)
+endif()
diff --git a/src/vsr/integration/Integration.cpp b/src/vsr/integration/Integration.cpp
new file mode 100644
index 0000000000..dae81e8641
--- /dev/null
+++ b/src/vsr/integration/Integration.cpp
@@ -0,0 +1,247 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "Integration.hpp"
+// vsr_scene
+#include "vsr/scene/Scene.hpp"
+// std
+#include <cmath>
+#include <utility>
+
+namespace vsr::integration {
+
+namespace {
+
+bool validDuration(double seconds)
+{
+  return std::isfinite(seconds) && seconds > 0.0;
+}
+
+} // namespace
+
+Integration::~Integration() = default;
+
+// Queries ////////////////////////////////////////////////////////////////////
+
+bool Integration::active() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_active;
+}
+
+bool Integration::isRegisteredScene(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return id < m_scenes.size();
+}
+
+bool Integration::isRegisteredView(ViewId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return id < m_views.size() && !m_views[id].removed;
+}
+
+std::vector<ViewId> Integration::viewsOfScene(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  std::vector<ViewId> views;
+  for (std::size_t i = 0; i < m_views.size(); i++) {
+    if (!m_views[i].removed && m_views[i].registration.scene == id)
+      views.push_back(ViewId(i));
+  }
+  return views;
+}
+
+std::optional<SceneId> Integration::sceneOfView(ViewId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (id >= m_views.size() || m_views[id].removed)
+    return {};
+  return m_views[id].registration.scene;
+}
+
+SceneGrants Integration::sceneGrants(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_scenes.size())
+    return {};
+  return m_scenes[id].registration.grants;
+}
+
+ViewGrants Integration::viewGrants(ViewId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_views.size() || m_views[id].removed)
+    return {};
+  return m_views[id].registration.grants;
+}
+
+SyncHook Integration::normalSyncHook(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_scenes.size())
+    return {};
+  return m_scenes[id].registration.normalSyncHook;
+}
+
+SyncHook Integration::recoveryCallback(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_scenes.size())
+    return {};
+  return m_scenes[id].registration.recoveryCallback;
+}
+
+const SessionTiming &Integration::timing() const
+{
+  return m_timing;
+}
+
+bool Integration::inServiceCall() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_servicingThread == std::this_thread::get_id();
+}
+
+// Registration ///////////////////////////////////////////////////////////////
+
+std::optional<SceneId> Integration::registerScene(
+    SceneRegistration registration)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (m_active || registration.scene == nullptr)
+    return {};
+  m_scenes.push_back({std::move(registration)});
+  return SceneId(m_scenes.size() - 1);
+}
+
+std::optional<ViewId> Integration::registerView(ViewRegistration registration)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (registration.scene >= m_scenes.size())
+    return {};
+  if (m_active) {
+    // Post-activation: host scene work at a safe point only.
+    if (m_servicingThread != std::this_thread::get_id())
+      return {};
+    const auto &g = registration.grants;
+    if (g.render && !g.read)
+      return {};
+  }
+  m_views.push_back({std::move(registration)});
+  return ViewId(m_views.size() - 1);
+}
+
+bool Integration::unregisterView(ViewId id)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || m_servicingThread != std::this_thread::get_id()
+      || id >= m_views.size() || m_views[id].removed)
+    return false;
+  m_views[id].removed = true;
+  return true;
+}
+
+// Activation /////////////////////////////////////////////////////////////////
+
+ActivationResult Integration::validate(const SessionTiming &timing) const
+{
+  if (m_active)
+    return {ActivationError::ALREADY_ACTIVE, {}};
+  if (!validDuration(timing.leaseSeconds))
+    return {ActivationError::INVALID_LEASE, {}};
+  if (!validDuration(timing.renewalSeconds))
+    return {ActivationError::INVALID_RENEWAL, {}};
+  if (!(timing.renewalSeconds < timing.leaseSeconds))
+    return {ActivationError::RENEWAL_NOT_SHORTER_THAN_LEASE, {}};
+
+  for (const auto &s : m_scenes) {
+    const auto &r = s.registration;
+    if ((r.grants.edit || r.grants.resynchronize) && !r.grants.read)
+      return {ActivationError::ACTION_WITHOUT_READ, r.name};
+    if (r.grants.edit && !r.normalSyncHook)
+      return {ActivationError::MISSING_SYNC_HOOK, r.name};
+    if (r.grants.resynchronize && !r.recoveryCallback)
+      return {ActivationError::MISSING_RECOVERY_CALLBACK, r.name};
+  }
+
+  for (const auto &v : m_views) {
+    const auto &r = v.registration;
+    if (r.grants.render && !r.grants.read)
+      return {ActivationError::ACTION_WITHOUT_READ, r.name};
+  }
+
+  return {};
+}
+
+ActivationResult Integration::activate(SessionTiming timing)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto result = validate(timing);
+  if (result.ok()) {
+    m_timing = timing;
+    m_active = true;
+  }
+  return result;
+}
+
+// Execution //////////////////////////////////////////////////////////////////
+
+bool Integration::submit(SceneId target, SceneWork work)
+{
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active || target >= m_scenes.size() || !work)
+      return false;
+    m_queue.push_back({target, std::move(work)});
+  }
+  m_workAvailable.notify_all();
+  return true;
+}
+
+std::size_t Integration::service()
+{
+  std::deque<PendingWork> batch;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    batch.swap(m_queue);
+    m_servicingThread = std::this_thread::get_id();
+  }
+
+  for (auto &item : batch) {
+    // Registrations are immutable after activation, so the pointer is stable.
+    auto *scene = m_scenes[item.target].registration.scene;
+    item.work(*scene);
+  }
+
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_servicingThread = std::thread::id();
+  return batch.size();
+}
+
+void Integration::runServiceLoop()
+{
+  for (;;) {
+    {
+      std::unique_lock<std::mutex> lock(m_mutex);
+      m_workAvailable.wait(
+          lock, [&] { return m_stopRequested || !m_queue.empty(); });
+      if (m_stopRequested && m_queue.empty()) {
+        m_stopRequested = false;
+        return;
+      }
+    }
+    service();
+  }
+}
+
+void Integration::requestStop()
+{
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_stopRequested = true;
+  }
+  m_workAvailable.notify_all();
+}
+
+} // namespace vsr::integration
diff --git a/src/vsr/integration/Integration.hpp b/src/vsr/integration/Integration.hpp
new file mode 100644
index 0000000000..220a734fa3
--- /dev/null
+++ b/src/vsr/integration/Integration.hpp
@@ -0,0 +1,193 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// std
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <limits>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace vsr::scene {
+struct Scene;
+} // namespace vsr::scene
+
+namespace vsr::integration {
+
+/*
+ * Headless, transport-independent agent-integration core.
+ *
+ * The host registers the scenes and views it chooses to expose, together with
+ * a per-target capability ceiling, then explicitly activates the integration.
+ * Nothing is controllable before activation. Work submitted from any thread is
+ * queued and only runs when the host services it at a safe execution point
+ * (service() or runServiceLoop()), on the servicing thread.
+ */
+
+using SceneId = std::uint32_t;
+using ViewId = std::uint32_t;
+
+constexpr SceneId INVALID_SCENE_ID = std::numeric_limits<SceneId>::max();
+constexpr ViewId INVALID_VIEW_ID = std::numeric_limits<ViewId>::max();
+
+// Omitted grants are denied, including read.
+struct SceneGrants
+{
+  bool read{false};
+  bool edit{false};
+  bool resynchronize{false};
+};
+
+struct ViewGrants
+{
+  bool read{false};
+  bool render{false};
+};
+
+// Returns true when the host confirms downstream state is ready to render.
+using SyncHook = std::function<bool(SceneId)>;
+
+struct SceneRegistration
+{
+  std::string name;
+  scene::Scene *scene{nullptr};
+  SceneGrants grants;
+  SyncHook normalSyncHook; // required when grants.edit
+  SyncHook recoveryCallback; // required when grants.resynchronize
+};
+
+struct ViewRegistration
+{
+  std::string name;
+  SceneId scene{INVALID_SCENE_ID};
+  ViewGrants grants;
+};
+
+struct SessionTiming
+{
+  double leaseSeconds{120.0};
+  double renewalSeconds{30.0};
+};
+
+enum class ActivationError
+{
+  NONE,
+  ALREADY_ACTIVE,
+  ACTION_WITHOUT_READ,
+  MISSING_SYNC_HOOK,
+  MISSING_RECOVERY_CALLBACK,
+  INVALID_LEASE,
+  INVALID_RENEWAL,
+  RENEWAL_NOT_SHORTER_THAN_LEASE
+};
+
+struct ActivationResult
+{
+  ActivationError error{ActivationError::NONE};
+  std::string target; // offending target name, when applicable
+
+  bool ok() const;
+};
+
+using SceneWork = std::function<void(scene::Scene &)>;
+
+class Integration
+{
+ public:
+  Integration() = default;
+  ~Integration();
+
+  Integration(const Integration &) = delete;
+  Integration &operator=(const Integration &) = delete;
+
+  // Queries //
+
+  bool active() const;
+  bool isRegisteredScene(SceneId id) const;
+  bool isRegisteredView(ViewId id) const;
+  std::optional<SceneId> sceneOfView(ViewId id) const;
+  // Effective ceilings; all-denied while inactive or for unregistered ids.
+  SceneGrants sceneGrants(SceneId id) const;
+  ViewGrants viewGrants(ViewId id) const;
+  // The registered normal-synchronization hook; empty while inactive or for
+  // unregistered ids.
+  SyncHook normalSyncHook(SceneId id) const;
+  // The registered recovery callback; empty while inactive or for
+  // unregistered ids.
+  SyncHook recoveryCallback(SceneId id) const;
+  const SessionTiming &timing() const;
+  // True only on the servicing thread while it runs submitted work.
+  bool inServiceCall() const;
+
+  // Host registration (host thread, before activation) //
+
+  std::optional<SceneId> registerScene(SceneRegistration registration);
+  // Before activation from the host thread; after activation only as host
+  // scene work on the servicing thread (see sync::SyncService), so the view
+  // set never changes while a synchronization hook runs.
+  std::optional<ViewId> registerView(ViewRegistration registration);
+  // After activation, servicing thread only. Ids are never reused.
+  bool unregisterView(ViewId id);
+  std::vector<ViewId> viewsOfScene(SceneId id) const;
+
+  // Activation //
+
+  ActivationResult activate(SessionTiming timing = {});
+
+  // Execution //
+
+  // Thread-safe. Rejected while inactive or for an unregistered scene.
+  bool submit(SceneId target, SceneWork work);
+  // Host safe point: runs all currently queued work on the calling thread.
+  std::size_t service();
+  // Blocking headless service loop; returns after requestStop().
+  void runServiceLoop();
+  // Thread-safe.
+  void requestStop();
+
+ private:
+  struct SceneEntry
+  {
+    SceneRegistration registration;
+  };
+
+  struct ViewEntry
+  {
+    ViewRegistration registration;
+    bool removed{false};
+  };
+
+  struct PendingWork
+  {
+    SceneId target{INVALID_SCENE_ID};
+    SceneWork work;
+  };
+
+  ActivationResult validate(const SessionTiming &timing) const;
+
+  mutable std::mutex m_mutex;
+  std::condition_variable m_workAvailable;
+  bool m_active{false};
+  bool m_stopRequested{false};
+  SessionTiming m_timing;
+  std::vector<SceneEntry> m_scenes;
+  std::vector<ViewEntry> m_views;
+  std::deque<PendingWork> m_queue;
+  std::thread::id m_servicingThread;
+};
+
+// Inlined definitions ////////////////////////////////////////////////////////
+
+inline bool ActivationResult::ok() const
+{
+  return error == ActivationError::NONE;
+}
+
