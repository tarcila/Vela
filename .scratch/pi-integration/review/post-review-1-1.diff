+  Fixture f;
+  auto &op = f.newOp();
+  op.script = [](StepContext &, int run) {
+    Step s;
+    if (run == 1)
+      s.status = Step::Status::YIELD;
+    else if (run == 2) {
+      s.status = Step::Status::SYNCHRONIZING;
+      s.committed = true;
+    } else
+      s.result = "committed";
+    return s;
