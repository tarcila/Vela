+SCENARIO("Session end cancels outstanding work and blocks in-transit IDs",
+    "[integration]")
+{
+  Fixture f;
+  auto &queued = f.newOp();
+  REQUIRE(f.engine->submit(f.creds, f.ref(1), f.request(queued)).code
