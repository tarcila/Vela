+  RuntimeDirectory(const RuntimeDirectory &) = delete;
+  RuntimeDirectory &operator=(const RuntimeDirectory &) = delete;
+  RuntimeDirectory(RuntimeDirectory &&o) noexcept
+  {
+    *this = std::move(o);
+  }
