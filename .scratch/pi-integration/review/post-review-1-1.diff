+bool isLowerHex(const std::string &s, std::size_t n)
+{
+  if (s.size() != n)
+    return false;
+  for (char c : s) {
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+      return false;
+  }
+  return true;
+}
+
+bool isBase64Url(const std::string &s, std::size_t n)
+{
+  if (s.size() != n)
+    return false;
+  for (char c : s) {
+    const bool ok = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
+        || (c >= '0' && c <= '9') || c == '-' || c == '_';
+    if (!ok)
+      return false;
+  }
+  return true;
+}
