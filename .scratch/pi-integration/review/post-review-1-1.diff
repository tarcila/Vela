+      REQUIRE_FALSE(r.batchRef);
+      REQUIRE(lf.fx.opacity() == 1.f);
+      REQUIRE(lf.fx.recorder->parameterSignals == signals);
+      REQUIRE(lf.fx.edits->restorations().size() == 0);
+      REQUIRE(lf.log->usage().restorableBatches == 0);
+      REQUIRE(lf.log->usage().bytes <= l.bytes);
+      auto e = lf.log->get(2);
+      REQUIRE(e);
+      REQUIRE(e->terminal == Outcome::BUSY);
+      REQUIRE_FALSE(e->batchRef);
+      REQUIRE(e->restorationBytes == 0);
+    }
+  }
+}
+
+SCENARIO("The oldest eligible batch visibly expires past 32", "[integration]")
+{
+  LoggedFixture lf({});
+  std::vector<BatchRef> refs;
+  for (std::uint64_t id = 1; id <= 33; id++) {
+    auto r = lf.edit(id, 0.01f * float(id));
+    REQUIRE(r.committed);
+    refs.push_back(*r.batchRef);
+  }
+  REQUIRE(lf.log->usage().restorableBatches == 32);
+  auto first = lf.log->get(1);
+  REQUIRE(first);
+  REQUIRE(first->eligibility == activity::Eligibility::EXPIRED);
+  REQUIRE(first->restorationBytes == 0);
+  REQUIRE(first->batchRef);
+  REQUIRE(lf.log->eligibility(refs[0]) == activity::Eligibility::EXPIRED);
+  REQUIRE(lf.fx.edits->restorations().expired(refs[0]));
+  REQUIRE(lf.log->eligibility(refs[1]) == activity::Eligibility::ELIGIBLE);
+  REQUIRE(lf.fx.edits->restorations().find(refs[1]));
+}
diff --git a/src/tests/integration/test_IntegrationIdentity.cpp b/src/tests/integration/test_IntegrationIdentity.cpp
new file mode 100644
index 0000000000..2412ad451e
--- /dev/null
+++ b/src/tests/integration/test_IntegrationIdentity.cpp
@@ -0,0 +1,367 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/identity/Identity.hpp"
+#include "vsr/scene/Scene.hpp"
+// std
+#include <memory>
+
+using namespace vsr::integration::identity;
+using vsr::scene::Scene;
+
+SCENARIO("Handles never redirect to another object", "[integration]")
+{
+  Scene scene;
+  IdentityAuthority authority;
+  SceneIdentity ids(authority, scene);
+
+  auto a = scene.createObject<vsr::scene::Material>("matte");
+  auto b = scene.createObject<vsr::scene::Material>("matte");
+  const auto ha = ids.handleOf(a.data());
+  const auto hb = ids.handleOf(b.data());
+  REQUIRE(ha.valid());
+  REQUIRE(hb.valid());
+  REQUIRE(ha != hb);
+  REQUIRE(ids.resolve(ha) == a.data());
+
+  WHEN("an object is removed and its storage index reused")
+  {
+    const auto oldIndex = a.index();
+    scene.removeObject(a.data());
+    REQUIRE(ids.resolve(ha) == nullptr);
+    REQUIRE_FALSE(ids.parameterVersion(ha));
+
+    auto c = scene.createObject<vsr::scene::Material>("matte");
+    REQUIRE(c.index() == oldIndex);
+    THEN("the old handle stays invalid and the newcomer gets a fresh one")
+    {
+      REQUIRE(ids.resolve(ha) == nullptr);
+      REQUIRE(ids.handleOf(c.data()).valid());
+      REQUIRE(ids.handleOf(c.data()) != ha);
+      REQUIRE(ids.resolve(hb) == b.data());
+    }
+  }
+
+  WHEN("the scene is defragmented")
+  {
+    b->setName("survivor");
+    const auto oldIndexB = b.index();
+    scene.removeObject(a.data());
+    const auto tokenB = *ids.parameterVersion(hb);
+    const auto inspection = ids.inspectionRevision();
+    scene.defragmentObjectStorage();
+    vsr::scene::Material *moved = nullptr;
+    const auto &pool = scene.objectDB().material;
+    for (size_t i = 0; i < pool.capacity(); i++) {
+      if (auto ref = pool.at(i); ref && ref->name() == "survivor")
+        moved = ref.data();
+    }
+    REQUIRE(moved);
+    REQUIRE(moved->index() != oldIndexB);
+    THEN("surviving handles remap to the same object")
+    {
+      REQUIRE(ids.resolve(hb) == moved);
+      REQUIRE(ids.handleOf(moved) == hb);
+      REQUIRE(ids.isCurrent(tokenB));
+      REQUIRE(ids.resolve(ha) == nullptr);
+      REQUIRE(ids.inspectionRevision() != inspection);
+    }
+  }
+
+  WHEN("every object is removed and the scene refilled")
+  {
+    scene.removeAllObjects();
+    auto c = scene.createObject<vsr::scene::Material>("matte");
+    THEN("no old handle addresses a new object")
+    {
+      REQUIRE(ids.resolve(ha) == nullptr);
+      REQUIRE(ids.resolve(hb) == nullptr);
+      REQUIRE(ids.handleOf(c.data()) != ha);
+      REQUIRE(ids.handleOf(c.data()) != hb);
+    }
+  }
+
+  WHEN("a handle is presented to a different scene's identity")
+  {
+    Scene other;
+    auto o = other.createObject<vsr::scene::Material>("matte");
+    SceneIdentity otherIds(authority, other);
+    THEN("it does not resolve, even at the same storage index")
+    {
+      REQUIRE(o.index() == a.index());
+      REQUIRE(otherIds.resolve(ha) == nullptr);
+      REQUIRE(ids.resolve(otherIds.handleOf(o.data())) == nullptr);
+    }
+  }
+}
+
+SCENARIO("Scene replacement leaves no obsolete handle", "[integration]")
+{
+  IdentityAuthority authority;
+  auto first = std::make_unique<Scene>();
+  auto m = first->createObject<vsr::scene::Material>("matte");
+  auto ids = std::make_unique<SceneIdentity>(authority, *first);
+  const auto oldHandle = ids->handleOf(m.data());
+  const auto oldRevision = ids->sceneRevision();
+  const auto oldToken = *ids->parameterVersion(oldHandle);
+
+  ids.reset();
+  first.reset();
+  Scene replacement;
+  auto n = replacement.createObject<vsr::scene::Material>("matte");
+  SceneIdentity replacementIds(authority, replacement);
+
+  REQUIRE(n.index() == m.index());
+  REQUIRE(replacementIds.resolve(oldHandle) == nullptr);
+  REQUIRE_FALSE(replacementIds.isCurrent(oldToken));
+  REQUIRE(replacementIds.handleOf(n.data()) != oldHandle);
+  REQUIRE(replacementIds.sceneRevision() != oldRevision);
+}
+
+SCENARIO("Earlier-activation identity never authorizes later activations",
+    "[integration]")
+{
+  Scene scene;
+  auto m = scene.createObject<vsr::scene::Material>("matte");
+
+  ObjectHandle earlierHandle;
+  ParameterVersionToken earlierToken;
+  SceneRevision earlierRevision;
+  {
+    IdentityAuthority earlier;
+    SceneIdentity ids(earlier, scene);
+    earlierHandle = ids.handleOf(m.data());
+    earlierToken = *ids.parameterVersion(earlierHandle);
+    earlierRevision = ids.sceneRevision();
+  }
+
+  IdentityAuthority later;
+  SceneIdentity ids(later, scene);
+  REQUIRE(ids.resolve(earlierHandle) == nullptr);
+  REQUIRE_FALSE(ids.isCurrent(earlierToken));
+  REQUIRE(ids.handleOf(m.data()) != earlierHandle);
+  REQUIRE(ids.sceneRevision() != earlierRevision);
+}
+
+SCENARIO(
+    "Parameter-version tokens track every parameter change", "[integration]")
+{
+  Scene scene;
+  IdentityAuthority authority;
+  SceneIdentity ids(authority, scene);
+
+  auto light = scene.createObject<vsr::scene::Light>("directional");
+  auto other = scene.createObject<vsr::scene::Light>("directional");
+  light->setParameter("irradiance", 1.f);
+  light->setParameter("direction", vsr::math::float3(0.f, 0.f, -1.f));
+  const auto h = ids.handleOf(light.data());
+  const auto original = *ids.parameterVersion(h);
+
+  WHEN("the same parameter changes")
+  {
+    light->setParameter("irradiance", 2.f);
+    THEN("the token is stale")
+    {
+      REQUIRE_FALSE(ids.isCurrent(original));
+    }
+  }
+  WHEN("another parameter of the same object changes")
+  {
+    light->setParameter("direction", vsr::math::float3(0.f, -1.f, 0.f));
+    THEN("the token is stale")
+    {
+      REQUIRE_FALSE(ids.isCurrent(original));
+    }
+  }
+  WHEN("a value changes and changes back to the original")
+  {
+    const auto sceneBefore = ids.sceneRevision();
+    light->setParameter("irradiance", 2.f);
+    light->setParameter("irradiance", 1.f);
+    THEN("neither the token nor the scene revision looks unchanged")
+    {
+      REQUIRE_FALSE(ids.isCurrent(original));
+      REQUIRE(*ids.parameterVersion(h) != original);
+      REQUIRE(ids.sceneRevision() != sceneBefore);
+    }
+  }
+  WHEN("a parameter is removed")
+  {
+    light->removeParameter("direction");
+    THEN("the token is stale")
+    {
+      REQUIRE_FALSE(ids.isCurrent(original));
+    }
+  }
+  WHEN("only another object changes")
+  {
+    other->setParameter("irradiance", 5.f);
+    THEN("the token stays current")
+    {
+      REQUIRE(ids.isCurrent(original));
+    }
+  }
+  WHEN("only metadata or the label changes")
+  {
+    const auto sceneBefore = ids.sceneRevision();
+    const auto inspectionBefore = ids.inspectionRevision();
+    light->setName("key light");
+    light->setMetadataValue("note", 1);
+    THEN("it is signalled incrementally without a refresh")
+    {
+      REQUIRE(ids.inspectionRevision() != inspectionBefore);
+      REQUIRE_FALSE(ids.refreshMetadata(h));
+    }
+    THEN("it is not a parameter change but invalidates inspection")
+    {
+      REQUIRE(ids.isCurrent(original));
+      REQUIRE(ids.sceneRevision() == sceneBefore);
+      REQUIRE(ids.inspectionRevision() != inspectionBefore);
+    }
+    THEN("refreshing again without changes is a no-op")
+    {
+      const auto settled = ids.inspectionRevision();
+      REQUIRE_FALSE(ids.refreshAllMetadata());
+      REQUIRE(ids.inspectionRevision() == settled);
+    }
+  }
+}
+
+SCENARIO("Scene revisions cover render-relevant content", "[integration]")
+{
+  Scene scene;
+  IdentityAuthority authority;
+  SceneIdentity ids(authority, scene);
+  auto *layer = scene.defaultLayer();
+  const auto before = ids.sceneRevision();
+
+  SECTION("object creation")
+  {
+    scene.createObject<vsr::scene::Geometry>("sphere");
+    REQUIRE(ids.sceneRevision() != before);
+  }
+  SECTION("layer structure")
+  {
+    scene.insertChildTransformNode(layer->root());
+    REQUIRE(ids.sceneRevision() != before);
+  }
+  SECTION("adding and deactivating layers")
+  {
+    scene.addLayer("extra");
+    const auto added = ids.sceneRevision();
+    REQUIRE(added != before);
+    scene.setLayerActive("extra", false);
+    REQUIRE(ids.sceneRevision() != added);
+  }
+  SECTION("camera and renderer changes belong to views, not the scene")
+  {
+    auto camera = scene.createObject<vsr::scene::Camera>("perspective");
+    const auto withCamera = ids.sceneRevision();
+    camera->setParameter("fovy", 0.5f);
+    REQUIRE(ids.sceneRevision() == withCamera);
+  }
+}
+
+SCENARIO("View revisions cover camera, renderer, dimensions and pipeline",
+    "[integration]")
+{
+  Scene scene;
+  IdentityAuthority authority;
+  SceneIdentity ids(authority, scene);
+  auto camera = scene.createObject<vsr::scene::Camera>("perspective");
+  auto camera2 = scene.createObject<vsr::scene::Camera>("perspective");
+  auto renderer = scene.createRenderer("default", "default");
+  auto material = scene.createObject<vsr::scene::Material>("matte");
+
+  ViewRevisionTracker view(authority, ids);
+  view.setCamera(ids.handleOf(camera.data()));
+  view.setRenderer(ids.handleOf(renderer.get()));
+  view.setDimensions(64, 32);
+  const auto base = view.revision();
+  REQUIRE(view.revision() == base);
+
+  SECTION("camera parameter change, including change-back")
+  {
+    camera->setParameter("fovy", 0.5f);
+    const auto r1 = view.revision();
+    REQUIRE(r1 != base);
+    camera->setParameter("fovy", 0.5f);
+    REQUIRE(view.revision() != r1);
+  }
+  SECTION("switching camera")
+  {
+    view.setCamera(ids.handleOf(camera2.data()));
+    REQUIRE(view.revision() != base);
+  }
+  SECTION("renderer parameter change")
+  {
+    renderer->setParameter("pixelSamples", 4);
+    REQUIRE(view.revision() != base);
+  }
+  SECTION("resize")
+  {
+    view.setDimensions(64, 64);
+    REQUIRE(view.revision() != base);
+  }
+  SECTION("unchanged dimensions do not bump")
+  {
+    view.setDimensions(64, 32);
+    REQUIRE(view.revision() == base);
+  }
+  SECTION("pipeline configuration")
+  {
+    view.notePipelineChanged();
+    REQUIRE(view.revision() != base);
+  }
+  SECTION("unrelated scene content does not bump the view")
+  {
+    material->setParameter("opacity", 0.5f);
+    REQUIRE(view.revision() == base);
+  }
+}
+
+SCENARIO("Inspection revisions change independently of edit and render",
+    "[integration]")
+{
+  Scene scene;
+  IdentityAuthority authority;
+  SceneIdentity ids(authority, scene);
+  auto m = scene.createObject<vsr::scene::Material>("matte");
+  const auto h = ids.handleOf(m.data());
+  const auto token = *ids.parameterVersion(h);
+  const auto sceneBefore = ids.sceneRevision();
+  const auto inspectBefore = ids.inspectionRevision();
+
+  SECTION("registration change")
+  {
+    ids.noteRegistrationChanged();
+    REQUIRE(ids.inspectionRevision() != inspectBefore);
+    REQUIRE(ids.sceneRevision() == sceneBefore);
+    REQUIRE(ids.isCurrent(token));
+  }
+  SECTION("metadata change")
+  {
+    m->setMetadataValue("tag", 3);
+    REQUIRE(ids.refreshAllMetadata());
+    REQUIRE(ids.inspectionRevision() != inspectBefore);
+    REQUIRE(ids.sceneRevision() == sceneBefore);
+    REQUIRE(ids.isCurrent(token));
+  }
+  SECTION("returned parameter values and membership also change it")
+  {
+    m->setParameter("opacity", 0.25f);
+    const auto afterValue = ids.inspectionRevision();
+    REQUIRE(afterValue != inspectBefore);
+    scene.createObject<vsr::scene::Material>("matte");
+    REQUIRE(ids.inspectionRevision() != afterValue);
+  }
+  SECTION("revision kinds from different scopes never compare equal")
+  {
+    Scene other;
+    SceneIdentity otherIds(authority, other);
+    REQUIRE(otherIds.sceneRevision() != ids.sceneRevision());
+  }
+}
diff --git a/src/tests/integration/test_IntegrationImage.cpp b/src/tests/integration/test_IntegrationImage.cpp
new file mode 100644
index 0000000000..14a519a51e
--- /dev/null
+++ b/src/tests/integration/test_IntegrationImage.cpp
@@ -0,0 +1,359 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/image/ImageNormalization.hpp"
+// Independent PNG decoder for the oracle. Private to this TU (static) and
+// included by path so the test needs no shared CMake change.
+#define STB_IMAGE_STATIC
+#define STB_IMAGE_IMPLEMENTATION
+#define STBI_ONLY_PNG
+#define STBI_NO_STDIO
+#include "../../../external/vela_stb_image/stb_image.h"
+// std
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <string>
+#include <vector>
+
+using namespace vsr::integration::image;
+
+namespace {
+
+struct Decoded
+{
+  int width{0};
+  int height{0};
+  int channels{0};
+  std::vector<std::uint8_t> rgba;
+};
+
+Decoded decodePng(const std::vector<std::uint8_t> &png)
+{
+  Decoded d;
+  unsigned char *pixels = stbi_load_from_memory(
+      png.data(), int(png.size()), &d.width, &d.height, &d.channels, 4);
+  REQUIRE(pixels != nullptr);
+  d.rgba.assign(pixels, pixels + std::size_t(d.width) * d.height * 4);
+  stbi_image_free(pixels);
+  return d;
+}
+
+std::array<std::uint8_t, 4> pixelAt(const Decoded &d, int x, int y)
+{
+  const auto *p = d.rgba.data() + (std::size_t(y) * d.width + x) * 4;
+  return {p[0], p[1], p[2], p[3]};
+}
+
+// Normalize a single float pixel and return its decoded RGBA8.
+std::array<std::uint8_t, 4> oneFloatPixel(
+    float r, float g, float b, float a, AlphaMode mode = AlphaMode::STRAIGHT)
+{
+  const float px[4] = {r, g, b, a};
+  SourceImage src;
+  src.width = 1;
+  src.height = 1;
+  src.encoding = ChannelEncoding::LINEAR_FLOAT;
+  src.alpha = mode;
+  src.pixels = px;
+  auto res = normalizeToPng(src);
+  REQUIRE(res.ok());
+  return pixelAt(decodePng(res.image.png), 0, 0);
+}
+
+std::array<std::uint8_t, 4> oneSrgbPixel(std::uint8_t r,
+    std::uint8_t g,
+    std::uint8_t b,
+    std::uint8_t a,
+    AlphaMode mode)
+{
+  const std::uint8_t px[4] = {r, g, b, a};
+  SourceImage src;
+  src.width = 1;
+  src.height = 1;
+  src.encoding = ChannelEncoding::SRGB_UINT8;
+  src.alpha = mode;
+  src.pixels = px;
+  auto res = normalizeToPng(src);
+  REQUIRE(res.ok());
+  return pixelAt(decodePng(res.image.png), 0, 0);
+}
+
+// Reference sRGB encode for the oracle, independent of the implementation.
+int refSrgb8(double linear)
+{
+  const double e = linear <= 0.0031308
+      ? 12.92 * linear
+      : 1.055 * std::pow(linear, 1.0 / 2.4) - 0.055;
+  return int(std::floor(e * 255.0 + 0.5));
+}
+
+double refDecode(int v)
+{
+  const double e = v / 255.0;
+  return e <= 0.04045 ? e / 12.92 : std::pow((e + 0.055) / 1.055, 2.4);
+}
+
+} // namespace
+
+TEST_CASE("PNG result is RGBA8 with top-left origin", "[integration][image]")
+{
+  // 3x2 asymmetric image, distinct pixel per position (8-bit passthrough).
+  // Bottom-left-origin source: first memory row is the bottom row.
+  const std::uint8_t bottomUp[2][3][4] = {
+      {{10, 0, 0, 255}, {20, 0, 0, 255}, {30, 0, 0, 255}}, // bottom row
+      {{0, 40, 0, 255}, {0, 50, 0, 255}, {0, 60, 0, 128}}, // top row
+  };
+  SourceImage src;
+  src.width = 3;
+  src.height = 2;
+  src.encoding = ChannelEncoding::SRGB_UINT8;
+  src.alpha = AlphaMode::STRAIGHT;
+
+  SECTION("bottom-left source is flipped to top-left output")
+  {
+    src.origin = RowOrigin::BOTTOM_LEFT;
+    src.pixels = bottomUp;
+    auto res = normalizeToPng(src);
+    REQUIRE(res.ok());
+    CHECK(res.image.width == 3);
+    CHECK(res.image.height == 2);
+    auto d = decodePng(res.image.png);
+    CHECK(d.width == 3);
+    CHECK(d.height == 2);
+    CHECK(d.channels == 4);
+    // y downward: row 0 is the top row.
+    CHECK(pixelAt(d, 0, 0) == std::array<std::uint8_t, 4>{0, 40, 0, 255});
+    CHECK(pixelAt(d, 2, 0) == std::array<std::uint8_t, 4>{0, 60, 0, 128});
+    CHECK(pixelAt(d, 0, 1) == std::array<std::uint8_t, 4>{10, 0, 0, 255});
+    CHECK(pixelAt(d, 2, 1) == std::array<std::uint8_t, 4>{30, 0, 0, 255});
+  }
+
+  SECTION("top-left source keeps row order")
+  {
+    src.origin = RowOrigin::TOP_LEFT;
+    src.pixels = bottomUp;
+    auto d = decodePng(normalizeToPng(src).image.png);
+    CHECK(pixelAt(d, 0, 0) == std::array<std::uint8_t, 4>{10, 0, 0, 255});
+    CHECK(pixelAt(d, 1, 1) == std::array<std::uint8_t, 4>{0, 50, 0, 255});
+  }
+
+  SECTION("PNG header declares 8-bit RGBA and sRGB")
+  {
+    src.pixels = bottomUp;
+    const auto png = normalizeToPng(src).image.png;
+    REQUIRE(png.size() > 33);
+    CHECK(png[0] == 0x89);
+    CHECK(png[1] == 'P');
+    CHECK(png[24] == 8); // bit depth
+    CHECK(png[25] == 6); // color type RGBA
+    const std::string body(png.begin(), png.end());
+    CHECK(body.find("sRGB") != std::string::npos);
+  }
+}
+
+TEST_CASE("Invalid sources are rejected", "[integration][image]")
+{
+  const float px[4] = {0, 0, 0, 1};
+  SourceImage src;
+  src.pixels = px;
+  src.width = 0;
+  src.height = 1;
+  CHECK(normalizeToPng(src).error == NormalizeError::INVALID_DIMENSIONS);
+  src.width = 1;
+  src.height = 0;
+  CHECK(normalizeToPng(src).error == NormalizeError::INVALID_DIMENSIONS);
+  src.height = 1;
+  src.pixels = nullptr;
+  CHECK(normalizeToPng(src).error == NormalizeError::NO_PIXELS);
+}
+
+TEST_CASE("Float linear color is clamped, sRGB-encoded and rounded",
+    "[integration][image]")
+{
+  SECTION("out-of-range and NaN")
+  {
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    const float inf = std::numeric_limits<float>::infinity();
+    CHECK(oneFloatPixel(-1.f, 2.f, nan, 1.f)
+        == std::array<std::uint8_t, 4>{0, 255, 0, 255});
+    CHECK(oneFloatPixel(inf, -inf, 1.f, 1.f)
+        == std::array<std::uint8_t, 4>{255, 0, 255, 255});
+  }
+
+  SECTION("linear mid-gray goes through the sRGB transfer function")
+  {
+    const auto p = oneFloatPixel(0.5f, 0.5f, 0.5f, 1.f);
+    CHECK(int(p[0]) == refSrgb8(0.5));
+    CHECK(int(p[0]) == 188); // not 128: encoded, not linear
+    CHECK(p[1] == p[0]);
+    CHECK(p[2] == p[0]);
+    // Linear segment near black.
+    CHECK(int(oneFloatPixel(0.001f, 0, 0, 1)[0]) == refSrgb8(0.001));
+  }
+
+  SECTION("exact halves round up")
+  {
+    // Encoded values landing exactly on k + 0.5 after scaling.
+    CHECK(quantizeUnit(0.5 / 255.0) == 1);
+    CHECK(quantizeUnit(127.5 / 255.0) == 128);
+    CHECK(quantizeUnit(254.5 / 255.0) == 255);
+    CHECK(quantizeUnit(127.49 / 255.0) == 127);
+  }
+
+  SECTION("encode/decode primitives agree with reference")
+  {
+    for (int v = 0; v <= 255; ++v)
+      CHECK(int(linearToSrgb8(refDecode(v))) == v);
+  }
+}
+
+TEST_CASE("Alpha is clamped and quantized", "[integration][image]")
+{
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  CHECK(oneFloatPixel(1, 1, 1, nan)[3] == 0);
+  CHECK(oneFloatPixel(1, 1, 1, -0.5f)[3] == 0);
+  CHECK(oneFloatPixel(1, 1, 1, 7.f)[3] == 255);
+  // Quantization midpoint: 0.5 * 255 = 127.5 -> 128 (halves round up).
+  CHECK(oneFloatPixel(1, 1, 1, 0.5f)[3] == 128);
+  CHECK(oneFloatPixel(1, 1, 1, 0.25f)[3] == 64); // 63.75 -> 64
+  CHECK(oneFloatPixel(1, 1, 1, 0.1f)[3] == 26); // 25.5 (+eps) -> 26
+  // Straight alpha leaves color alone.
+  CHECK(oneFloatPixel(0.5f, 0, 0, 0.25f)[0] == 188);
+}
+
+TEST_CASE("8-bit sRGB straight-alpha source passes through unchanged",
+    "[integration][image]")
+{
+  std::vector<std::uint8_t> px;
+  for (int i = 0; i < 256; ++i) {
+    px.push_back(std::uint8_t(i));
+    px.push_back(std::uint8_t(255 - i));
+    px.push_back(std::uint8_t(i * 7));
+    px.push_back(std::uint8_t(i * 13)); // alpha included, incl. 0 with RGB
+  }
+  SourceImage src;
+  src.width = 16;
+  src.height = 16;
+  src.encoding = ChannelEncoding::SRGB_UINT8;
+  src.alpha = AlphaMode::STRAIGHT;
+  src.pixels = px.data();
+  auto d = decodePng(normalizeToPng(src).image.png);
+  CHECK(d.rgba == px);
+}
+
+TEST_CASE("Premultiplied sources become straight alpha in linear space",
+    "[integration][image]")
+{
+  SECTION("float premultiplied")
+  {
+    // Straight linear 0.5 at alpha 0.5 is premultiplied 0.25.
+    const auto p =
+        oneFloatPixel(0.25f, 0.5f, 0.f, 0.5f, AlphaMode::PREMULTIPLIED);
+    CHECK(int(p[0]) == refSrgb8(0.5));
+    CHECK(p[1] == 255);
+    CHECK(p[2] == 0);
+    CHECK(p[3] == 128);
+  }
+
+  SECTION("RGB is 0 where alpha is 0")
+  {
+    CHECK(oneFloatPixel(0.7f, 0.2f, 1.f, 0.f, AlphaMode::PREMULTIPLIED)
+        == std::array<std::uint8_t, 4>{0, 0, 0, 0});
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    CHECK(oneFloatPixel(0.7f, 0.2f, 1.f, nan, AlphaMode::PREMULTIPLIED)
+        == std::array<std::uint8_t, 4>{0, 0, 0, 0});
+    CHECK(oneSrgbPixel(200, 100, 50, 0, AlphaMode::PREMULTIPLIED)
+        == std::array<std::uint8_t, 4>{0, 0, 0, 0});
+  }
+
+  SECTION("8-bit sRGB premultiplied is decoded before unpremultiplying")
+  {
+    // Premultiplied linear 0.25 at alpha 128/255; sRGB of 0.25 is 137.
+    const std::uint8_t enc = std::uint8_t(refSrgb8(0.25));
+    const auto p = oneSrgbPixel(enc, enc, 0, 128, AlphaMode::PREMULTIPLIED);
+    const double straight = refDecode(enc) / (128 / 255.0);
+    CHECK(int(p[0]) == refSrgb8(straight));
+    CHECK(p[3] == 128);
+    // Unpremultiplying in encoded space would give round(137/0.502)=255+;
+    // linear space gives ~0.498 -> ~187.
+    CHECK(int(p[0]) >= 185);
+    CHECK(int(p[0]) <= 190);
+    CHECK(p[2] == 0);
+  }
+
+  SECTION("opaque premultiplied equals straight")
+  {
+    CHECK(oneSrgbPixel(10, 128, 250, 255, AlphaMode::PREMULTIPLIED)
+        == std::array<std::uint8_t, 4>{10, 128, 250, 255});
+  }
+}
+
+TEST_CASE("Result owns its bytes independently of the source buffer",
+    "[integration][image]")
+{
+  NormalizeResult res;
+  {
+    auto buf = std::make_unique<float[]>(2 * 2 * 4);
+    for (int i = 0; i < 16; ++i)
+      buf[i] = 1.f;
+    SourceImage src;
+    src.width = 2;
+    src.height = 2;
+    src.encoding = ChannelEncoding::LINEAR_FLOAT;
+    src.pixels = buf.get();
+    res = normalizeToPng(src);
+    // Reuse the live buffer, then release it.
+    for (int i = 0; i < 16; ++i)
+      buf[i] = 0.f;
+  }
+  REQUIRE(res.ok());
+  auto d = decodePng(res.image.png);
+  for (int y = 0; y < 2; ++y)
+    for (int x = 0; x < 2; ++x)
+      CHECK(
+          pixelAt(d, x, y) == std::array<std::uint8_t, 4>{255, 255, 255, 255});
+}
+
+TEST_CASE("PNG image data is deflate-compressed and deterministic",
+    "[integration][image]")
+{
+  // 1024x1024 smooth float gradient, bottom-left origin like an ANARI frame.
+  const std::uint32_t n = 1024;
+  std::vector<float> px(std::size_t(n) * n * 4);
+  for (std::uint32_t y = 0; y < n; ++y)
+    for (std::uint32_t x = 0; x < n; ++x) {
+      float *p = px.data() + (std::size_t(y) * n + x) * 4;
+      p[0] = float(x) / (n - 1);
+      p[1] = float(y) / (n - 1);
+      p[2] = 0.5f * (p[0] + p[1]);
+      p[3] = 1.f;
+    }
+  SourceImage src;
+  src.width = n;
+  src.height = n;
+  src.encoding = ChannelEncoding::LINEAR_FLOAT;
+  src.origin = RowOrigin::BOTTOM_LEFT;
+  src.pixels = px.data();
+
+  auto first = normalizeToPng(src);
+  REQUIRE(first.ok());
+  const std::size_t raw = std::size_t(n) * n * 4;
+  // Stored deflate blocks would be slightly above raw (4 MiB).
+  CHECK(first.image.png.size() < raw / 4);
+
+  auto second = normalizeToPng(src);
+  REQUIRE(second.ok());
+  CHECK(first.image.png == second.image.png);
+
+  // Compression is lossless: the decoded image matches the RGBA8 mapping.
+  auto d = decodePng(first.image.png);
+  REQUIRE(d.width == int(n));
+  REQUIRE(d.height == int(n));
+  CHECK(d.rgba == normalizeToRgba8(src));
+}
diff --git a/src/tests/integration/test_IntegrationInspection.cpp b/src/tests/integration/test_IntegrationInspection.cpp
new file mode 100644
index 0000000000..55c66f81c7
--- /dev/null
+++ b/src/tests/integration/test_IntegrationInspection.cpp
@@ -0,0 +1,381 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/inspection/Inspection.hpp"
+#include "vsr/scene/Scene.hpp"
+// std
+#include <memory>
+#include <string>
+#include <vector>
+
+using namespace vsr::integration;
+using namespace vsr::integration::operations;
+using namespace vsr::integration::inspection;
+
+namespace {
+
+bool confirmReady(SceneId)
+{
+  return true;
+}
+
+std::string field(const std::string &json, const std::string &key)
+{
+  const auto k = "\"" + key + "\":";
+  auto p = json.find(k);
+  if (p == std::string::npos)
+    return {};
+  p += k.size();
+  if (json[p] == '"')
+    return json.substr(p + 1, json.find('"', p + 1) - p - 1);
+  auto e = json.find_first_of(",}", p);
+  return json.substr(p, e - p);
+}
+
+struct Fixture
+{
+  vsr::scene::Scene scene;
+  vsr::scene::Scene second;
+  Integration integration;
+  identity::IdentityAuthority ids;
+  std::unique_ptr<identity::SceneIdentity> sceneIds;
+  SceneId sceneId{};
+  SceneId secondId{};
+  ViewId viewId{};
+  double now{100.0};
+  std::unique_ptr<session::SessionAuthority> authority;
+  std::unique_ptr<OperationEngine> engine;
+  std::unique_ptr<Inspector> inspector;
+  Credentials creds;
+  std::uint64_t nextId{1};
+
+  explicit Fixture(
+      int materials = 10, PageLimits limits = {}, bool secondScene = false)
+  {
+    for (int i = 0; i < materials; i++)
+      scene.createObject<vsr::scene::Material>("matte");
+    SceneRegistration s;
+    s.name = "scene";
+    s.scene = &scene;
+    s.grants.read = true;
+    s.grants.edit = true;
+    s.normalSyncHook = confirmReady;
+    sceneId = *integration.registerScene(s);
+    if (secondScene) {
+      s.name = "second";
+      s.scene = &second;
+      secondId = *integration.registerScene(s);
+    }
+    ViewRegistration v;
+    v.name = "view";
+    v.scene = sceneId;
+    v.grants.read = true;
+    v.grants.render = true;
+    viewId = *integration.registerView(v);
+    REQUIRE(integration.activate().ok());
+    sceneIds = std::make_unique<identity::SceneIdentity>(ids, scene);
+    authority =
+        session::SessionAuthority::create(integration, [this] { return now; });
+    engine = OperationEngine::create(
+        integration, *authority, {}, [this] { return now; });
+    inspector = std::make_unique<Inspector>(
+        integration,
+        *authority,
+        [this](SceneId id) {
+          return id == sceneId ? sceneIds.get() : nullptr;
+        },
+        limits);
+    attach();
+  }
+
+  void attach()
+  {
+    auto a = authority->attach(authority->launchCredential());
+    REQUIRE(a.code == session::Code::OK);
+    creds = {authority->launchCredential(), a.sessionId, a.sessionSecret};
+  }
+
+  Status discover(PageArgs args, std::uint64_t id)
+  {
+    auto a = submit(inspector->makeDiscovery(creds.sessionId, args), id);
+    REQUIRE(a.code == Outcome::OK);
+    return drain(id);
+  }
+
+  Admission submit(Built b, std::uint64_t id)
+  {
+    REQUIRE(b.code == Outcome::OK);
+    return engine->submit(creds, {creds.sessionId, id}, std::move(b.request));
+  }
+
+  Status drain(std::uint64_t id)
+  {
+    while (integration.service() > 0) {
+    }
+    return engine->status(creds, {creds.sessionId, id});
+  }
+
+  Status inspect(PageArgs args, std::uint64_t id)
+  {
+    auto a = submit(inspector->makeInspection(creds.sessionId, sceneId, args), id);
+    REQUIRE(a.code == Outcome::OK);
+    return drain(id);
+  }
+};
+
+} // namespace
+
+SCENARIO("page_size defaults, bounds and rejection", "[integration]")
+{
+  Fixture f(300);
+  auto &insp = *f.inspector;
+  REQUIRE(insp.makeInspection(f.creds.sessionId, f.sceneId, {0, ""}).code
+      == Outcome::INVALID_REQUEST);
+  REQUIRE(insp.makeInspection(f.creds.sessionId, f.sceneId, {257, ""}).code
+      == Outcome::INVALID_REQUEST);
+  REQUIRE(insp.makeInspection(f.creds.sessionId, f.sceneId, {256, ""}).code
+      == Outcome::OK);
+
+  auto s = f.inspect({}, 1);
+  REQUIRE(*s.terminal == Outcome::OK);
+  CHECK(field(s.result, "returned") == "64");
+  CHECK(field(s.result, "complete") == "false");
+  CHECK(field(s.result, "stop") == "item");
+  const auto cursor = field(s.result, "cursor");
+
+  // Changing page size on the continuation keeps the cursor valid.
+  auto s2 = f.inspect({200, cursor}, 2);
+  REQUIRE(*s2.terminal == Outcome::OK);
+  CHECK(field(s2.result, "returned") == "200");
+
+  // Identical retry replays the retained page.
+  auto b = f.inspector->makeInspection(f.creds.sessionId, f.sceneId, {200, cursor});
+  auto replay = f.submit(std::move(b), 2);
+  REQUIRE(replay.replayed);
+  CHECK(replay.status.result == s2.result);
+
+  auto s3 = f.inspect({256, field(s2.result, "cursor")}, 3);
+  CHECK(field(s3.result, "complete") == "true");
+  CHECK(field(s3.result, "returned") != "0");
+  CHECK(field(s3.result, "cursor").empty());
+  CHECK(f.engine->slotsInUse() == 0);
+  CHECK(f.inspector->scratch().used() == 0);
+}
+
+SCENARIO("pages yield in slices while keeping their slot", "[integration]")
+{
+  Fixture f(1000);
+  auto a = f.submit(f.inspector->makeInspection(f.creds.sessionId, f.sceneId, {256, ""}), 1);
+  REQUIRE(a.code == Outcome::OK);
+  f.integration.service(); // one slice
+  auto st = f.engine->status(f.creds, {f.creds.sessionId, 1});
+  CHECK(st.progress == Progress::YIELDED);
+  CHECK(st.heldSlots == 1);
+  auto done = f.drain(1);
+  CHECK(*done.terminal == Outcome::OK);
+}
+
+SCENARIO("work limit and deadline", "[integration]")
+{
+  PageLimits l;
+  l.visits = 100;
+  Fixture f(300, l);
+  auto s = f.inspect({256, ""}, 1);
+  CHECK(field(s.result, "stop") == "work");
+  CHECK(std::stoi(field(s.result, "returned")) <= 100);
+  CHECK(field(s.result, "visited") == "100");
+
+  auto a = f.submit(f.inspector->makeInspection(f.creds.sessionId, f.sceneId, {}), 2);
+  REQUIRE(a.code == Outcome::OK);
+  f.now += 6.0;
+  auto t = f.drain(2);
+  CHECK(*t.terminal == Outcome::TIMEOUT);
+}
+
+SCENARIO("cursors are stale on returned-field change and tamper-proof",
+    "[integration]")
+{
+  Fixture f(100);
+  auto s = f.inspect({10, ""}, 1);
+  const auto cursor = field(s.result, "cursor");
+  REQUIRE(!cursor.empty());
+
+  std::string bad = cursor;
+  bad[3] = bad[3] == 'a' ? 'b' : 'a';
+  CHECK(f.inspector->makeInspection(f.creds.sessionId, f.sceneId, {10, bad}).code
+      == Outcome::INVALID_REQUEST);
+  CHECK(f.inspector->makeInspection("other", f.sceneId, {10, cursor}).code
+      == Outcome::INVALID_REQUEST);
+  CHECK(f.inspector->makeDiscovery(f.creds.sessionId, {10, cursor}).code
+      == Outcome::INVALID_REQUEST);
+
+  f.scene.getObject<vsr::scene::Material>(0)->setName("renamed");
+  auto st = f.inspect({10, cursor}, 2);
+  CHECK(*st.terminal == Outcome::CURSOR_STALE);
+}
+
+SCENARIO("discovery lists readable targets with current capabilities",
+    "[integration]")
+{
+  Fixture f;
+  auto a = f.submit(f.inspector->makeDiscovery(f.creds.sessionId, {1, ""}), 1);
+  REQUIRE(a.code == Outcome::OK);
+  auto s = f.drain(1);
+  CHECK(s.result.find("\"kind\":\"scene\"") != std::string::npos);
+  CHECK(s.result.find("\"edit\":true") != std::string::npos);
+  const auto cursor = field(s.result, "cursor");
+  REQUIRE(!cursor.empty());
+
+  f.authority->restrict(session::Target::scene(f.sceneId),
+      session::Capability::EDIT);
+  f.submit(f.inspector->makeDiscovery(f.creds.sessionId, {1, cursor}), 2);
+  CHECK(*f.drain(2).terminal == Outcome::CURSOR_STALE);
+
+  f.authority->restrict(session::Target::view(f.viewId),
+      session::Capability::READ);
+  f.submit(f.inspector->makeDiscovery(f.creds.sessionId, {}), 3);
+  auto all = f.drain(3);
+  CHECK(field(all.result, "returned") == "1");
+  CHECK(all.result.find("\"kind\":\"view\"") == std::string::npos);
+}
+
+SCENARIO("optional text truncation is marked; oversize is item_too_large",
+    "[integration]")
+{
+  PageLimits l;
+  l.itemBytes = 6000;
+  Fixture f(0, l);
+  auto m = f.scene.createObject<vsr::scene::Material>("matte");
+  m->setName(std::string(5000, 'x'));
+  auto s = f.inspect({}, 1);
+  CHECK(s.result.find("\"truncated\":true,\"original_length\":5000")
+      != std::string::npos);
+
+  PageLimits tiny;
+  tiny.itemBytes = 64;
+  Fixture g(1, tiny);
+  CHECK(*g.inspect({}, 1).terminal == Outcome::ITEM_TOO_LARGE);
+}
+
+SCENARIO("inspection returns current values of editable parameters",
+    "[integration]")
+{
+  Fixture f(0);
+  auto m = f.scene.createObject<vsr::scene::Material>("matte");
+  m->setParameter("color", vsr::core::math::float3(0.1f, 0.5f, 1.f));
+  m->setParameter("opacity", 0.25f);
+  auto l = f.scene.createObject<vsr::scene::Light>("directional");
+  l->setParameter("color", vsr::core::math::float3(1.f, 0.f, 0.5f));
+  l->setParameter("irradiance", 2.5f);
+  l->setParameter("direction", vsr::core::math::float2(30.f, 45.f));
+  auto s = f.inspect({256, ""}, 1);
+  REQUIRE(*s.terminal == Outcome::OK);
+  CHECK(s.result.find("\"values\":{\"color\":[0.10000000149011612,0.5,1],"
+                      "\"opacity\":0.25}")
+      != std::string::npos);
+  CHECK(s.result.find("\"values\":{\"color\":[1,0,0.5],\"irradiance\":2.5,"
+                      "\"direction\":[30,45]}")
+      != std::string::npos);
+  // Only matte materials and directional lights carry values.
+  std::size_t n = 0;
+  for (auto p = s.result.find("\"values\""); p != std::string::npos;
+       p = s.result.find("\"values\"", p + 1))
+    n++;
+  CHECK(n == 3); // plus the scene's default matte material
+}
+
+SCENARIO("name and metadata changes stale cursors without a full refresh",
+    "[integration]")
+{
+  Fixture f(100);
+  auto s = f.inspect({10, ""}, 1);
+  auto cursor = field(s.result, "cursor");
+  f.scene.getObject<vsr::scene::Material>(50)->setMetadataValue("note", 1);
+  CHECK(*f.inspect({10, cursor}, 2).terminal == Outcome::CURSOR_STALE);
+
+  s = f.inspect({10, ""}, 3);
+  cursor = field(s.result, "cursor");
+  auto page = f.inspect({10, cursor}, 4);
+  CHECK(*page.terminal == Outcome::OK);
+  f.scene.getObject<vsr::scene::Material>(50)->setName("key");
+  CHECK(*f.inspect({10, cursor}, 5).terminal == Outcome::CURSOR_STALE);
+}
+
+SCENARIO("inspection after mass removal is safe", "[integration]")
+{
+  // Ticket 55's crash held raw Object pointers from createObject() across
+  // pool growth; removal through fresh lookups must always be safe.
+  Fixture f(0);
+  std::vector<std::size_t> made;
+  for (int i = 0; i < 150; i++)
+    made.push_back(f.scene.createObject<vsr::scene::Material>("matte").index());
+  for (int i = 0; i < 149; i++)
+    f.scene.removeObject(f.scene.getObject(ANARI_MATERIAL, made[i]));
+  auto s = f.inspect({256, ""}, 1);
+  REQUIRE(*s.terminal == Outcome::OK);
+  CHECK(field(s.result, "complete") == "true");
+  // default material + survivor + default camera
+  CHECK(field(s.result, "returned") == "3");
+
+  f.scene.removeUnusedObjects(true);
+  f.scene.defragmentObjectStorage();
+  auto t = f.inspect({256, ""}, 2);
+  REQUIRE(*t.terminal == Outcome::OK);
+  CHECK(field(t.result, "complete") == "true");
+}
+
+SCENARIO("discovery is admitted session-wide", "[integration]")
+{
+  GIVEN("only a non-first scene is readable")
+  {
+    Fixture f(1, {}, true);
+    f.authority->restrict(session::Target::scene(f.sceneId),
+        session::Capability::READ);
+    f.authority->restrict(session::Target::view(f.viewId),
+        session::Capability::READ);
+    auto s = f.discover({}, 1);
+    REQUIRE(*s.terminal == Outcome::OK);
+    CHECK(field(s.result, "returned") == "1");
+    CHECK(s.result.find("\"kind\":\"scene\",\"id\":"
+                        + std::to_string(f.secondId))
+        != std::string::npos);
+  }
+  GIVEN("no readable target")
+  {
+    Fixture f(1);
+    f.authority->restrict(session::Target::scene(f.sceneId),
+        session::Capability::READ);
+    f.authority->restrict(session::Target::view(f.viewId),
+        session::Capability::READ);
+    auto s = f.discover({}, 1);
+    REQUIRE(*s.terminal == Outcome::OK);
+    CHECK(field(s.result, "returned") == "0");
+    CHECK(field(s.result, "complete") == "true");
+  }
+  GIVEN("a page listing only the view, looked up from a later session")
+  {
+    Fixture f(1);
+    f.authority->restrict(session::Target::scene(f.sceneId),
+        session::Capability::READ);
+    auto s = f.discover({}, 1);
+    REQUIRE(field(s.result, "returned") == "1");
+    const OperationRef old{f.creds.sessionId, 1};
+    REQUIRE(f.engine->detach(f.creds) == Outcome::OK);
+    f.attach();
+    THEN("covered targets are exactly the listed view")
+    {
+      auto st = f.engine->status(f.creds, old);
+      REQUIRE(st.code == Outcome::OK);
+      CHECK(st.result == s.result);
+    }
+    THEN("withdrawing read on the listed view denies the foreign lookup")
+    {
+      f.authority->restrict(session::Target::view(f.viewId),
+          session::Capability::READ);
+      CHECK(f.engine->status(f.creds, old).code == Outcome::FORBIDDEN);
+    }
+  }
+}
