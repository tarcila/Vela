+  {
+    return m_fd >= 0;
+  }
+  const std::string &path() const
+  {
+    return m_path;
+  }
+  int fd() const
+  {
+    return m_fd;
+  }
+#if defined(__linux__)
+  uid_t owner() const
+  {
+    return m_owner;
+  }
+#endif
