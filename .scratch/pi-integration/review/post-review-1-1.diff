+    {
+      REQUIRE(f.authority->authorize(creds, scene, Capability::READ)
+          == Code::SESSION_EXPIRED);
+      REQUIRE_FALSE(f.authority->hasSession());
+      REQUIRE(f.authority->renew(creds) == Code::SESSION_EXPIRED);
+    }
+  }
+
+  WHEN("the client renews")
+  {
+    f.now += 100.0;
+    REQUIRE(f.authority->renew(creds) == Code::OK);
+    THEN("the lease extends from renewal time")
+    {
+      f.now += 119.0;
+      REQUIRE(f.authority->authenticate(creds) == Code::OK);
+      f.now += 1.0;
+      REQUIRE(f.authority->authenticate(creds) == Code::SESSION_EXPIRED);
+    }
+  }
+
+  WHEN("the host checks expiry at a safe point")
+  {
+    std::vector<std::pair<std::string, EndReason>> ended;
+    f.authority->setSessionEndedCallback(
+        [&](const std::string &id, EndReason r) { ended.push_back({id, r}); });
+    f.now += 120.0;
+    f.authority->expireIfDue();
+    THEN("the session ends with an expired signal and execution rejects")
+    {
+      REQUIRE_FALSE(f.authority->hasSession());
+      REQUIRE(ended.size() == 1);
+      REQUIRE(ended[0].first == att.sessionId);
+      REQUIRE(ended[0].second == EndReason::EXPIRED);
+      REQUIRE(f.authority->authorizeExecution(
+                  att.sessionId, scene, Capability::READ)
+          == Code::SESSION_EXPIRED);
+    }
+  }
+}
+
+SCENARIO("Ended sessions never revive", "[integration]")
+{
+  Fixture f;
+  const auto launch = f.authority->launchCredential();
+  const auto scene = Target::scene(f.sceneId);
+  auto first = f.authority->attach(launch);
+  const auto old = f.credentialsFor(first);
+
+  std::vector<EndReason> reasons;
+  f.authority->setSessionEndedCallback(
+      [&](const std::string &, EndReason r) { reasons.push_back(r); });
+
+  auto checkFresh = [&](EndReason expected) {
+    REQUIRE(reasons.size() == 1);
+    REQUIRE(reasons[0] == expected);
+    REQUIRE(f.authority->authenticate(old) == Code::INVALID_SESSION_PROOF);
+    REQUIRE(f.authority->authorizeExecution(
+                first.sessionId, scene, Capability::READ)
+        == Code::INVALID_SESSION_PROOF);
+    auto next = f.authority->attach(launch);
+    REQUIRE(next.code == Code::OK);
+    REQUIRE(next.sessionId != first.sessionId);
+    REQUIRE(next.sessionSecret != first.sessionSecret);
+    REQUIRE(f.authority->authenticate(old) == Code::INVALID_SESSION_PROOF);
+    REQUIRE(f.authority->authenticate(f.credentialsFor(next)) == Code::OK);
+  };
+
+  WHEN("the client detaches")
+  {
+    REQUIRE(f.authority->detach(old) == Code::OK);
+    THEN("the old proof is stale and a new attach is fresh")
+    {
+      checkFresh(EndReason::DETACHED);
+      REQUIRE(f.authority->detach(old) == Code::INVALID_SESSION_PROOF);
+    }
+  }
+
+  WHEN("the host revokes the whole session")
+  {
+    REQUIRE(f.authority->revokeSession());
+    THEN("the old proof is stale and a new attach is fresh")
+    {
+      checkFresh(EndReason::REVOKED);
+      REQUIRE(f.authority->renew(old) == Code::INVALID_SESSION_PROOF);
+    }
+  }
+
+  WHEN("the lease expires")
+  {
+    f.now += 200.0;
+    auto next = f.authority->attach(launch);
+    THEN("a new attach replaces it and the old secret stays dead")
+    {
+      REQUIRE(next.code == Code::OK);
+      REQUIRE(next.sessionId != first.sessionId);
+      REQUIRE(reasons.size() == 1);
+      REQUIRE(reasons[0] == EndReason::EXPIRED);
+      REQUIRE(f.authority->authenticate(old) != Code::OK);
+      REQUIRE(f.authority->renew(old) != Code::OK);
+    }
+  }
+
+  WHEN("no session exists")
+  {
+    REQUIRE(f.authority->detach(old) == Code::OK);
+    THEN("revocation is a no-op")
+    {
+      REQUIRE_FALSE(f.authority->revokeSession());
+    }
+  }
+}
+
+SCENARIO("Secrets never appear in logs or error text", "[integration]")
+{
+  std::vector<std::string> logs;
+  vsr::core::setLoggingCallback(
+      [&](vsr::core::LogLevel, std::string msg) { logs.push_back(msg); });
+
+  Fixture f;
+  const auto launch = f.authority->launchCredential();
+  auto att = f.authority->attach(launch);
+  auto creds = f.credentialsFor(att);
+  f.authority->attach(launch);
+  f.authority->authorize(
+      creds, Target::scene(f.readOnlyScene), Capability::EDIT);
+  auto bad = creds;
+  bad.sessionProof = "x" + att.sessionSecret;
+  f.authority->authorize(bad, Target::scene(f.sceneId), Capability::READ);
+  f.authority->detach(creds);
+  f.now += 500.0;
+  f.authority->renew(creds);
+
+  vsr::core::setNoLogging();
+
+  std::vector<std::string> texts = logs;
+  for (auto c : {Code::OK,
+           Code::OCCUPIED,
+           Code::UNAUTHENTICATED,
+           Code::INVALID_SESSION_PROOF,
+           Code::FORBIDDEN,
+           Code::SESSION_EXPIRED}) {
+    texts.push_back(codeName(c));
+    texts.push_back(codeMessage(c));
+  }
+  for (const auto &t : texts) {
+    REQUIRE(t.find(launch) == std::string::npos);
+    REQUIRE(t.find(att.sessionSecret) == std::string::npos);
+  }
+}
diff --git a/src/tests/integration/test_IntegrationSync.cpp b/src/tests/integration/test_IntegrationSync.cpp
new file mode 100644
index 0000000000..3204980baa
--- /dev/null
+++ b/src/tests/integration/test_IntegrationSync.cpp
@@ -0,0 +1,412 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/Integration.hpp"
+#include "vsr/integration/edit/AgentEdit.hpp"
+#include "vsr/integration/sync/SceneSync.hpp"
+#include "vsr/scene/Scene.hpp"
+// std
+#include <functional>
+#include <memory>
+#include <optional>
+#include <string>
+#include <tuple>
+#include <vector>
+
+using namespace vsr::integration;
+using namespace vsr::integration::sync;
+using edit::EditBatch;
+using edit::EditService;
+using operations::Outcome;
+namespace tokens = vsr::scene::tokens;
+
+namespace {
+
+// Scene A with two views, unrelated scene B with one view.
+struct Fixture
+{
+  vsr::scene::Scene sceneA, sceneB;
+  Integration integration;
+  SceneId a{INVALID_SCENE_ID}, b{INVALID_SCENE_ID};
+  ViewId a1{INVALID_VIEW_ID}, a2{INVALID_VIEW_ID}, b1{INVALID_VIEW_ID};
+  double now{1000.0};
+  int hookCalls{0}, recoveryCalls{0};
+  std::function<bool(SceneId)> hook = [](SceneId) { return true; };
+  std::function<bool(SceneId)> recovery = [](SceneId) { return true; };
+  std::unique_ptr<session::SessionAuthority> authority;
+  std::unique_ptr<operations::OperationEngine> engine;
+  std::unique_ptr<identity::IdentityAuthority> ids;
+  std::unique_ptr<identity::SceneIdentity> identityA;
+  std::unique_ptr<EditService> edits;
+  std::unique_ptr<SyncService> sync;
+  operations::Credentials creds;
+  std::string sessionId;
+  vsr::scene::MaterialRef matte;
+  std::vector<std::tuple<SceneId, SyncState, SyncState>> transitions;
+
+  explicit Fixture(operations::Limits limits = {})
+  {
+    matte = sceneA.createObject<vsr::scene::Material>(tokens::material::matte);
+    matte->setParameter("opacity", 1.f);
+
+    for (auto *s : {&sceneA, &sceneB}) {
+      SceneRegistration r;
+      r.name = s == &sceneA ? "a" : "b";
+      r.scene = s;
+      r.grants = {true, true, true};
+      r.normalSyncHook = [this](SceneId id) {
+        ++hookCalls;
+        return hook(id);
+      };
+      r.recoveryCallback = [this](SceneId id) {
+        ++recoveryCalls;
+        return recovery(id);
+      };
+      (s == &sceneA ? a : b) = *integration.registerScene(r);
+    }
+    a1 = *integration.registerView(view("a1", a));
+    a2 = *integration.registerView(view("a2", a));
+    b1 = *integration.registerView(view("b1", b));
+    REQUIRE(integration.activate().ok());
+
+    authority =
+        session::SessionAuthority::create(integration, [this] { return now; });
+    REQUIRE(authority);
+    engine = operations::OperationEngine::create(
+        integration, *authority, limits, [this] { return now; });
+    REQUIRE(engine);
+    ids = std::make_unique<identity::IdentityAuthority>();
+    identityA = std::make_unique<identity::SceneIdentity>(*ids, sceneA);
+    edits = std::make_unique<EditService>(
+        integration, *engine, authority->launchId());
+    edits->attachScene(a, *identityA);
+    sync = std::make_unique<SyncService>(
+        integration, *engine, edits->syncStates());
+    sync->states().setTransitionListener(
+        [this](SceneId s, SyncState from, SyncState to) {
+          transitions.emplace_back(s, from, to);
+        });
+
+    auto at = authority->attach(authority->launchCredential());
+    REQUIRE(at.code == session::Code::OK);
+    sessionId = at.sessionId;
+    creds = {authority->launchCredential(), at.sessionId, at.sessionSecret};
+  }
+
+  ~Fixture()
+  {
+    sync.reset();
+    edits.reset();
+    identityA.reset();
+  }
+
+  static ViewRegistration view(std::string name, SceneId scene)
+  {
+    ViewRegistration v;
+    v.name = std::move(name);
+    v.scene = scene;
+    v.grants = {true, true};
+    return v;
+  }
+
+  operations::OperationRef ref(std::uint64_t id)
+  {
+    return {sessionId, id};
+  }
+
+  void drain()
+  {
+    while (integration.service() > 0) {
+    }
+  }
+
+  EditBatch opacity(double v)
+  {
+    auto token =
+        *identityA->parameterVersion(identityA->handleOf(matte.data()));
+    return {a, {{token, "opacity", JsonValue::fromNumber(v)}}};
+  }
+
+  edit::EditResult runEdit(std::uint64_t id, double v)
+  {
+    REQUIRE(edits->submit(creds, ref(id), opacity(v)).code == Outcome::OK);
+    drain();
+    return *edits->result(ref(id));
+  }
+
+  ResyncResult resync(std::uint64_t id, SceneId scene)
+  {
+    REQUIRE(
+        sync->submitResynchronize(creds, ref(id), scene).code == Outcome::OK);
+    drain();
+    auto r = sync->result(ref(id));
+    REQUIRE(r);
+    return *r;
+  }
+
+  void failSceneA(std::uint64_t id)
+  {
+    hook = [](SceneId) { return false; };
+    REQUIRE(runEdit(id, 0.25).outcome == Outcome::APPLIED_WITH_SYNC_FAILURE);
+    hook = [](SceneId) { return true; };
+  }
+};
+
+} // namespace
+
+TEST_CASE("Scene synchronization states use the frozen names", "[integration]")
+{
+  REQUIRE(std::string(syncStateName(SyncState::READY)) == "ready");
+  REQUIRE(std::string(syncStateName(SyncState::NEEDS_SYNC)) == "needs_sync");
+  REQUIRE(
+      std::string(syncStateName(SyncState::SYNCHRONIZING)) == "synchronizing");
+  REQUIRE(std::string(syncStateName(SyncState::FAILED)) == "failed");
+}
+
+SCENARIO("A failure blocks every view of its scene, not unrelated scenes",
+    "[integration]")
+{
+  Fixture fx;
+  REQUIRE(fx.sync->viewReady(fx.a1));
+  REQUIRE(fx.sync->viewReady(fx.a2));
+  fx.failSceneA(1);
+
+  REQUIRE(fx.sync->state(fx.a) == SyncState::FAILED);
+  REQUIRE_FALSE(fx.sync->viewReady(fx.a1));
+  REQUIRE_FALSE(fx.sync->viewReady(fx.a2)); // healthy sibling still blocked
+  REQUIRE(fx.sync->state(fx.b) == SyncState::READY);
+  REQUIRE(fx.sync->viewReady(fx.b1));
+}
+
+SCENARIO("Resynchronize recovers a failed scene without replaying edits",
+    "[integration]")
+{
+  Fixture fx;
+  fx.failSceneA(1);
+  const int hooksBefore = fx.hookCalls;
+  const float value = *fx.matte->parameterValueAs<float>("opacity");
+  fx.transitions.clear();
+
+  std::optional<SyncState> during;
+  fx.recovery = [&](SceneId s) {
+    during = fx.sync->state(s);
+    return true;
+  };
+  auto r = fx.resync(2, fx.a);
+
+  REQUIRE(fx.recoveryCalls == 1);
+  REQUIRE(during == SyncState::SYNCHRONIZING);
+  REQUIRE(r.ready);
+  REQUIRE(r.state == SyncState::READY);
+  REQUIRE(r.views == std::vector<ViewId>{fx.a1, fx.a2});
+  REQUIRE(fx.sync->viewReady(fx.a1));
+  REQUIRE(fx.sync->viewReady(fx.a2));
+  // No edit replay: the normal hook did not run, values are untouched.
+  REQUIRE(fx.hookCalls == hooksBefore);
+  REQUIRE(*fx.matte->parameterValueAs<float>("opacity") == value);
+  // Transitions reported.
+  REQUIRE(fx.transitions.size() == 2);
+  REQUIRE(fx.transitions[0]
+      == std::make_tuple(fx.a, SyncState::FAILED, SyncState::SYNCHRONIZING));
+  REQUIRE(fx.transitions[1]
+      == std::make_tuple(fx.a, SyncState::SYNCHRONIZING, SyncState::READY));
+  auto status = fx.engine->status(fx.creds, fx.ref(2));
+  REQUIRE(status.kind == "resynchronize");
+  REQUIRE(status.terminal == Outcome::OK);
+  REQUIRE(status.result.find("\"state\":\"ready\"") != std::string::npos);
+
+  // Earlier edit result is unchanged.
+  REQUIRE(fx.edits->result(fx.ref(1))->outcome
+      == Outcome::APPLIED_WITH_SYNC_FAILURE);
+}
+
+SCENARIO(
+    "A failed Resynchronize reports failure and never retries", "[integration]")
+{
+  for (int mode = 0; mode < 2; mode++) {
+    Fixture fx;
+    fx.failSceneA(1);
+    if (mode == 0)
+      fx.recovery = [](SceneId) { return false; };
+    else
+      fx.recovery = [](SceneId) -> bool { throw 1; };
+    auto r = fx.resync(2, fx.a);
+    REQUIRE_FALSE(r.ready);
+    REQUIRE(r.state == SyncState::FAILED);
+    REQUIRE(fx.recoveryCalls == 1);
+    // No automatic retry at later safe points.
+    fx.drain();
+    REQUIRE(fx.integration.service() == 0);
+    REQUIRE(fx.recoveryCalls == 1);
+    REQUIRE_FALSE(fx.sync->viewReady(fx.a1));
+    auto status = fx.engine->status(fx.creds, fx.ref(2));
+    REQUIRE(status.result.find("\"ready\":false") != std::string::npos);
+  }
+}
+
+SCENARIO("Resynchronize requires read and resynchronize on the scene",
+    "[integration]")
+{
+  for (auto cap :
+      {session::Capability::READ, session::Capability::RESYNCHRONIZE}) {
+    Fixture fx;
+    fx.failSceneA(1);
+    fx.authority->restrict(session::Target::scene(fx.a), cap);
+    auto adm = fx.sync->submitResynchronize(fx.creds, fx.ref(2), fx.a);
+    REQUIRE(adm.code == Outcome::FORBIDDEN);
+    fx.drain();
+    REQUIRE(fx.recoveryCalls == 0);
+    REQUIRE(fx.sync->state(fx.a) == SyncState::FAILED);
+  }
+}
+
+SCENARIO("Resynchronize consumes a scene-work slot", "[integration]")
+{
+  operations::Limits limits;
+  limits.sceneSlots = 1;
+  Fixture fx(limits);
+  REQUIRE(fx.sync->submitResynchronize(fx.creds, fx.ref(1), fx.a).code
+      == Outcome::OK);
+  REQUIRE(fx.engine->slotsInUse() == 1);
+  REQUIRE(fx.sync->submitLocalResynchronize(fx.b).code == Outcome::BUSY);
+  REQUIRE(fx.sync->submitResynchronize(fx.creds, fx.ref(2), fx.b).code
+      == Outcome::BUSY);
+  fx.drain();
+  REQUIRE(fx.engine->slotsInUse() == 0);
+  auto local = fx.sync->submitLocalResynchronize(fx.b);
+  REQUIRE(local.code == Outcome::OK);
+  fx.drain();
+  REQUIRE(fx.sync->resultLocal(local.ref)->ready);
+}
+
+SCENARIO(
+    "Inspection and authorized edits continue while not ready", "[integration]")
+{
+  Fixture fx;
+  fx.failSceneA(1);
+  auto r = fx.runEdit(2, 0.75);
+  REQUIRE(r.committed);
+  REQUIRE(r.outcome == Outcome::APPLIED_WITH_SYNC_FAILURE);
+  REQUIRE(*fx.matte->parameterValueAs<float>("opacity") == 0.75f);
+  REQUIRE(fx.sync->state(fx.a) == SyncState::FAILED);
+  // Read access is not gated on readiness.
+  REQUIRE(fx.authority->authorize(
+              fx.creds, session::Target::scene(fx.a), session::Capability::READ)
+      == session::Code::OK);
+
+  fx.resync(3, fx.a);
+  REQUIRE(fx.runEdit(4, 0.5).outcome == Outcome::OK);
+  REQUIRE(fx.sync->state(fx.a) == SyncState::READY);
+}
+
+SCENARIO("View registration during a hook waits for a later safe point",
+    "[integration]")
+{
+  Fixture fx;
+  std::optional<ViewId> added;
+  bool unregistered = false;
+  std::vector<ViewId> viewsInHook;
+  fx.hook = [&](SceneId s) {
+    viewsInHook = fx.integration.viewsOfScene(s);
+    REQUIRE(fx.sync->requestRegisterView(
+        Fixture::view("a3", fx.a),
+        [](ViewId) { return true; },
+        UnconfirmedView::FAIL_REGISTRATION,
+        [&](std::optional<ViewId> id) { added = id; }));
+    REQUIRE(fx.sync->requestUnregisterView(
+        fx.a2, [&](bool ok) { unregistered = ok; }));
+    return true;
+  };
+  REQUIRE(fx.edits->submit(fx.creds, fx.ref(1), fx.opacity(0.5)).code
+      == Outcome::OK);
+  REQUIRE(fx.integration.service() == 1); // commit
+  REQUIRE(fx.integration.service() == 1); // hook
+  REQUIRE(fx.hookCalls == 1);
+  REQUIRE(viewsInHook == std::vector<ViewId>{fx.a1, fx.a2});
+  REQUIRE_FALSE(added);
+  REQUIRE_FALSE(unregistered);
+  REQUIRE(fx.integration.isRegisteredView(fx.a2));
+
+  fx.drain(); // later safe point
+  REQUIRE(added);
+  REQUIRE(unregistered);
+  REQUIRE_FALSE(fx.integration.isRegisteredView(fx.a2));
+  REQUIRE(
+      fx.integration.viewsOfScene(fx.a) == std::vector<ViewId>{fx.a1, *added});
+  REQUIRE(fx.sync->viewReady(*added));
+}
+
+SCENARIO(
+    "View registration from outside a safe point is refused", "[integration]")
+{
+  Fixture fx;
+  REQUIRE_FALSE(fx.integration.registerView(Fixture::view("x", fx.a)));
+  REQUIRE_FALSE(fx.integration.unregisterView(fx.a1));
+}
+
+SCENARIO("A new view is usable only after host confirmation", "[integration]")
+{
+  GIVEN("confirmation that succeeds")
+  {
+    Fixture fx;
+    std::optional<bool> readyDuringConfirm;
+    std::optional<ViewId> added;
+    REQUIRE(fx.sync->requestRegisterView(
+        Fixture::view("a3", fx.a),
+        [&](ViewId v) {
+          readyDuringConfirm = fx.sync->viewReady(v);
+          return true;
+        },
+        UnconfirmedView::FAIL_REGISTRATION,
+        [&](std::optional<ViewId> id) { added = id; }));
+    fx.drain();
+    REQUIRE(readyDuringConfirm == false);
+    REQUIRE(added);
+    REQUIRE(fx.sync->viewReady(*added));
+    REQUIRE(fx.sync->state(fx.a) == SyncState::READY);
+  }
+  GIVEN("unconfirmable registration that fails")
+  {
+    Fixture fx;
+    std::optional<ViewId> added{0};
+    REQUIRE(fx.sync->requestRegisterView(
+        Fixture::view("a3", fx.a),
+        [](ViewId) { return false; },
+        UnconfirmedView::FAIL_REGISTRATION,
+        [&](std::optional<ViewId> id) { added = id; }));
+    fx.drain();
+    REQUIRE_FALSE(added);
+    REQUIRE(
+        fx.integration.viewsOfScene(fx.a) == std::vector<ViewId>{fx.a1, fx.a2});
+    REQUIRE(fx.sync->state(fx.a) == SyncState::READY);
+  }
+  GIVEN("unconfirmable registration that marks the scene needs_sync")
+  {
+    Fixture fx;
+    std::optional<ViewId> added;
+    REQUIRE(fx.sync->requestRegisterView(
+        Fixture::view("a3", fx.a),
+        [](ViewId) -> bool { throw 1; },
+        UnconfirmedView::NEEDS_SYNC,
+        [&](std::optional<ViewId> id) { added = id; }));
+    fx.drain();
+    REQUIRE(added);
+    REQUIRE(fx.sync->state(fx.a) == SyncState::NEEDS_SYNC);
+    REQUIRE_FALSE(fx.sync->viewReady(*added));
+    REQUIRE_FALSE(fx.sync->viewReady(fx.a1));
+    REQUIRE(fx.sync->viewReady(fx.b1));
+
+    // An ordinary edit cannot clear needs_sync.
+    REQUIRE(fx.runEdit(1, 0.5).outcome == Outcome::APPLIED_WITH_SYNC_FAILURE);
+    REQUIRE(fx.sync->state(fx.a) == SyncState::NEEDS_SYNC);
+
+    auto r = fx.resync(2, fx.a);
+    REQUIRE(r.ready);
+    REQUIRE(r.views == std::vector<ViewId>{fx.a1, fx.a2, *added});
+    REQUIRE(fx.sync->viewReady(*added));
+    REQUIRE(fx.sync->state(fx.a) == SyncState::READY);
+  }
+}
diff --git a/src/tests/integration/test_IntegrationValues.cpp b/src/tests/integration/test_IntegrationValues.cpp
new file mode 100644
index 0000000000..eee75c614c
--- /dev/null
+++ b/src/tests/integration/test_IntegrationValues.cpp
@@ -0,0 +1,346 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/values/EditableValues.hpp"
+#include "vsr/scene/Scene.hpp"
+// std
+#include <cfenv>
+#include <cmath>
+#include <cstring>
+#include <limits>
+
+using namespace vsr::integration;
+using vsr::core::math::float2;
+using vsr::core::math::float3;
+namespace tokens = vsr::scene::tokens;
+
+namespace {
+
+constexpr double FLT_MAX_D = double(std::numeric_limits<float>::max());
+
+std::uint32_t bitsOf(float f)
+{
+  std::uint32_t b = 0;
+  std::memcpy(&b, &f, sizeof(b));
+  return b;
+}
+
+bool isPositiveZero(float f)
+{
+  return bitsOf(f) == 0u;
+}
+
+Domain domainOf(EditableField field)
+{
+  for (const auto &f : editSurface())
+    if (f.field == field)
+      return f.domain;
+  FAIL("field missing from edit surface");
+  return {};
+}
+
+// Field-agnostic scalar checks run against every field's domain.
+void checkCommonScalarRules(Domain d)
+{
+  CHECK(convertScalar(JsonValue::fromNumber(0.1), d).value == 0.1f);
+  CHECK(convertScalar(JsonValue::fromNumber(1.0), d).value == 1.f);
+  CHECK(convertScalar(JsonValue::fromNumber(0.0), d).ok());
+  CHECK(convertScalar(JsonValue::fromNumber(d.min), d).ok());
+  CHECK(convertScalar(JsonValue::fromNumber(d.max), d).ok());
+  CHECK(convertScalar(JsonValue::fromNumber(std::nextafter(d.max, 1e300)), d)
+            .error
+      == ValueError::OUT_OF_DOMAIN);
+  CHECK(convertScalar(JsonValue::fromNumber(-1e-300), d).error
+      == ValueError::OUT_OF_DOMAIN);
+
+  auto negZero = convertScalar(JsonValue::fromNumber(-0.0), d);
+  REQUIRE(negZero.ok());
+  CHECK(isPositiveZero(negZero.value));
+  auto underflow = convertScalar(JsonValue::fromNumber(1e-46), d);
+  REQUIRE(underflow.ok());
+  CHECK(isPositiveZero(underflow.value));
+  CHECK(convertScalar(JsonValue::fromNumber(-1e-46), d).error
+      == ValueError::OUT_OF_DOMAIN);
+
+  for (auto k : {JsonKind::BOOLEAN,
+           JsonKind::STRING,
+           JsonKind::NULL_VALUE,
+           JsonKind::ARRAY,
+           JsonKind::OBJECT,
+           JsonKind::MALFORMED}) {
+    CHECK(convertScalar(JsonValue::ofKind(k), d).error
+        == ValueError::INCOMPATIBLE_TYPE);
+  }
+  const double inf = std::numeric_limits<double>::infinity();
+  for (double nf : {inf, -inf, std::numeric_limits<double>::quiet_NaN()})
+    CHECK(convertScalar(JsonValue::fromNumber(nf), d).error
+        == ValueError::NON_FINITE);
+}
+
+struct Fixture
+{
+  vsr::scene::Scene scene;
+  vsr::scene::MaterialRef matte;
+  vsr::scene::MaterialRef pbr;
+  vsr::scene::LightRef directional;
+  vsr::scene::LightRef point;
+
+  Fixture()
+  {
+    matte = scene.createObject<vsr::scene::Material>(tokens::material::matte);
+    pbr = scene.createObject<vsr::scene::Material>(
+        tokens::material::physicallyBased);
+    directional =
+        scene.createObject<vsr::scene::Light>(tokens::light::directional);
+    point = scene.createObject<vsr::scene::Light>(tokens::light::point);
+  }
+};
+
+} // namespace
+
+SCENARIO(
+    "Numeric conversion is validated in binary64 then rounded to "
+    "binary32",
+    "[integration]")
+{
+  GIVEN("every editable field's domain")
+  {
+    for (auto f : {EditableField::MATTE_COLOR,
+             EditableField::MATTE_OPACITY,
+             EditableField::DIRECTIONAL_COLOR,
+             EditableField::DIRECTIONAL_IRRADIANCE,
+             EditableField::DIRECTIONAL_DIRECTION}) {
+      checkCommonScalarRules(domainOf(f));
+    }
+  }
+
+  GIVEN("the unit-interval domains")
+  {
+    const Domain unit = domainOf(EditableField::MATTE_OPACITY);
+    THEN("opacity 1.0000000000000002 rejects instead of rounding to 1")
+    {
+      CHECK(convertScalar(JsonValue::fromNumber(1.0000000000000002), unit).error
+          == ValueError::OUT_OF_DOMAIN);
+    }
+    THEN("the double-rounding fixture rejects above 1 for color")
+    {
+      CHECK(convertScalar(JsonValue::fromNumber(1.00000005960464477539), unit)
+                .error
+          == ValueError::OUT_OF_DOMAIN);
+    }
+  }
+
+  GIVEN("the irradiance domain")
+  {
+    const Domain irr = domainOf(EditableField::DIRECTIONAL_IRRADIANCE);
+    THEN("1e39 rejects")
+    {
+      CHECK(convertScalar(JsonValue::fromNumber(1e39), irr).error
+          == ValueError::OUT_OF_DOMAIN);
+    }
+    THEN("the largest binary32 accepts, and anything above it rejects")
+    {
+      CHECK(convertScalar(JsonValue::fromNumber(FLT_MAX_D), irr).value
+          == std::numeric_limits<float>::max());
+      // Would round to FLT_MAX, but validation precedes rounding.
+      CHECK(convertScalar(
+                JsonValue::fromNumber(std::nextafter(FLT_MAX_D, 1e300)), irr)
+                .error
+          == ValueError::OUT_OF_DOMAIN);
+    }
+    THEN("integer-looking values accept")
+    {
+      CHECK(convertScalar(JsonValue::fromNumber(5.0), irr).value == 5.f);
+    }
+    THEN("the double-rounding fixture stores exactly 1.0")
+    {
+      // 1 + 2^-24 + 2^-80: binary64 parse gives 1 + 2^-24, a binary32 tie.
+      const double parsed =
+          1.00000005960464477539062582718061255302767487140869206996285356581211090087890625;
+      REQUIRE(parsed == 1.0 + std::ldexp(1.0, -24));
+      auto r = convertScalar(JsonValue::fromNumber(parsed), irr);
+      REQUIRE(r.ok());
+      CHECK(bitsOf(r.value) == bitsOf(1.f));
+    }
+  }
+}
+
+SCENARIO("Binary32 rounding is ties-to-even regardless of ambient mode",
+    "[integration]")
+{
+  const double tieDown = 1.0 + std::ldexp(1.0, -24); // even neighbor is 1
+  const double tieUp = 1.0 + 3 * std::ldexp(1.0, -24); // even is 1 + 2^-22
+  const double subTie = 1.5 * std::ldexp(1.0, -149); // even is 2^-148
+  const double halfMin = std::ldexp(1.0, -150); // even is +0
+  const double aboveHalfMin = std::nextafter(halfMin, 1.0);
+
+  auto check = [&]() {
+    CHECK(roundToBinary32(tieDown) == 1.f);
+    CHECK(roundToBinary32(-tieDown) == -1.f);
+    CHECK(double(roundToBinary32(tieUp)) == 1.0 + std::ldexp(1.0, -22));
+    CHECK(double(roundToBinary32(subTie)) == std::ldexp(1.0, -148));
+    CHECK(isPositiveZero(roundToBinary32(halfMin)));
+    CHECK(double(roundToBinary32(aboveHalfMin)) == std::ldexp(1.0, -149));
+    CHECK(double(roundToBinary32(std::ldexp(1.0, -149)))
+        == std::ldexp(1.0, -149));
+    CHECK(roundToBinary32(0.1) == 0.1f);
+    CHECK(isPositiveZero(roundToBinary32(-0.0)));
+    CHECK(isPositiveZero(roundToBinary32(std::ldexp(1.0, -1074))));
+    // Rounding up across a binade and into the smallest normal.
+    CHECK(double(roundToBinary32(std::nextafter(2.0, 0.0))) == 2.0);
+    CHECK(double(roundToBinary32(std::nextafter(0x1p-126, 0.0))) == 0x1p-126);
+  };
+
+  check();
+  for (int mode : {FE_UPWARD, FE_DOWNWARD, FE_TOWARDZERO}) {
+    const int saved = std::fegetround();
+    REQUIRE(std::fesetround(mode) == 0);
+    check();
+    std::fesetround(saved);
+  }
+}
