     }
     REQUIRE(v.get("result"));
     REQUIRE(s.authority->hasSession());
 
     // Signal path: the wake fd ends the loop and detaches.
     const char c = 0;
     REQUIRE(::write(h.wake.w, &c, 1) == 1);
     h.thread.join();
     REQUIRE(h.exitCode == 0);
     REQUIRE(!s.authority->hasSession());
