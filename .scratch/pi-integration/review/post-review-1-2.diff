 inline std::optional<SceneId> OperationEngine::sceneFor(Target target) const
 {
   if (target.kind == Target::Kind::SCENE) {
     if (m_integration.isRegisteredScene(target.id))
       return target.id;
     return std::nullopt;
   }
   return m_integration.sceneOfView(target.id);
 }
 
