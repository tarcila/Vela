+    THEN("the restore commits and unrelated state is preserved")
+    {
+      REQUIRE(r.outcome == Outcome::OK);
+      REQUIRE(fx.opacity(fx.matte) == 1.f);
+      REQUIRE(fx.irradiance() == 1.f);
+      REQUIRE(fx.opacity(fx.other) == 0.3f);
