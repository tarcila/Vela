+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/Integration.hpp"
+#include "vsr/integration/activity/Activity.hpp"
+#include "vsr/scene/Scene.hpp"
+// std
+#include <functional>
+#include <memory>
+#include <string>
+
+using namespace vsr::integration;
+using namespace vsr::integration::activity;
+using session::Attachment;
+using session::Code;
+
+namespace {
+
+bool confirmReady(SceneId)
+{
+  return true;
+}
+
+struct Fixture
+{
+  vsr::scene::Scene scene;
+  Integration integration;
+  SceneId sceneId{INVALID_SCENE_ID};
+  ViewId viewId{INVALID_VIEW_ID};
+  double now{1000.0};
+  std::unique_ptr<session::SessionAuthority> authority;
+  Credentials creds;
+
+  Fixture()
+  {
+    SceneRegistration s;
+    s.name = "scene";
+    s.scene = &scene;
+    s.grants.read = true;
+    s.grants.edit = true;
+    s.normalSyncHook = confirmReady;
+    sceneId = *integration.registerScene(s);
+    ViewRegistration v;
+    v.name = "view";
+    v.scene = sceneId;
+    v.grants.read = true;
+    v.grants.render = true;
+    viewId = *integration.registerView(v);
+    REQUIRE(integration.activate().ok());
+    authority =
+        session::SessionAuthority::create(integration, [this] { return now; });
+    REQUIRE(authority);
+    attach();
+  }
+
+  void attach()
+  {
+    Attachment a = authority->attach(authority->launchCredential());
+    REQUIRE(a.code == Code::OK);
+    creds = {authority->launchCredential(), a.sessionId, a.sessionSecret};
+  }
+
+  void reattach()
+  {
+    REQUIRE(authority->detach(creds) == Code::OK);
+    attach();
+  }
+
+  Entry edit(std::uint64_t id, std::string batch, std::size_t payload = 64)
+  {
+    Entry e;
+    e.ref = OperationRef{creds.sessionId, id};
+    e.kind = OperationKind::EDIT;
+    e.targets = coveredTargets(e.kind, Target::scene(sceneId), integration);
+    e.terminal = Outcome::OK;
+    e.committed = true;
+    e.batchRef = BatchRef{authority->launchId(), batch};
+    e.result = "{\"material\":\"red\"}";
+    e.restorationBytes = payload;
+    e.eligibility = Eligibility::ELIGIBLE;
+    return e;
+  }
+
+  Entry render(std::uint64_t id, std::size_t imageBytes)
+  {
+    Entry e;
+    e.ref = OperationRef{creds.sessionId, id};
+    e.kind = OperationKind::RENDER;
+    e.targets = coveredTargets(e.kind, Target::view(viewId), integration);
+    e.terminal = Outcome::OK;
+    e.image.assign(imageBytes, 0x7f);
+    return e;
+  }
+};
+
+std::string hex(std::size_t i)
+{
+  std::string s(32, '0');
+  auto t = std::to_string(i);
+  s.replace(32 - t.size(), t.size(), t);
+  return s;
+}
+
+} // namespace
+
+SCENARIO("Default activity budgets match the spec", "[integration]")
+{
+  Limits l;
+  REQUIRE(l.bytes == 16u * 1024 * 1024);
+  REQUIRE(l.entries == 1024);
+  REQUIRE(l.restorableBatches == 32);
+  REQUIRE(l.imageBytes == 32u * 1024 * 1024);
+
+  Fixture f;
+  ActivityLog log;
+  for (std::size_t i = 1; i <= 1100; ++i)
+    REQUIRE(log.append(f.edit(i, hex(i), 8)));
+  auto u = log.usage();
+  REQUIRE(u.entries == 1024);
+  REQUIRE(u.restorableBatches == 32);
+  // Oldest records gone, newest retained.
+  REQUIRE_FALSE(log.eligibility({f.authority->launchId(), hex(1)}));
+  REQUIRE(log.eligibility({f.authority->launchId(), hex(1100)})
+      == Eligibility::ELIGIBLE);
+  // Batches beyond the newest 32 visibly expired while metadata remains.
+  REQUIRE(log.eligibility({f.authority->launchId(), hex(1100 - 32)})
+      == Eligibility::EXPIRED);
+}
+
+SCENARIO("Smaller limits: payload bytes count and oldest safe evicts first",
+    "[integration]")
+{
+  Fixture f;
+  Limits l;
+  l.entries = 100;
+  l.restorableBatches = 2;
+  l.bytes = 4 * (ENTRY_OVERHEAD + 512);
+  ActivityLog log(l);
+  const std::string launch = f.authority->launchId();
+
+  auto a = log.append(f.edit(1, hex(1), 400));
+  REQUIRE(a);
+  REQUIRE(log.usage().bytes >= 400);
+  REQUIRE(log.append(f.edit(2, hex(2), 400)));
+  // A third restorable batch expires the oldest one, releasing its payload.
+  const auto before = log.usage().bytes;
+  REQUIRE(log.append(f.edit(3, hex(3), 400)));
+  REQUIRE(log.eligibility({launch, hex(1)}) == Eligibility::EXPIRED);
+  REQUIRE(log.get(*a)->restorationBytes == 0);
+  REQUIRE(log.usage().restorableBatches == 2);
+  REQUIRE(log.usage().bytes < before + ActivityLog::cost(f.edit(3, hex(3), 400)));
+
+  // A large payload forces byte eviction of the oldest records.
+  Entry big = f.edit(4, hex(4), 1500);
+  big.eligibility = Eligibility::NONE;
+  REQUIRE(log.append(big));
+  REQUIRE(log.usage().bytes <= l.bytes);
+  REQUIRE_FALSE(log.eligibility({launch, hex(1)}));
+}
+
+SCENARIO("Active work is never evicted", "[integration]")
+{
+  Fixture f;
+  Limits l;
+  l.entries = 2;
+  l.restorableBatches = 1;
+  ActivityLog log(l);
+  Entry active = f.edit(1, hex(1));
+  active.active = true;
+  active.terminal.reset();
+  active.progress = Progress::RUNNING;
+  auto a = log.append(active);
+  REQUIRE(a);
+  // The only restorable batch is active: no room for another.
+  REQUIRE_FALSE(log.append(f.edit(2, hex(2))));
+  Entry plain = f.render(3, 0);
+  REQUIRE(log.append(plain));
+  REQUIRE(log.append(f.render(4, 0))); // evicts 3, not the active one
+  REQUIRE(log.get(*a));
+  Entry more = f.render(5, 0);
+  more.active = true;
+  REQUIRE(log.append(more)); // evicts 4
+  REQUIRE_FALSE(log.append(f.render(6, 0))); // both remaining are active
+  REQUIRE(log.usage().entries == 2);
+}
+
+SCENARIO("Retained images use their own budget", "[integration]")
+{
+  Fixture f;
+  Limits l;
+  l.imageBytes = 1000;
+  ActivityLog log(l);
+  auto a = log.append(f.render(1, 600));
+  auto bytesBefore = log.usage().bytes;
+  REQUIRE(log.usage().imageBytes == 600);
+  REQUIRE(bytesBefore == ActivityLog::cost(f.render(1, 0)));
+  auto b = log.append(f.render(2, 600));
+  REQUIRE(log.usage().imageBytes == 600);
+  REQUIRE(log.get(*a)->imageEvicted);
+  REQUIRE(log.get(*a)->image.empty());
+  REQUIRE(log.get(*b)->image.size() == 600);
+}
+
+SCENARIO("Restoration consumes eligibility and releases payload",
+    "[integration]")
+{
+  Fixture f;
+  ActivityLog log;
+  auto id = log.append(f.edit(1, hex(1), 1000));
+  REQUIRE(log.markRestored({f.authority->launchId(), hex(1)}));
+  REQUIRE(log.eligibility({f.authority->launchId(), hex(1)})
+      == Eligibility::RESTORED);
+  REQUIRE(log.get(*id)->restorationBytes == 0);
+  REQUIRE(log.usage().restorableBatches == 0);
+  REQUIRE_FALSE(log.markRestored({f.authority->launchId(), hex(1)}));
+  REQUIRE_FALSE(log.eligibility({"otherlaunch", hex(1)}));
+}
+
+SCENARIO("Owner receipts are minimal; payload needs read", "[integration]")
+{
+  Fixture f;
+  ActivityLog log;
+  Entry e = f.edit(1, hex(1));
+  e.clientSummary = ClientSummary{"make it red"};
+  log.append(e);
+
+  auto full = log.lookup(*f.authority, f.creds, {f.creds.sessionId, 1});
+  REQUIRE(full.code == Outcome::OK);
+  REQUIRE(full.record);
+  REQUIRE(full.record->batchRef);
+  REQUIRE(full.record->clientSummary->text == "make it red");
+  REQUIRE_FALSE(full.record->kind != OperationKind::EDIT);
+
+  f.authority->restrict(Target::scene(f.sceneId), Capability::READ);
+  auto minimal = log.lookup(*f.authority, f.creds, {f.creds.sessionId, 1});
+  REQUIRE(minimal.code == Outcome::OK);
+  REQUIRE_FALSE(minimal.record);
+  REQUIRE(minimal.receipt);
+  REQUIRE(minimal.receipt->ref.requestId == 1);
+  REQUIRE(minimal.receipt->kind == OperationKind::EDIT);
+  REQUIRE(minimal.receipt->committed);
+  REQUIRE(minimal.receipt->terminal == Outcome::OK);
+
+  // Wrong proof: no receipt at all.
+  auto bad = f.creds;
+  bad.sessionProof = "x";
+  REQUIRE(log.lookup(*f.authority, bad, {f.creds.sessionId, 1}).code
+      == Outcome::INVALID_SESSION_PROOF);
+}
+
+SCENARIO("New session looks up an older session's record", "[integration]")
+{
+  Fixture f;
+  ActivityLog log;
+  const std::string oldSession = f.creds.sessionId;
+  log.append(f.edit(1, hex(1)));
+  log.append(f.render(2, 100));
+
+  // Records survive client disconnect.
+  f.reattach();
+  REQUIRE(f.creds.sessionId != oldSession);
+
+  auto e = log.lookup(*f.authority, f.creds, {oldSession, 1});
+  REQUIRE(e.code == Outcome::OK);
+  REQUIRE(e.record);
+  REQUIRE_FALSE(e.receipt); // not the caller's own work
+  REQUIRE(e.record->kind == OperationKind::EDIT);
+  REQUIRE(e.record->ref->sessionId == oldSession);
+
+  // Render covers view + scene: read on the view alone is denied whole.
+  REQUIRE(log.lookup(*f.authority, f.creds, {oldSession, 2}).record);
+  f.authority->restrict(Target::scene(f.sceneId), Capability::READ);
+  auto partial = log.lookup(*f.authority, f.creds, {oldSession, 2});
+  REQUIRE(partial.code == Outcome::FORBIDDEN);
+  REQUIRE_FALSE(partial.record);
+  REQUIRE_FALSE(partial.receipt);
+  // Own-work minimal receipts do not extend to foreign sessions.
+  REQUIRE(log.lookup(*f.authority, f.creds, {oldSession, 1}).code
+      == Outcome::FORBIDDEN);
+
+  // Missing record: outcome_unavailable.
+  REQUIRE(log.lookup(*f.authority, f.creds, {oldSession, 99}).code
+      == Outcome::OUTCOME_UNAVAILABLE);
+}
+
+SCENARIO("Evicted records report outcome_unavailable", "[integration]")
+{
+  Fixture f;
+  Limits l;
+  l.entries = 1;
+  ActivityLog log(l);
+  log.append(f.render(1, 0));
+  log.append(f.render(2, 0));
+  REQUIRE(log.lookup(*f.authority, f.creds, {f.creds.sessionId, 1}).code
+      == Outcome::OUTCOME_UNAVAILABLE);
+  REQUIRE(log.lookup(*f.authority, f.creds, {f.creds.sessionId, 2}).code
+      == Outcome::OK);
+}
+
+SCENARIO("Records do not survive restart", "[integration]")
+{
+  Fixture f;
+  {
+    ActivityLog log;
+    log.append(f.render(1, 0));
+  }
+  ActivityLog restarted;
+  REQUIRE(restarted.lookup(*f.authority, f.creds, {f.creds.sessionId, 1}).code
+      == Outcome::OUTCOME_UNAVAILABLE);
+}
+
+SCENARIO("Covered targets are fixed per operation kind", "[integration]")
+{
+  Fixture f;
+  auto s = Target::scene(f.sceneId);
+  for (auto k : {OperationKind::INSPECTION,
+           OperationKind::EDIT,
+           OperationKind::RESTORE,
+           OperationKind::RESYNCHRONIZE})
+    REQUIRE(coveredTargets(k, s, f.integration).size() == 1);
+  auto r = coveredTargets(
+      OperationKind::RENDER, Target::view(f.viewId), f.integration);
+  REQUIRE(r.size() == 2);
+  REQUIRE(r[1].kind == Target::Kind::SCENE);
+  auto d = coveredTargets(
+      OperationKind::DISCOVERY, s, f.integration, {s, Target::view(f.viewId)});
+  REQUIRE(d.size() == 2);
+}
+
+SCENARIO("Operation status: cross-session lookup needs read on the record",
+    "[integration]")
+{
+  Fixture f;
+  auto engine = operations::OperationEngine::create(
+      f.integration, *f.authority, {}, [&f] { return f.now; });
+  REQUIRE(engine);
+  auto req = [&](Target t, Capability c) {
+    operations::Request r;
+    r.kind = "test";
+    r.target = t;
+    r.capability = c;
+    r.canonicalArguments = "{}";
+    r.executor = [](operations::StepContext &) {
+      operations::Step s;
+      s.result = "payload";
+      return s;
+    };
+    return r;
+  };
+  const std::string old = f.creds.sessionId;
+  REQUIRE(engine->submit(f.creds, {old, 1},
+                    req(Target::scene(f.sceneId), Capability::READ))
+              .code
+      == Outcome::OK);
+  REQUIRE(engine->submit(f.creds, {old, 2},
+                    req(Target::view(f.viewId), Capability::RENDER))
+              .code
+      == Outcome::OK);
+  f.integration.service();
+  f.reattach();
+
+  auto s = engine->status(f.creds, {old, 1});
+  REQUIRE(s.code == Outcome::OK);
+  REQUIRE(s.kind == "test");
+  REQUIRE(s.result == "payload");
+  REQUIRE(engine->status(f.creds, {old, 2}).result == "payload");
+
+  f.authority->restrict(Target::scene(f.sceneId), Capability::READ);
+  REQUIRE(engine->status(f.creds, {old, 1}).code == Outcome::FORBIDDEN);
+  // Render record covers view and scene: partial read is denied whole.
+  auto p = engine->status(f.creds, {old, 2});
+  REQUIRE(p.code == Outcome::FORBIDDEN);
+  REQUIRE(p.result.empty());
+  REQUIRE(engine->status(f.creds, {old, 9}).code
+      == Outcome::OUTCOME_UNAVAILABLE);
+}
+
+namespace {
+
+struct EngineFixture : Fixture
+{
+  std::unique_ptr<operations::OperationEngine> engine;
+  std::unique_ptr<ActivityLog> log;
+  std::unique_ptr<EngineActivitySink> sink;
+  std::vector<std::function<void()>> wakes;
+
+  explicit EngineFixture(Limits limits)
+  {
+    engine = operations::OperationEngine::create(
+        integration, *authority, {}, [this] { return now; });
+    REQUIRE(engine);
+    log = std::make_unique<ActivityLog>(limits);
+    sink = std::make_unique<EngineActivitySink>(*log, integration);
+    engine->setActivitySink(sink.get());
+  }
+
+  ~EngineFixture()
+  {
+    engine->setActivitySink(nullptr);
+  }
+
+  operations::Request request(std::function<operations::Step(int)> script)
+  {
+    auto runs = std::make_shared<int>(0);
+    operations::Request r;
+    r.kind = "inspection";
+    r.target = Target::scene(sceneId);
+    r.capability = Capability::READ;
+    r.canonicalArguments = "{}";
+    r.executor = [script, runs](operations::StepContext &) {
+      return script(++*runs);
+    };
+    return r;
+  }
+
+  // Holds backend resources until abandoned and woken.
+  operations::Request pending()
+  {
+    operations::Request r = request(nullptr);
+    r.executor = [this](operations::StepContext &ctx) {
+      operations::Step s;
+      if (!ctx.abandoned) {
+        s.status = operations::Step::Status::BACKEND_PENDING;
+        wakes.push_back(ctx.wake);
+      }
+      return s;
+    };
+    return r;
+  }
+};
+
+} // namespace
+
+SCENARIO("Engine admission rejects busy when the activity log is full of "
+         "active work",
+    "[integration]")
+{
+  Limits l;
+  l.entries = 2;
+  EngineFixture f(l);
+  REQUIRE(f.engine->submit(f.creds, {f.creds.sessionId, 1}, f.pending())
+              .code
+      == Outcome::OK);
+  REQUIRE(f.engine->submit(f.creds, {f.creds.sessionId, 2}, f.pending())
+              .code
+      == Outcome::OK);
+  f.integration.service();
+  REQUIRE(f.log->usage().entries == 2);
+
+  // Both entries are active: nothing may be evicted, nothing admitted.
+  REQUIRE(f.engine->submit(f.creds, {f.creds.sessionId, 3}, f.pending())
+              .code
+      == Outcome::BUSY);
+  REQUIRE(f.engine->submitLocal(f.pending()).code == Outcome::BUSY);
+  REQUIRE(f.engine->slotsInUse() == 2);
+  REQUIRE(f.engine->status(f.creds, {f.creds.sessionId, 3}).code
+      == Outcome::UNKNOWN);
+
+  // Cancelling backend-pending work keeps it active (awaiting_cleanup).
+  f.engine->cancel(f.creds, {f.creds.sessionId, 1});
+  REQUIRE(f.log->get(1)->active);
+  REQUIRE(f.log->get(1)->progress == Progress::AWAITING_CLEANUP);
+  REQUIRE(f.engine->submitLocal(f.pending()).code == Outcome::BUSY);
+
+  // Once cleaned up, the oldest terminal entry is evicted first.
+  f.engine->cancel(f.creds, {f.creds.sessionId, 2});
+  for (auto &w : f.wakes)
+    w();
+  f.integration.service(); // abandoned steps release resources
+  REQUIRE(f.engine->slotsInUse() == 0);
+  REQUIRE_FALSE(f.log->get(1)->active);
+  REQUIRE_FALSE(f.log->get(2)->active);
+  auto local = f.engine->submitLocal(f.request([](int) {
+    return operations::Step{};
+  }));
+  REQUIRE(local.code == Outcome::OK);
+  REQUIRE_FALSE(f.log->get(1));
+  REQUIRE(f.log->get(2));
+  auto e3 = f.log->get(3);
+  REQUIRE(e3);
+  REQUIRE(e3->localRef);
+  REQUIRE(e3->localRef->id == local.ref.id);
+  REQUIRE_FALSE(e3->ref);
+}
+
+SCENARIO("Engine activity entries mirror operation status", "[integration]")
+{
+  EngineFixture f(Limits{});
+  const OperationRef ref{f.creds.sessionId, 7};
+  auto a = f.engine->submit(f.creds, ref, f.request([](int run) {
+    operations::Step s;
+    if (run == 1) {
+      s.status = operations::Step::Status::YIELD;
+    } else {
+      s.committed = true;
+      s.result = "{\"answer\":42}";
+    }
+    return s;
+  }));
+  REQUIRE(a.code == Outcome::OK);
+  f.now += 1.0;
+
+  auto check = [&] {
+    auto s = f.engine->status(f.creds, ref);
+    auto e = f.log->get(1);
+    REQUIRE(e);
+    REQUIRE(e->ref);
+    REQUIRE(e->ref->requestId == 7);
+    REQUIRE(e->kind == OperationKind::INSPECTION);
+    REQUIRE(e->targets.size() == 1);
+    REQUIRE(e->progress == s.progress);
+    REQUIRE(e->terminal == s.terminal);
+    REQUIRE(e->committed == s.committed);
+    REQUIRE(e->heldSlots == s.heldSlots);
+    REQUIRE(e->admittedAt == 1000.0);
+    REQUIRE_FALSE(e->clientSummary);
+    return *e;
+  };
+  REQUIRE(check().progress == Progress::QUEUED);
+  REQUIRE(check().active);
+
+  f.integration.service();
+  REQUIRE(check().progress == Progress::YIELDED);
+  f.integration.service();
+  auto done = check();
+  REQUIRE(done.terminal == Outcome::OK);
+  REQUIRE(done.committed);
+  REQUIRE(done.result == "{\"answer\":42}");
+  REQUIRE(done.finishedAt == 1001.0);
+  REQUIRE_FALSE(done.active);
+
+  auto lookup = f.log->lookup(*f.authority, f.creds, ref);
+  REQUIRE(lookup.code == Outcome::OK);
+  REQUIRE(lookup.receipt);
+  REQUIRE(lookup.receipt->terminal == Outcome::OK);
+}
+
+SCENARIO("Snapshot enumerates retained entries oldest first", "[integration]")
+{
+  Fixture f;
+  Limits l;
+  l.entries = 4;
+  ActivityLog log(l);
+  REQUIRE(log.snapshot().empty());
+
+  std::vector<ActivityLog::Id> ids;
+  for (std::size_t i = 1; i <= 10; ++i)
+    ids.push_back(*log.append(f.render(i, 0)));
+
+  auto records = log.snapshot();
+  REQUIRE(records.size() == 4);
+  for (std::size_t i = 0; i < records.size(); ++i) {
+    REQUIRE(records[i].id == ids[6 + i]);
+    REQUIRE(records[i].entry.ref->requestId == 7 + i);
+  }
+
+  // Updates are reflected in place without reordering.
+  Entry e = records[1].entry;
+  e.result = "updated";
+  REQUIRE(log.update(records[1].id, e));
+  records = log.snapshot();
+  REQUIRE(records[1].id == ids[7]);
+  REQUIRE(records[1].entry.result == "updated");
+}
+
+SCENARIO("Discovery entries cover exactly the targets their page lists",
+    "[integration]")
+{
+  EngineFixture f(Limits{});
+  const OperationRef ref{f.creds.sessionId, 1};
+  operations::Request r = f.request([&](int) {
+    operations::Step s;
+    s.result = "{\"returned\":1}";
+    s.covered = {Target::view(f.viewId)};
+    return s;
+  });
+  r.kind = "discovery";
+  r.sessionWide = true;
+  REQUIRE(f.engine->submit(f.creds, ref, r).code == Outcome::OK);
+
+  auto pending = f.log->get(1);
+  REQUIRE(pending);
+  REQUIRE(pending->kind == OperationKind::DISCOVERY);
+  REQUIRE(pending->targets.empty());
+
+  f.integration.service();
+  auto done = f.log->get(1);
+  REQUIRE(done);
+  REQUIRE(done->terminal == Outcome::OK);
+  REQUIRE(done->targets.size() == 1);
+  REQUIRE(done->targets[0].kind == Target::Kind::VIEW);
+  REQUIRE(done->targets[0].id == f.viewId);
+
+  // A later session without read on the unlisted scene still sees the
+  // record: only the listed view is checked.
+  f.reattach();
+  f.authority->restrict(Target::scene(f.sceneId), Capability::READ);
+  auto lookup = f.log->lookup(*f.authority, f.creds, ref);
+  REQUIRE(lookup.code == Outcome::OK);
+  REQUIRE(lookup.record);
+  REQUIRE(lookup.record->result == "{\"returned\":1}");
+  REQUIRE_FALSE(lookup.receipt);
+
+  // Losing read on the listed view denies the whole record.
+  f.authority->restrict(Target::view(f.viewId), Capability::READ);
+  REQUIRE(f.log->lookup(*f.authority, f.creds, ref).code == Outcome::FORBIDDEN);
+}
diff --git a/src/tests/integration/test_IntegrationContext.cpp b/src/tests/integration/test_IntegrationContext.cpp
new file mode 100644
index 0000000000..800b896412
--- /dev/null
+++ b/src/tests/integration/test_IntegrationContext.cpp
@@ -0,0 +1,225 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/Integration.hpp"
+#include "vsr/integration/context/ContextAdapter.hpp"
+#include "vsr/scene/Scene.hpp"
+// std
+#include <atomic>
+#include <functional>
+#include <csignal>
+#include <thread>
+#include <vector>
+
+using namespace vsr::integration;
+
+namespace {
+
+// Same member shape as vsr::app::Context for the adapter (ctx.vsr.scene);
+// vsrIntegrationTests does not link vsr_app. The real Context is exercised by
+// vsrTutorialIntegrationHeadless.
+struct FakeContext
+{
+  struct
+  {
+    vsr::scene::Scene scene;
+  } vsr;
+};
+
+bool confirmReady(SceneId)
+{
+  return true;
+}
+
+struct Observation
+{
+  std::vector<bool> inService;
+  std::vector<std::thread::id> threads;
+  std::vector<const vsr::scene::Scene *> scenes;
+};
+
+// Drives the same client-side sequence against either host and records
+// where scene access happened.
+Observation drive(Integration &integration,
+    SceneId scene,
+    const std::function<std::size_t()> &safePoint)
+{
+  Observation obs;
+  auto work = [&](vsr::scene::Scene &s) {
+    obs.inService.push_back(integration.inServiceCall());
+    obs.threads.push_back(std::this_thread::get_id());
+    obs.scenes.push_back(&s);
+  };
+  // Submitted from another thread; nothing may touch the scene until the
+  // host reaches its safe point.
+  std::thread client([&] {
+    REQUIRE(integration.submit(scene, work));
+    REQUIRE(integration.submit(scene, work));
+  });
+  client.join();
+  REQUIRE(obs.inService.empty());
+  REQUIRE(safePoint() == 2);
+  return obs;
+}
+
+} // namespace
+
+SCENARIO("Context adapter registers only the Context scene", "[integration]")
+{
+  FakeContext ctx;
+  Integration integration;
+
+  context::ContextSceneOptions options;
+  options.name = "main";
+  options.grants.read = true;
+  auto sceneId = context::registerContextScene(integration, ctx, options);
+  REQUIRE(sceneId);
+
+  THEN("no view and no render grant is inferred from the Context")
+  {
+    REQUIRE(integration.viewsOfScene(*sceneId).empty());
+    REQUIRE(integration.activate().ok());
+    REQUIRE(integration.sceneGrants(*sceneId).read);
+    REQUIRE_FALSE(integration.sceneGrants(*sceneId).edit);
+    REQUIRE(integration.viewsOfScene(*sceneId).empty());
+  }
+
+  THEN("views are registered separately with host-chosen grants")
+  {
+    ViewRegistration v;
+    v.name = "main-view";
+    v.scene = *sceneId;
+    v.grants.read = true;
+    auto viewId = integration.registerView(v);
+    REQUIRE(viewId);
+    REQUIRE(integration.activate().ok());
+    REQUIRE(integration.viewGrants(*viewId).read);
+    REQUIRE_FALSE(integration.viewGrants(*viewId).render);
+  }
+
+  THEN("activation validation is the same as for a custom host")
+  {
+    FakeContext other;
+    Integration strict;
+    context::ContextSceneOptions editing;
+    editing.grants.read = true;
+    editing.grants.edit = true; // no normal-synchronization hook
+    REQUIRE(context::registerContextScene(strict, other, editing));
+    auto result = strict.activate();
+    REQUIRE(result.error == ActivationError::MISSING_SYNC_HOOK);
+  }
+}
+
+SCENARIO("Context host and custom host behave the same", "[integration]")
+{
+  FakeContext ctx;
+  Integration viaContext;
+  context::ContextSceneOptions options;
+  options.grants.read = true;
+  options.grants.edit = true;
+  options.normalSyncHook = confirmReady;
+  auto ctxScene = context::registerContextScene(viaContext, ctx, options);
+  REQUIRE(ctxScene);
+  REQUIRE(viaContext.activate().ok());
+
+  vsr::scene::Scene customScene;
+  Integration custom;
+  SceneRegistration r;
+  r.name = "scene";
+  r.scene = &customScene;
+  r.grants.read = true;
+  r.grants.edit = true;
+  r.normalSyncHook = confirmReady;
+  auto customId = custom.registerScene(r);
+  REQUIRE(customId);
+  REQUIRE(custom.activate().ok());
+
+  THEN("ids and effective grants match")
+  {
+    REQUIRE(*ctxScene == *customId);
+    REQUIRE(viaContext.sceneGrants(*ctxScene).read
+        == custom.sceneGrants(*customId).read);
+    REQUIRE(viaContext.sceneGrants(*ctxScene).edit
+        == custom.sceneGrants(*customId).edit);
+    REQUIRE(viaContext.sceneGrants(*ctxScene).resynchronize
+        == custom.sceneGrants(*customId).resynchronize);
+    REQUIRE(static_cast<bool>(viaContext.normalSyncHook(*ctxScene)));
+  }
+
+  THEN("work runs only at the safe point, on the servicing thread")
+  {
+    context::ViewerExecutionHook hook(viaContext);
+    auto a = drive(viaContext, *ctxScene, [&] { return hook(); });
+    auto b = drive(custom, *customId, [&] { return custom.service(); });
+
+    REQUIRE(a.inService == std::vector<bool>{true, true});
+    REQUIRE(a.inService == b.inService);
+    for (auto id : a.threads)
+      REQUIRE(id == std::this_thread::get_id());
+    for (auto *s : a.scenes)
+      REQUIRE(s == &ctx.vsr.scene);
+    for (auto *s : b.scenes)
+      REQUIRE(s == &customScene);
+  }
+}
+
+SCENARIO("Viewer execution hook is inert while inactive", "[integration]")
+{
+  FakeContext ctx;
+  Integration integration;
+  context::ContextSceneOptions options;
+  options.grants.read = true;
+  auto sceneId = context::registerContextScene(integration, ctx, options);
+  REQUIRE(sceneId);
+
+  context::ViewerExecutionHook hook(integration);
+  REQUIRE(hook() == 0);
+  REQUIRE_FALSE(integration.submit(*sceneId, [](vsr::scene::Scene &) {}));
+}
+
+SCENARIO("Headless service loop runs work and stops", "[integration]")
+{
+  FakeContext ctx;
+  Integration integration;
+  context::ContextSceneOptions options;
+  options.grants.read = true;
+  auto sceneId = context::registerContextScene(integration, ctx, options);
+  REQUIRE(sceneId);
+  REQUIRE(integration.activate().ok());
+
+  WHEN("stopped through the loop")
+  {
+    context::HeadlessServiceLoop loop(integration);
+    std::atomic<bool> ranInService{false};
+    std::thread::id workThread;
+    std::thread host([&] { loop.run(); });
+
+    REQUIRE(integration.submit(*sceneId, [&](vsr::scene::Scene &) {
+      workThread = std::this_thread::get_id();
+      ranInService = integration.inServiceCall();
+      loop.stop();
+    }));
+    auto hostId = host.get_id();
+    host.join();
+    REQUIRE(ranInService);
+    REQUIRE(workThread == hostId);
+  }
+
+  WHEN("stopped through a signal-style flag")
+  {
+    volatile std::sig_atomic_t stopFlag = 0;
+    context::HeadlessServiceLoop loop(
+        integration, &stopFlag, std::chrono::milliseconds(1));
+    std::atomic<int> ran{0};
+    std::thread host([&] { loop.run(); });
+    REQUIRE(integration.submit(*sceneId, [&](vsr::scene::Scene &) { ran++; }));
+    while (ran.load() == 0)
+      std::this_thread::yield();
+    stopFlag = 1;
+    host.join();
+    REQUIRE(ran == 1);
+  }
+}
diff --git a/src/tests/integration/test_IntegrationDescriptor.cpp b/src/tests/integration/test_IntegrationDescriptor.cpp
new file mode 100644
index 0000000000..28416df35b
--- /dev/null
+++ b/src/tests/integration/test_IntegrationDescriptor.cpp
@@ -0,0 +1,673 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+// catch
+#include "catch.hpp"
+// vsr
+#include "vsr/integration/descriptor/LaunchDescriptor.hpp"
+// std
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <vector>
+// posix
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/xattr.h>
+#include <unistd.h>
+
+namespace desc = vsr::integration::descriptor;
+using desc::Code;
+
+namespace {
+
+const char *kId = "0123456789abcdef0123456789abcdef";
+const char *kId2 = "fedcba9876543210fedcba9876543210";
+// 43 chars; last char 'A' leaves the 2 padding bits zero.
+const char *kCred = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN-_A";
+
+desc::Descriptor sample(const char *id = kId)
+{
+  desc::Descriptor d;
+  d.launchId = id;
+  d.host = "127.0.0.1";
+  d.port = 8765;
+  d.launchCredential = kCred;
+  return d;
+}
+
+std::string json(const std::string &body)
+{
+  return "{" + body + "}";
+}
+
+const std::string kFields = std::string("\"schema_version\":1,\"launch_id\":\"")
+    + kId + "\",\"scheme\":\"http\",\"host\":\"127.0.0.1\",\"port\":8765,"
+    + "\"path\":\"/mcp\",\"launch_credential\":\"" + kCred + "\"";
+
+Code parseCode(const std::string &s)
+{
+  desc::Descriptor d;
+  return desc::parse(s, d).code;
+}
+
+std::string replaceOnce(
+    std::string s, const std::string &from, const std::string &to)
+{
+  const auto p = s.find(from);
+  REQUIRE(p != std::string::npos);
+  s.replace(p, from.size(), to);
+  return s;
+}
+
+struct TempDir
+{
+  std::string path;
+  TempDir()
+  {
+    char tmpl[] = "/tmp/vsr-desc-test-XXXXXX";
+    REQUIRE(::mkdtemp(tmpl) != nullptr);
+    path = tmpl; // mkdtemp creates 0700
+  }
+  ~TempDir()
+  {
+    std::string cmd =
+        "chmod -R u+rwx '" + path + "' 2>/dev/null; rm -rf '" + path + "'";
+    (void)std::system(cmd.c_str());
+  }
+  std::string sub(const std::string &name, mode_t mode) const
+  {
+    const auto p = path + "/" + name;
+    REQUIRE(::mkdir(p.c_str(), 0700) == 0);
+    REQUIRE(::chmod(p.c_str(), mode) == 0);
+    return p;
+  }
+};
+
+mode_t modeOf(const std::string &p)
+{
+  struct stat st;
+  REQUIRE(::lstat(p.c_str(), &st) == 0);
+  return st.st_mode & 07777;
+}
+
+bool exists(const std::string &p)
+{
+  struct stat st;
+  return ::lstat(p.c_str(), &st) == 0;
+}
+
+std::vector<std::string> entries(const std::string &dir)
+{
+  std::vector<std::string> out;
+  DIR *d = ::opendir(dir.c_str());
+  REQUIRE(d);
+  while (auto *e = ::readdir(d)) {
+    std::string n = e->d_name;
+    if (n != "." && n != "..")
+      out.push_back(n);
+  }
+  ::closedir(d);
+  return out;
+}
+
+void writeFile(const std::string &p, const std::string &content, mode_t mode)
+{
+  int fd = ::open(p.c_str(), O_WRONLY | O_CREAT | O_EXCL, 0600);
+  REQUIRE(fd >= 0);
+  REQUIRE(
+      ::write(fd, content.data(), content.size()) == ssize_t(content.size()));
+  ::close(fd);
+  REQUIRE(::chmod(p.c_str(), mode) == 0);
+}
+
+std::string slurp(const std::string &p)
+{
+  std::string out;
+  int fd = ::open(p.c_str(), O_RDONLY);
+  REQUIRE(fd >= 0);
+  char buf[8192];
+  ssize_t n;
+  while ((n = ::read(fd, buf, sizeof(buf))) > 0)
+    out.append(buf, size_t(n));
+  ::close(fd);
+  return out;
+}
+
+} // namespace
+
+SCENARIO("Descriptor schema is strict v1", "[integration]")
+{
+  GIVEN("the canonical serialization")
+  {
+    const auto s = desc::serialize(sample());
+    REQUIRE(!s.empty());
+    REQUIRE(s.size() <= desc::maxDescriptorBytes);
+    desc::Descriptor d;
+    REQUIRE(desc::parse(s, d).ok());
+    REQUIRE(d.launchId == kId);
+    REQUIRE(d.host == "127.0.0.1");
+    REQUIRE(d.port == 8765);
+    REQUIRE(d.launchCredential == kCred);
+    REQUIRE(s.find("session") == std::string::npos);
+  }
+
+  THEN("whitespace, field order and IPv6 loopback are accepted")
+  {
+    REQUIRE(parseCode(" \n{ " + kFields + " }\n") == Code::ok);
+    auto v6 = replaceOnce(kFields, "\"127.0.0.1\"", "\"::1\"");
+    REQUIRE(parseCode(json(v6)) == Code::ok);
+    auto reordered = replaceOnce(kFields, "\"schema_version\":1,", "")
+        + ",\"schema_version\":1";
+    REQUIRE(parseCode(json(reordered)) == Code::ok);
+    // An escape that decodes to the required value is still that value.
+    REQUIRE(parseCode(json(replaceOnce(kFields, "\"/mcp\"", "\"\\/mcp\"")))
+        == Code::ok);
+  }
+
+  THEN("duplicate, unknown and missing fields are rejected")
+  {
+    REQUIRE(parseCode(json(kFields + ",\"port\":8765"))
+        == Code::invalid_descriptor);
+    REQUIRE(
+        parseCode(json(kFields + ",\"extra\":1")) == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(kFields + ",\"session_id\":\"x\""))
+        == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(replaceOnce(kFields, ",\"path\":\"/mcp\"", "")))
+        == Code::invalid_descriptor);
+    REQUIRE(parseCode("{}") == Code::invalid_descriptor);
+  }
+
+  THEN("wrong types and values are rejected, never coerced")
+  {
+    const std::vector<std::pair<std::string, std::string>> bad = {
+        {"\"schema_version\":1", "\"schema_version\":\"1\""},
+        {"\"schema_version\":1", "\"schema_version\":2"},
+        {"\"schema_version\":1", "\"schema_version\":1.0"},
+        {"\"schema_version\":1", "\"schema_version\":1e0"},
+        {"\"schema_version\":1", "\"schema_version\":01"},
+        {"\"schema_version\":1", "\"schema_version\":true"},
+        {"\"port\":8765", "\"port\":\"8765\""},
+        {"\"port\":8765", "\"port\":0"},
+        {"\"port\":8765", "\"port\":65536"},
+        {"\"port\":8765", "\"port\":-1"},
+        {"\"port\":8765", "\"port\":8765.0"},
+        {"\"port\":8765", "\"port\":99999999999999999999999"},
+        {"\"port\":8765", "\"port\":null"},
+        {"\"scheme\":\"http\"", "\"scheme\":\"https\""},
+        {"\"scheme\":\"http\"", "\"scheme\":\"HTTP\""},
+        {"\"path\":\"/mcp\"", "\"path\":\"/mcp/\""},
+        {"\"host\":\"127.0.0.1\"", "\"host\":\"localhost\""},
+        {"\"host\":\"127.0.0.1\"", "\"host\":\"::ffff:127.0.0.1\""},
+        {"\"host\":\"127.0.0.1\"", "\"host\":\"0:0:0:0:0:0:0:1\""},
+        {"\"host\":\"127.0.0.1\"", "\"host\":\"[::1]\""},
+        {"\"host\":\"127.0.0.1\"", "\"host\":\"0.0.0.0\""},
+        {"\"host\":\"127.0.0.1\"", "\"host\":127"},
+        {std::string("\"launch_id\":\"") + kId + "\"",
+            "\"launch_id\":\"0123456789ABCDEF0123456789abcdef\""},
+        {std::string("\"launch_id\":\"") + kId + "\"",
+            "\"launch_id\":\"0123456789abcdef\""},
+        {kCred, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN-_B"}, // non-canonical
+        {kCred, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN-_A="}, // padded
+        {kCred, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN+/A"}, // std alphabet
+        {kCred, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN-_"}, // short
+    };
+    for (const auto &[from, to] : bad) {
+      INFO(to);
+      REQUIRE(parseCode(json(replaceOnce(kFields, from, to)))
+          == Code::invalid_descriptor);
+    }
+  }
+
+  THEN("malformed JSON and invalid encodings are rejected")
+  {
+    REQUIRE(parseCode("[" + kFields + "]") == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(kFields + ",")) == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(kFields) + "{}") == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(kFields) + std::string(1, '\0'))
+        == Code::invalid_descriptor);
+    REQUIRE(
+        parseCode("\xEF\xBB\xBF" + json(kFields)) == Code::invalid_descriptor);
+    // Invalid UTF-8 inside an otherwise ignorable position.
+    REQUIRE(parseCode(json(kFields) + " \xC0\xAF") == Code::invalid_descriptor);
+    REQUIRE(
+        parseCode(json(kFields + ",\"\xFF\":1")) == Code::invalid_descriptor);
+    // Overlong, surrogate and lone-surrogate escapes.
+    REQUIRE(parseCode(json(replaceOnce(kFields, "\"/mcp\"", "\"/mc\xC1\xB0\"")))
+        == Code::invalid_descriptor);
+    REQUIRE(
+        parseCode(json(replaceOnce(kFields, "\"/mcp\"", "\"\xED\xA0\x80\"")))
+        == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(replaceOnce(kFields, "\"/mcp\"", "\"\\ud800\"")))
+        == Code::invalid_descriptor);
+    REQUIRE(parseCode(json(replaceOnce(kFields, "\"/mcp\"", "\"/m\\qp\"")))
+        == Code::invalid_descriptor);
+    // Raw control character inside a string.
+    REQUIRE(parseCode(json(replaceOnce(kFields, "\"/mcp\"", "\"/m\tcp\"")))
+        == Code::invalid_descriptor);
+  }
+
+  THEN("input above 4 KiB is rejected")
+  {
+    std::string big = json(kFields);
+    big.insert(1, desc::maxDescriptorBytes, ' ');
+    REQUIRE(parseCode(big) == Code::invalid_descriptor);
+  }
+
+  THEN("invalid descriptors are never serialized")
+  {
+    auto d = sample();
+    d.host = "localhost";
+    REQUIRE(desc::serialize(d).empty());
+    d = sample();
+    d.port = 0;
+    REQUIRE(desc::serialize(d).empty());
+  }
+}
+
+SCENARIO("Runtime directories are validated, never repaired", "[integration]")
+{
+  REQUIRE(desc::platformSupported());
+  TempDir tmp;
+
+  THEN("a private 0700 directory owned by the effective user is accepted")
+  {
+    desc::RuntimeDirectory dir;
+    REQUIRE(desc::openDirectory(tmp.path, {}, dir).ok());
+    REQUIRE(dir.valid());
+    REQUIRE(dir.path() == tmp.path);
+  }
+
+  THEN(
+      "group/other access and insufficient owner access are rejected "
+      "without chmod")
+  {
+    for (mode_t m : {0750, 0705, 0770, 0777, 0500, 0300, 01700, 02700}) {
+      INFO(m);
+      const auto p = tmp.sub("d" + std::to_string(m), m);
+      desc::RuntimeDirectory dir;
+      REQUIRE(desc::openDirectory(p, {}, dir).code == Code::unsafe_directory);
+      REQUIRE(modeOf(p) == m);
+    }
+  }
+
+  THEN("a directory owned by another account is rejected")
+  {
+    desc::DirectoryOptions opt;
+    opt.owner = ::geteuid() + 1;
+    desc::RuntimeDirectory dir;
+    REQUIRE(
+        desc::openDirectory(tmp.path, opt, dir).code == Code::unsafe_directory);
+  }
+
+  THEN("a symlinked directory or ancestor is rejected")
+  {
+    const auto real = tmp.sub("real", 0700);
+    const auto link = tmp.path + "/link";
+    REQUIRE(::symlink(real.c_str(), link.c_str()) == 0);
+    desc::RuntimeDirectory dir;
+    REQUIRE(desc::openDirectory(link, {}, dir).code == Code::unsafe_directory);
+    tmp.sub("real/inner", 0700);
+    REQUIRE(desc::openDirectory(link + "/inner", {}, dir).code
+        == Code::unsafe_directory);
+    REQUIRE(desc::openDirectory(real + "/inner", {}, dir).ok());
+  }
+
+  THEN("a non-directory is rejected")
+  {
+    const auto f = tmp.path + "/file";
+    writeFile(f, "x", 0700);
+    desc::RuntimeDirectory dir;
+    REQUIRE(desc::openDirectory(f, {}, dir).code == Code::unsafe_directory);
+  }
+
+  THEN("an ancestor another account could replace is rejected")
+  {
+    const auto shared = tmp.sub("shared", 0777);
+    const auto inner = shared + "/inner";
+    REQUIRE(::mkdir(inner.c_str(), 0700) == 0);
+    desc::RuntimeDirectory dir;
+    REQUIRE(desc::openDirectory(inner, {}, dir).code == Code::unsafe_directory);
+    AND_THEN("a sticky world-writable ancestor, like /tmp, is acceptable")
+    {
+      REQUIRE(::chmod(shared.c_str(), 01777) == 0);
+      REQUIRE(desc::openDirectory(inner, {}, dir).ok());
+    }
+  }
+
+  THEN("relative paths and dot components are rejected")
+  {
+    desc::RuntimeDirectory dir;
+    REQUIRE(desc::openDirectory("relative/dir", {}, dir).code
+        == Code::unsafe_directory);
+    REQUIRE(desc::openDirectory(tmp.path + "/../x", {}, dir).code
+        == Code::unsafe_directory);
+    REQUIRE(desc::openDirectory("/", {}, dir).code == Code::unsafe_directory);
+  }
+
+  THEN("a named-user ACL entry on the directory is rejected")
+  {
+    const auto p = tmp.sub("acl", 0700);
+    // system.posix_acl_access v2: USER_OBJ rwx, USER(uid) r, GROUP_OBJ ---,
+    // MASK r, OTHER ---.
+    auto le16 = [](std::vector<unsigned char> &b, unsigned v) {
+      b.push_back(v & 0xff);
+      b.push_back((v >> 8) & 0xff);
+    };
+    auto le32 = [](std::vector<unsigned char> &b, unsigned v) {
+      for (int i = 0; i < 4; i++)
+        b.push_back((v >> (8 * i)) & 0xff);
+    };
+    std::vector<unsigned char> acl;
+    le32(acl, 2);
+    const unsigned undef = 0xffffffffu;
+    le16(acl, 0x01), le16(acl, 7), le32(acl, undef);
+    le16(acl, 0x02), le16(acl, 4), le32(acl, ::geteuid() + 1);
+    le16(acl, 0x04), le16(acl, 0), le32(acl, undef);
+    le16(acl, 0x10), le16(acl, 4), le32(acl, undef);
+    le16(acl, 0x20), le16(acl, 0), le32(acl, undef);
+    if (::setxattr(
+            p.c_str(), "system.posix_acl_access", acl.data(), acl.size(), 0)
+        != 0) {
+      WARN("filesystem does not support POSIX ACLs; ACL case not exercised");
+    } else {
+      desc::RuntimeDirectory dir;
+      REQUIRE(desc::openDirectory(p, {}, dir).code == Code::unsafe_directory);
+    }
+  }
+
+  THEN("a missing directory is created private from creation when asked")
+  {
+    const auto p = tmp.path + "/fresh";
+    desc::RuntimeDirectory dir;
+    REQUIRE(desc::openDirectory(p, {}, dir).code == Code::not_found);
+    REQUIRE_FALSE(exists(p));
+    const auto old = ::umask(0);
+    desc::DirectoryOptions opt;
+    opt.create = true;
+    const auto s = desc::openDirectory(p, opt, dir);
+    ::umask(old);
+    REQUIRE(s.ok());
+    REQUIRE(modeOf(p) == 0700);
+    AND_THEN("create never repairs an existing unsafe directory")
+    {
+      const auto bad = tmp.sub("bad", 0755);
+      REQUIRE(
+          desc::openDirectory(bad, opt, dir).code == Code::unsafe_directory);
+      REQUIRE(modeOf(bad) == 0755);
+    }
+  }
+
+  THEN("the OS runtime location is validated like an explicit directory")
+  {
+    const char *prev = std::getenv("XDG_RUNTIME_DIR");
+    const std::string saved = prev ? prev : "";
+    const auto unsafe = tmp.sub("xdg-unsafe", 0755);
+    ::setenv("XDG_RUNTIME_DIR", unsafe.c_str(), 1);
+    desc::RuntimeDirectory dir;
+    const auto rejected = desc::openOsRuntimeDirectory(dir).code;
+    const bool noChild = !exists(unsafe + "/vsr");
+
+    const auto safe = tmp.sub("xdg-safe", 0700);
+    ::setenv("XDG_RUNTIME_DIR", safe.c_str(), 1);
+    const auto accepted = desc::openOsRuntimeDirectory(dir);
+    if (prev)
+      ::setenv("XDG_RUNTIME_DIR", saved.c_str(), 1);
+    else
+      ::unsetenv("XDG_RUNTIME_DIR");
+
+    REQUIRE(rejected == Code::unsafe_directory);
+    REQUIRE(noChild);
+    REQUIRE(modeOf(unsafe) == 0755);
+    REQUIRE(accepted.ok());
+    REQUIRE(dir.path() == safe + "/vsr");
+    REQUIRE(modeOf(safe + "/vsr") == 0700);
+  }
+}
+
+SCENARIO(
+    "Descriptors are published privately, atomically and without "
+    "replacement",
+    "[integration]")
+{
+  TempDir tmp;
+  desc::RuntimeDirectory dir;
+  REQUIRE(desc::openDirectory(tmp.path, {}, dir).ok());
+  const auto name = desc::fileNameFor(kId);
+  const auto path = tmp.path + "/" + name;
+
+  WHEN("a descriptor is published")
+  {
+    std::unique_ptr<desc::PublishedDescriptor> pub;
+    REQUIRE(desc::publish(dir, sample(), pub).ok());
+    REQUIRE(pub);
+
+    THEN("it is a complete 0600 file under the fresh name, with no temp left")
+    {
+      REQUIRE(pub->path() == path);
+      REQUIRE(modeOf(path) == 0600);
+      REQUIRE(entries(tmp.path) == std::vector<std::string>{name});
+      REQUIRE(slurp(path) == desc::serialize(sample()));
+    }
+
+    THEN("a reader validates and parses the opened file")
+    {
+      desc::Descriptor d;
+      REQUIRE(desc::read(dir, name, d).ok());
+      REQUIRE(d.launchCredential == kCred);
+      desc::Descriptor d2;
+      REQUIRE(desc::read(path, d2).ok());
+      REQUIRE(d2.launchId == kId);
+    }
+
+    THEN("announcing prints the path but never the credential")
+    {
+      std::ostringstream os;
+      pub->announce(os);
+      REQUIRE(os.str().find(path) != std::string::npos);
+      REQUIRE(os.str().find(kCred) == std::string::npos);
+    }
+
+    THEN("orderly shutdown removes it")
+    {
+      REQUIRE(pub->remove().ok());
+      REQUIRE_FALSE(exists(path));
+      REQUIRE(pub->remove().ok()); // idempotent
+    }
+
+    THEN("destruction removes it")
+    {
+      pub.reset();
+      REQUIRE_FALSE(exists(path));
+    }
+
+    THEN("a replaced entry is left untouched at shutdown")
+    {
+      REQUIRE(::unlink(path.c_str()) == 0);
+      writeFile(path, "someone else", 0600);
+      REQUIRE(pub->remove().code == Code::unsafe_file);
+      REQUIRE(slurp(path) == "someone else");
+    }
+
+    THEN("a symlink substituted for the entry is left untouched")
+    {
+      REQUIRE(::unlink(path.c_str()) == 0);
+      const auto target = tmp.sub("target", 0700);
+      REQUIRE(::symlink(target.c_str(), path.c_str()) == 0);
+      REQUIRE(pub->remove().code == Code::unsafe_file);
+      REQUIRE(exists(path));
+      REQUIRE(exists(target));
+    }
+
+    THEN("a missing entry is reported, not an error elsewhere")
+    {
+      REQUIRE(::unlink(path.c_str()) == 0);
+      REQUIRE(pub->remove().code == Code::not_found);
+    }
+
+    THEN("publishing the same launch again fails closed without overwrite")
+    {
+      std::unique_ptr<desc::PublishedDescriptor> again;
+      auto other = sample();
+      other.port = 9999;
+      REQUIRE(
+          desc::publish(dir, other, again).code == Code::destination_exists);
+      REQUIRE_FALSE(again);
+      REQUIRE(slurp(path) == desc::serialize(sample()));
+      REQUIRE(entries(tmp.path) == std::vector<std::string>{name});
+    }
+  }
+
+  THEN("a pre-existing destination of any kind fails closed, unmodified")
+  {
+    const auto target = tmp.sub("target", 0700);
+    SECTION("regular file")
+    {
+      writeFile(path, "old", 0644);
+    }
+    SECTION("symlink")
+    {
+      REQUIRE(::symlink(target.c_str(), path.c_str()) == 0);
+    }
+    SECTION("dangling symlink")
+    {
+      REQUIRE(::symlink((tmp.path + "/nowhere").c_str(), path.c_str()) == 0);
+    }
+    SECTION("directory")
+    {
+      REQUIRE(::mkdir(path.c_str(), 0700) == 0);
+    }
+    SECTION("fifo")
+    {
+      REQUIRE(::mkfifo(path.c_str(), 0600) == 0);
+    }
+    struct stat before;
+    REQUIRE(::lstat(path.c_str(), &before) == 0);
+    std::unique_ptr<desc::PublishedDescriptor> pub;
+    REQUIRE(desc::publish(dir, sample(), pub).code == Code::destination_exists);
+    REQUIRE_FALSE(pub);
+    struct stat after;
+    REQUIRE(::lstat(path.c_str(), &after) == 0);
+    REQUIRE(before.st_ino == after.st_ino);
+    REQUIRE(before.st_mode == after.st_mode);
+    REQUIRE(before.st_size == after.st_size);
+    REQUIRE_FALSE(exists(tmp.path + "/nowhere"));
+    // No other name was used and no temporary remains.
+    REQUIRE(entries(tmp.path).size() == 2);
+  }
+
+  THEN("publishing into a directory that became unsafe is rejected")
+  {
+    REQUIRE(::chmod(tmp.path.c_str(), 0750) == 0);
+    std::unique_ptr<desc::PublishedDescriptor> pub;
+    REQUIRE(desc::publish(dir, sample(), pub).code == Code::unsafe_directory);
+    REQUIRE_FALSE(exists(path));
+    REQUIRE(modeOf(tmp.path) == 0750);
+    REQUIRE(::chmod(tmp.path.c_str(), 0700) == 0);
+  }
+
+  THEN("an invalid descriptor is never published")
+  {
+    auto d = sample();
+    d.launchCredential = "short";
+    std::unique_ptr<desc::PublishedDescriptor> pub;
+    REQUIRE(desc::publish(dir, d, pub).code == Code::invalid_descriptor);
+    REQUIRE(entries(tmp.path).empty());
+  }
+
+  THEN("concurrent launches publish and clean up independently")
+  {
+    std::unique_ptr<desc::PublishedDescriptor> a, b;
+    REQUIRE(desc::publish(dir, sample(kId), a).ok());
+    REQUIRE(desc::publish(dir, sample(kId2), b).ok());
+    REQUIRE(entries(tmp.path).size() == 2);
+    REQUIRE(a->remove().ok());
+    REQUIRE_FALSE(exists(a->path()));
+    desc::Descriptor d;
+    REQUIRE(desc::read(dir, desc::fileNameFor(kId2), d).ok());
+    REQUIRE(d.launchId == kId2);
+  }
+
+  THEN("the published credential never appears in status text")
+  {
+    std::unique_ptr<desc::PublishedDescriptor> a, b;
+    REQUIRE(desc::publish(dir, sample(), a).ok());
+    const auto s = desc::publish(dir, sample(), b);
+    REQUIRE_FALSE(s.ok());
+    REQUIRE(s.reason.find(kCred) == std::string::npos);
+    auto bad = sample();
+    bad.launchCredential = std::string(kCred) + "x";
+    const auto s2 = desc::publish(dir, bad, b);
+    REQUIRE(s2.reason.find(kCred) == std::string::npos);
+  }
+}
+
+SCENARIO("Readers validate the opened file", "[integration]")
+{
+  TempDir tmp;
+  desc::RuntimeDirectory dir;
+  REQUIRE(desc::openDirectory(tmp.path, {}, dir).ok());
+  const auto name = desc::fileNameFor(kId);
+  const auto path = tmp.path + "/" + name;
+  const auto good = desc::serialize(sample());
+  desc::Descriptor d;
+
+  THEN("a well-formed private file is accepted")
+  {
+    writeFile(path, good, 0600);
+    REQUIRE(desc::read(dir, name, d).ok());
+  }
+  THEN("group/other readable files are rejected")
+  {
+    writeFile(path, good, 0644);
+    REQUIRE(desc::read(dir, name, d).code == Code::unsafe_file);
+    REQUIRE(modeOf(path) == 0644);
+  }
+  THEN("symlinks are rejected, even to a valid file")
+  {
+    const auto real = tmp.path + "/real.json";
+    writeFile(real, good, 0600);
+    REQUIRE(::symlink(real.c_str(), path.c_str()) == 0);
+    REQUIRE(desc::read(dir, name, d).code == Code::unsafe_file);
+    REQUIRE(desc::read(path, d).code == Code::unsafe_file);
+  }
+  THEN("non-regular entries are rejected")
+  {
+    REQUIRE(::mkfifo(path.c_str(), 0600) == 0);
+    REQUIRE(desc::read(dir, name, d).code == Code::unsafe_file);
+  }
+  THEN("oversized files are rejected")
+  {
+    writeFile(path, good + std::string(desc::maxDescriptorBytes, ' '), 0600);
+    REQUIRE(desc::read(dir, name, d).code == Code::unsafe_file);
+  }
+  THEN("schema violations are rejected")
+  {
+    writeFile(path, good.substr(0, good.size() / 2), 0600);
+    REQUIRE(desc::read(dir, name, d).code == Code::invalid_descriptor);
+  }
+  THEN("absence is reported as not found")
+  {
+    REQUIRE(desc::read(dir, name, d).code == Code::not_found);
+  }
+  THEN("path traversal names are rejected")
+  {
+    REQUIRE(desc::read(dir, "../x.json", d).code == Code::unsafe_file);
+    REQUIRE(desc::read(dir, "..", d).code == Code::unsafe_file);
+  }
+  THEN("a path reader rejects an unsafe containing directory")
+  {
+    const auto open = tmp.sub("open", 0755);
+    writeFile(open + "/" + name, good, 0600);
+    REQUIRE(desc::read(open + "/" + name, d).code == Code::unsafe_directory);
+  }
+  THEN("a file owned by another account is rejected")
+  {
+    writeFile(path, good, 0600);
+    desc::DirectoryOptions opt;
+    opt.owner = ::geteuid() + 1;
+    // Directory ownership check fires first for the path reader.
+    REQUIRE_FALSE(desc::read(path, d, opt).ok());
+  }
+}
