+SCENARIO("Cancelled or timed-out work stays terminal despite late results",
+    "[integration]")
+{
+  Fixture f;
+  auto &op = f.newOp();
+  std::function<void()> wake;
+  bool backendDone = false;
+  op.script = [&](StepContext &ctx, int) {
+    wake = ctx.wake;
+    Step s;
+    if (!backendDone) {
