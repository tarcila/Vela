+  REQUIRE(s.heldSlots == 1);
+  REQUIRE(f.engine->slotsInUse() == 1);
+
+  backendDone = true;
+  wake();
+  f.integration.service();
+  s = f.status(1);
+  REQUIRE(s.terminal == Outcome::TIMEOUT);
+  REQUIRE(s.result.empty());
