+SCENARIO("A never-releasing backend holds its slot in awaiting_cleanup",
+    "[integration]")
+{
+  Limits limits;
+  limits.sceneSlots = 1;
+  Fixture f(limits);
+  auto &op = f.newOp();
+  op.script = [](StepContext &, int) {
