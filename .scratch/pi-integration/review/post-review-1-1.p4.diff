+  GIVEN("cancel of a reference not yet admitted")
+  {
+    REQUIRE(f.engine->cancel(f.creds, f.ref(50)).code == Outcome::UNKNOWN);
+    REQUIRE(f.engine->cancel(f.creds, f.ref(1)).terminal == Outcome::TIMEOUT);
