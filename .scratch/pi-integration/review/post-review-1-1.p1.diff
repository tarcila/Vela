@@ -0,0 +1,30 @@
+## SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+## SPDX-License-Identifier: Apache-2.0
+
+# Headless agent-integration core. Deliberately free of UI, Lua, Pi and
+# network dependencies. Sources, including those in module subdirectories, are
+# globbed so later additions need no edit to a shared CMake file.
+
+project(vsr_integration)
+
+project_add_library(STATIC)
+
+file(GLOB_RECURSE VSR_INTEGRATION_SOURCES CONFIGURE_DEPENDS
+  ${CMAKE_CURRENT_LIST_DIR}/*.cpp
+)
+project_sources(PRIVATE ${VSR_INTEGRATION_SOURCES})
+
+project_include_directories(
+PUBLIC
+  $<BUILD_INTERFACE:${CMAKE_CURRENT_LIST_DIR}/../..>
+)
+
+find_package(Threads REQUIRED)
+project_link_libraries(PUBLIC vsr_scene Threads::Threads)
+# PNG deflate via the vendored stb writer; an implementation detail.
+project_link_libraries(PRIVATE $<BUILD_INTERFACE:vela_ext_stb_image>)
+
+# Embedded MCP server (header-only under mcp/); opt-in, no extra dependency.
+if (VSR_USE_INTEGRATION_MCP)
+  project_compile_definitions(PUBLIC VSR_USE_INTEGRATION_MCP)
+endif()
diff --git a/src/vsr/integration/Integration.cpp b/src/vsr/integration/Integration.cpp
new file mode 100644
index 0000000000..dae81e8641
--- /dev/null
+++ b/src/vsr/integration/Integration.cpp
@@ -0,0 +1,247 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "Integration.hpp"
+// vsr_scene
+#include "vsr/scene/Scene.hpp"
+// std
+#include <cmath>
+#include <utility>
+
+namespace vsr::integration {
+
+namespace {
+
+bool validDuration(double seconds)
+{
+  return std::isfinite(seconds) && seconds > 0.0;
+}
+
+} // namespace
+
+Integration::~Integration() = default;
+
+// Queries ////////////////////////////////////////////////////////////////////
+
+bool Integration::active() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_active;
+}
+
+bool Integration::isRegisteredScene(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return id < m_scenes.size();
+}
+
+bool Integration::isRegisteredView(ViewId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return id < m_views.size() && !m_views[id].removed;
+}
+
+std::vector<ViewId> Integration::viewsOfScene(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  std::vector<ViewId> views;
+  for (std::size_t i = 0; i < m_views.size(); i++) {
+    if (!m_views[i].removed && m_views[i].registration.scene == id)
+      views.push_back(ViewId(i));
+  }
+  return views;
+}
+
+std::optional<SceneId> Integration::sceneOfView(ViewId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (id >= m_views.size() || m_views[id].removed)
+    return {};
+  return m_views[id].registration.scene;
+}
+
+SceneGrants Integration::sceneGrants(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_scenes.size())
+    return {};
+  return m_scenes[id].registration.grants;
+}
+
+ViewGrants Integration::viewGrants(ViewId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_views.size() || m_views[id].removed)
+    return {};
+  return m_views[id].registration.grants;
+}
+
+SyncHook Integration::normalSyncHook(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_scenes.size())
+    return {};
+  return m_scenes[id].registration.normalSyncHook;
+}
+
+SyncHook Integration::recoveryCallback(SceneId id) const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || id >= m_scenes.size())
+    return {};
+  return m_scenes[id].registration.recoveryCallback;
+}
+
+const SessionTiming &Integration::timing() const
+{
+  return m_timing;
+}
+
+bool Integration::inServiceCall() const
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  return m_servicingThread == std::this_thread::get_id();
+}
+
+// Registration ///////////////////////////////////////////////////////////////
+
+std::optional<SceneId> Integration::registerScene(
+    SceneRegistration registration)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (m_active || registration.scene == nullptr)
+    return {};
+  m_scenes.push_back({std::move(registration)});
+  return SceneId(m_scenes.size() - 1);
+}
+
+std::optional<ViewId> Integration::registerView(ViewRegistration registration)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (registration.scene >= m_scenes.size())
+    return {};
+  if (m_active) {
+    // Post-activation: host scene work at a safe point only.
+    if (m_servicingThread != std::this_thread::get_id())
+      return {};
+    const auto &g = registration.grants;
+    if (g.render && !g.read)
+      return {};
+  }
+  m_views.push_back({std::move(registration)});
+  return ViewId(m_views.size() - 1);
+}
+
+bool Integration::unregisterView(ViewId id)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  if (!m_active || m_servicingThread != std::this_thread::get_id()
+      || id >= m_views.size() || m_views[id].removed)
+    return false;
+  m_views[id].removed = true;
+  return true;
+}
+
+// Activation /////////////////////////////////////////////////////////////////
+
+ActivationResult Integration::validate(const SessionTiming &timing) const
+{
+  if (m_active)
+    return {ActivationError::ALREADY_ACTIVE, {}};
+  if (!validDuration(timing.leaseSeconds))
+    return {ActivationError::INVALID_LEASE, {}};
+  if (!validDuration(timing.renewalSeconds))
+    return {ActivationError::INVALID_RENEWAL, {}};
+  if (!(timing.renewalSeconds < timing.leaseSeconds))
+    return {ActivationError::RENEWAL_NOT_SHORTER_THAN_LEASE, {}};
+
+  for (const auto &s : m_scenes) {
+    const auto &r = s.registration;
+    if ((r.grants.edit || r.grants.resynchronize) && !r.grants.read)
+      return {ActivationError::ACTION_WITHOUT_READ, r.name};
+    if (r.grants.edit && !r.normalSyncHook)
+      return {ActivationError::MISSING_SYNC_HOOK, r.name};
+    if (r.grants.resynchronize && !r.recoveryCallback)
+      return {ActivationError::MISSING_RECOVERY_CALLBACK, r.name};
+  }
+
+  for (const auto &v : m_views) {
+    const auto &r = v.registration;
+    if (r.grants.render && !r.grants.read)
+      return {ActivationError::ACTION_WITHOUT_READ, r.name};
+  }
+
+  return {};
+}
+
+ActivationResult Integration::activate(SessionTiming timing)
+{
+  std::lock_guard<std::mutex> lock(m_mutex);
+  auto result = validate(timing);
+  if (result.ok()) {
+    m_timing = timing;
+    m_active = true;
+  }
+  return result;
+}
+
+// Execution //////////////////////////////////////////////////////////////////
+
+bool Integration::submit(SceneId target, SceneWork work)
+{
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_active || target >= m_scenes.size() || !work)
+      return false;
+    m_queue.push_back({target, std::move(work)});
+  }
+  m_workAvailable.notify_all();
+  return true;
+}
+
+std::size_t Integration::service()
+{
+  std::deque<PendingWork> batch;
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    batch.swap(m_queue);
+    m_servicingThread = std::this_thread::get_id();
+  }
+
+  for (auto &item : batch) {
+    // Registrations are immutable after activation, so the pointer is stable.
+    auto *scene = m_scenes[item.target].registration.scene;
+    item.work(*scene);
+  }
+
+  std::lock_guard<std::mutex> lock(m_mutex);
+  m_servicingThread = std::thread::id();
+  return batch.size();
+}
+
+void Integration::runServiceLoop()
+{
+  for (;;) {
+    {
+      std::unique_lock<std::mutex> lock(m_mutex);
+      m_workAvailable.wait(
+          lock, [&] { return m_stopRequested || !m_queue.empty(); });
+      if (m_stopRequested && m_queue.empty()) {
+        m_stopRequested = false;
+        return;
+      }
+    }
+    service();
+  }
+}
+
+void Integration::requestStop()
+{
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_stopRequested = true;
+  }
+  m_workAvailable.notify_all();
+}
+
+} // namespace vsr::integration
diff --git a/src/vsr/integration/Integration.hpp b/src/vsr/integration/Integration.hpp
new file mode 100644
index 0000000000..220a734fa3
--- /dev/null
+++ b/src/vsr/integration/Integration.hpp
@@ -0,0 +1,193 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// std
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <limits>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace vsr::scene {
+struct Scene;
+} // namespace vsr::scene
+
+namespace vsr::integration {
+
+/*
+ * Headless, transport-independent agent-integration core.
+ *
+ * The host registers the scenes and views it chooses to expose, together with
+ * a per-target capability ceiling, then explicitly activates the integration.
+ * Nothing is controllable before activation. Work submitted from any thread is
+ * queued and only runs when the host services it at a safe execution point
+ * (service() or runServiceLoop()), on the servicing thread.
+ */
+
+using SceneId = std::uint32_t;
+using ViewId = std::uint32_t;
+
+constexpr SceneId INVALID_SCENE_ID = std::numeric_limits<SceneId>::max();
+constexpr ViewId INVALID_VIEW_ID = std::numeric_limits<ViewId>::max();
+
+// Omitted grants are denied, including read.
+struct SceneGrants
+{
+  bool read{false};
+  bool edit{false};
+  bool resynchronize{false};
+};
+
+struct ViewGrants
+{
+  bool read{false};
+  bool render{false};
+};
+
+// Returns true when the host confirms downstream state is ready to render.
+using SyncHook = std::function<bool(SceneId)>;
+
+struct SceneRegistration
+{
+  std::string name;
+  scene::Scene *scene{nullptr};
+  SceneGrants grants;
+  SyncHook normalSyncHook; // required when grants.edit
+  SyncHook recoveryCallback; // required when grants.resynchronize
+};
+
+struct ViewRegistration
+{
+  std::string name;
+  SceneId scene{INVALID_SCENE_ID};
+  ViewGrants grants;
+};
+
+struct SessionTiming
+{
+  double leaseSeconds{120.0};
+  double renewalSeconds{30.0};
+};
+
+enum class ActivationError
+{
+  NONE,
+  ALREADY_ACTIVE,
+  ACTION_WITHOUT_READ,
+  MISSING_SYNC_HOOK,
+  MISSING_RECOVERY_CALLBACK,
+  INVALID_LEASE,
+  INVALID_RENEWAL,
+  RENEWAL_NOT_SHORTER_THAN_LEASE
+};
+
+struct ActivationResult
+{
+  ActivationError error{ActivationError::NONE};
+  std::string target; // offending target name, when applicable
+
+  bool ok() const;
+};
+
+using SceneWork = std::function<void(scene::Scene &)>;
+
+class Integration
+{
+ public:
+  Integration() = default;
+  ~Integration();
+
+  Integration(const Integration &) = delete;
+  Integration &operator=(const Integration &) = delete;
+
+  // Queries //
+
+  bool active() const;
+  bool isRegisteredScene(SceneId id) const;
+  bool isRegisteredView(ViewId id) const;
+  std::optional<SceneId> sceneOfView(ViewId id) const;
+  // Effective ceilings; all-denied while inactive or for unregistered ids.
+  SceneGrants sceneGrants(SceneId id) const;
+  ViewGrants viewGrants(ViewId id) const;
+  // The registered normal-synchronization hook; empty while inactive or for
+  // unregistered ids.
+  SyncHook normalSyncHook(SceneId id) const;
+  // The registered recovery callback; empty while inactive or for
+  // unregistered ids.
+  SyncHook recoveryCallback(SceneId id) const;
+  const SessionTiming &timing() const;
+  // True only on the servicing thread while it runs submitted work.
+  bool inServiceCall() const;
+
+  // Host registration (host thread, before activation) //
+
+  std::optional<SceneId> registerScene(SceneRegistration registration);
+  // Before activation from the host thread; after activation only as host
+  // scene work on the servicing thread (see sync::SyncService), so the view
+  // set never changes while a synchronization hook runs.
+  std::optional<ViewId> registerView(ViewRegistration registration);
+  // After activation, servicing thread only. Ids are never reused.
+  bool unregisterView(ViewId id);
+  std::vector<ViewId> viewsOfScene(SceneId id) const;
+
+  // Activation //
+
+  ActivationResult activate(SessionTiming timing = {});
+
+  // Execution //
+
+  // Thread-safe. Rejected while inactive or for an unregistered scene.
+  bool submit(SceneId target, SceneWork work);
+  // Host safe point: runs all currently queued work on the calling thread.
+  std::size_t service();
+  // Blocking headless service loop; returns after requestStop().
+  void runServiceLoop();
+  // Thread-safe.
+  void requestStop();
+
+ private:
+  struct SceneEntry
+  {
+    SceneRegistration registration;
+  };
+
+  struct ViewEntry
+  {
+    ViewRegistration registration;
+    bool removed{false};
+  };
+
+  struct PendingWork
+  {
+    SceneId target{INVALID_SCENE_ID};
+    SceneWork work;
+  };
+
+  ActivationResult validate(const SessionTiming &timing) const;
+
+  mutable std::mutex m_mutex;
+  std::condition_variable m_workAvailable;
+  bool m_active{false};
+  bool m_stopRequested{false};
+  SessionTiming m_timing;
+  std::vector<SceneEntry> m_scenes;
+  std::vector<ViewEntry> m_views;
+  std::deque<PendingWork> m_queue;
+  std::thread::id m_servicingThread;
+};
+
+// Inlined definitions ////////////////////////////////////////////////////////
+
+inline bool ActivationResult::ok() const
+{
+  return error == ActivationError::NONE;
+}
+
+} // namespace vsr::integration
diff --git a/src/vsr/integration/activity/Activity.hpp b/src/vsr/integration/activity/Activity.hpp
new file mode 100644
index 0000000000..a8829d4ea7
--- /dev/null
+++ b/src/vsr/integration/activity/Activity.hpp
@@ -0,0 +1,690 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// Application-owned activity/history model (spec §4, §5, §9, §13).
+//
+// Headless and ImGui-free. Records survive client disconnect (the log is
+// owned by the application, not a session) but not restart (nothing is
+// persisted). Retention is bounded by bytes, entry count, restorable-batch
+// count and a separate retained-image byte budget.
+
+#include "vsr/integration/edit/AgentEdit.hpp"
+#include "vsr/integration/operations/Operations.hpp"
+#include "vsr/integration/session/SessionAuthority.hpp"
+// std
+#include <cstdint>
+#include <list>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace vsr::integration::activity {
+
+using edit::BatchRef;
+using operations::LocalRef;
+using operations::OperationRef;
+using operations::Outcome;
+using operations::Progress;
+using session::Capability;
+using session::Credentials;
+using session::SessionAuthority;
+using session::Target;
+
+struct Limits
+{
+  std::size_t bytes{16u << 20}; // activity + restoration payloads
+  std::size_t entries{1024};
+  std::size_t restorableBatches{32};
+  std::size_t imageBytes{32u << 20}; // retained images, counted only here
+
+  bool valid() const
+  {
+    return bytes > 0 && entries > 0 && restorableBatches > 0;
+  }
+};
+
+// Fixed per-entry accounting overhead, in bytes, on top of payloads.
+constexpr std::size_t ENTRY_OVERHEAD = 256;
+
+enum class OperationKind
+{
+  DISCOVERY,
+  INSPECTION,
+  RENDER,
+  EDIT,
+  RESTORE,
+  RESYNCHRONIZE,
+  STATUS_LOOKUP
+};
+
+inline const char *operationKindName(OperationKind k)
+{
+  switch (k) {
+  case OperationKind::DISCOVERY:
+    return "discovery";
+  case OperationKind::INSPECTION:
+    return "inspection";
+  case OperationKind::RENDER:
+    return "render";
+  case OperationKind::EDIT:
+    return "edit";
+  case OperationKind::RESTORE:
+    return "restore";
+  case OperationKind::RESYNCHRONIZE:
+    return "resynchronize";
+  case OperationKind::STATUS_LOOKUP:
+    return "status_lookup";
+  }
+  return "unknown";
+}
+
+enum class Eligibility
+{
+  NONE, // not a restorable batch
+  ELIGIBLE,
+  RESTORED,
+  EXPIRED, // evicted from the restorable set; metadata retained
+  CONFLICTING
+};
+
+// Where the record's facts come from. Client summaries never become
+// VSR-observed facts.
+struct ClientSummary
+{
+  std::string text; // attributed description, not proof or instruction
+};
+
+struct Entry
+{
+  // Correlation: external work has `ref`; host-local work has `localRef`.
+  std::optional<OperationRef> ref;
+  std::optional<LocalRef> localRef;
+
+  // VSR-observed facts //
+  OperationKind kind{OperationKind::INSPECTION};
+  // Covered targets, fixed per kind; see coveredTargets().
+  std::vector<Target> targets;
+  std::optional<Progress> progress;
+  std::optional<Outcome> terminal;
+  bool committed{false};
+  double admittedAt{0.0};
+  double finishedAt{0.0};
+  double cleanupElapsedSeconds{0.0};
+  std::size_t heldSlots{0};
+  std::optional<BatchRef> batchRef;
+  std::string result; // scene-bearing payload
+  std::size_t restorationBytes{0}; // payload retained for restoration
+  Eligibility eligibility{Eligibility::NONE};
+  std::vector<std::uint8_t> image; // retained image (own budget)
+  bool imageEvicted{false};
+
+  // Client-supplied, attributed separately //
+  std::optional<ClientSummary> clientSummary;
+
+  // Active work is never evicted.
+  bool active{false};
+};
+
+// Allowlisted owner receipt: no scene values, names, handles, tokens,
+// Batch References, images, summaries or diagnostics.
+struct Receipt
+{
+  OperationRef ref;
+  OperationKind kind{OperationKind::INSPECTION};
+  std::optional<Progress> progress;
+  std::optional<Outcome> terminal;
+  bool committed{false};
+  double admittedAt{0.0};
+  double finishedAt{0.0};
+  double cleanupElapsedSeconds{0.0};
+  std::size_t heldSlots{0};
+};
+
+struct Lookup
+{
+  Outcome code{Outcome::OK};
+  std::optional<Receipt> receipt;
+  // Present only with current read on every covered target.
+  std::optional<Entry> record;
+};
+
+struct Usage
+{
+  std::size_t bytes{0};
+  std::size_t entries{0};
+  std::size_t restorableBatches{0};
+  std::size_t imageBytes{0};
+};
+
+// Covered targets per operation kind (spec §9). `primary` is the
+// registered scene (or view for render); discovery pages list their items.
+inline std::vector<Target> coveredTargets(OperationKind kind,
+    Target primary,
+    const Integration &integration,
+    const std::vector<Target> &listed = {})
+{
+  switch (kind) {
+  case OperationKind::DISCOVERY:
+  case OperationKind::STATUS_LOOKUP:
+    return listed;
+  case OperationKind::RENDER: {
+    std::vector<Target> t{primary};
+    if (auto s = integration.sceneOfView(primary.id))
+      t.push_back(Target::scene(*s));
+    return t;
+  }
+  default:
+    return {primary};
+  }
+}
+
+class ActivityLog
+{
+ public:
+  using Id = std::uint64_t;
+
+  explicit ActivityLog(Limits limits = {}) : m_limits(limits) {}
+
+  const Limits &limits() const
+  {
+    return m_limits;
+  }
+
+  // Appends a record, evicting the oldest safe records to fit. Returns
+  // nullopt (busy) when the record cannot fit without evicting active work;
+  // callers must then reject before commit.
+  std::optional<Id> append(Entry entry)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (entry.eligibility == Eligibility::ELIGIBLE && !makeRestorableRoom())
+      return std::nullopt;
+    const std::size_t need = cost(entry);
+    if (!makeRoom(need, 1))
+      return std::nullopt;
+    if (entry.image.size() > m_limits.imageBytes
+        || !makeImageRoom(entry.image.size()))
+      entry.image.clear(), entry.imageEvicted = true;
+    Slot s;
+    s.id = ++m_serial;
+    s.entry = std::move(entry);
+    m_usage.bytes += need;
+    m_usage.entries++;
+    m_usage.imageBytes += s.entry.image.size();
+    if (s.entry.eligibility == Eligibility::ELIGIBLE)
+      m_usage.restorableBatches++;
+    m_slots.push_back(std::move(s));
+    return m_serial;
+  }
+
+  // Replaces an entry's state (e.g. on completion). False when evicted or
+  // when the grown record cannot fit.
+  bool update(Id id, Entry entry)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = findId(id);
+    if (it == m_slots.end())
+      return false;
+    if (it->restorationReserved) {
+      // The reservation is owned by reserve/cancel/publishRestoration.
+      entry.batchRef = it->entry.batchRef;
+      entry.restorationBytes = it->entry.restorationBytes;
+      entry.eligibility = Eligibility::NONE;
+    }
+    const std::size_t oldCost = cost(it->entry);
+    const std::size_t newCost = cost(entry);
+    it->pinned = true; // don't evict the record being updated
+    bool ok = newCost <= oldCost || makeRoom(newCost - oldCost, 0);
+    it->pinned = false;
+    if (!ok)
+      return false;
+    m_usage.bytes = m_usage.bytes - oldCost + newCost;
+    m_usage.imageBytes -= it->entry.image.size();
+    if (it->entry.eligibility == Eligibility::ELIGIBLE)
+      m_usage.restorableBatches--;
+    if (entry.eligibility == Eligibility::ELIGIBLE)
+      m_usage.restorableBatches++;
+    it->entry = std::move(entry);
+    m_usage.imageBytes += it->entry.image.size();
+    return true;
+  }
+
+  std::optional<Entry> get(Id id) const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = findId(id);
+    if (it == m_slots.end())
+      return std::nullopt;
+    return it->entry;
+  }
+
+  // A retained entry with its log id.
+  struct Record
+  {
+    Id id{0};
+    Entry entry;
+  };
+
+  // Consistent, ordered (oldest first) snapshot of every retained entry,
+  // taken under the log's lock. Ids are strictly increasing.
+  std::vector<Record> snapshot() const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    std::vector<Record> out;
+    out.reserve(m_slots.size());
+    for (auto &s : m_slots)
+      out.push_back({s.id, s.entry});
+    return out;
+  }
+
+  // Restoration eligibility of a Batch Reference while its metadata is
+  // retained; nullopt once the record is gone (outcome_unavailable).
+  std::optional<Eligibility> eligibility(const BatchRef &ref) const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (auto &s : m_slots)
+      if (s.entry.batchRef && *s.entry.batchRef == ref)
+        return s.entry.eligibility;
+    return std::nullopt;
+  }
+
+  // Restoration storage for an admitted edit (spec §5): charges `bytes` of
+  // payload to the shared byte budget and holds one restorable-batch slot,
+  // visibly expiring the oldest eligible batches and evicting older safe
+  // records as needed. False (reject busy before commit) when it cannot fit
+  // without evicting active work; nothing is evicted then.
+  bool reserveRestoration(Id id, std::size_t bytes, BatchRef ref)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = findId(id);
+    if (it == m_slots.end() || it->restorationReserved
+        || it->entry.eligibility != Eligibility::NONE)
+      return false;
+    Entry grown = it->entry;
+    grown.batchRef = std::move(ref);
+    grown.restorationBytes = bytes;
+    const std::size_t oldCost = cost(it->entry);
+    const std::size_t newCost = cost(grown);
+    it->pinned = true;
+    // Check the byte budget before expiring anything.
+    bool ok = newCost <= oldCost || feasible(newCost - oldCost, 0);
+    if (ok)
+      ok = makeRestorableRoom();
+    if (ok)
+      ok = newCost <= oldCost || makeRoom(newCost - oldCost, 0);
+    it->pinned = false;
+    if (!ok)
+      return false;
+    m_usage.bytes = m_usage.bytes - oldCost + newCost;
+    it->entry = std::move(grown);
+    it->restorationReserved = true;
+    m_reservedRestorable++;
+    return true;
+  }
+
+  // Releases an unpublished reservation and its payload bytes.
+  void cancelRestoration(Id id)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = findId(id);
+    if (it == m_slots.end() || !it->restorationReserved)
+      return;
+    const std::size_t oldCost = cost(it->entry);
+    it->entry.batchRef.reset();
+    it->entry.restorationBytes = 0;
+    m_usage.bytes = m_usage.bytes - oldCost + cost(it->entry);
+    it->restorationReserved = false;
+    m_reservedRestorable--;
+  }
+
+  // Commit: the reserved batch becomes an eligible restorable batch.
+  void publishRestoration(Id id)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = findId(id);
+    if (it == m_slots.end() || !it->restorationReserved)
+      return;
+    it->restorationReserved = false;
+    m_reservedRestorable--;
+    it->entry.eligibility = Eligibility::ELIGIBLE;
+    m_usage.restorableBatches++;
+  }
+
+  // Consumes eligibility at restoration commit and releases its payload.
+  bool markRestored(const BatchRef &ref)
+  {
+    return setEligibility(ref, Eligibility::RESTORED);
+  }
+  bool markConflicting(const BatchRef &ref)
+  {
+    return setEligibility(ref, Eligibility::CONFLICTING);
+  }
+
+  // Authorized lookup by complete Operation Reference (spec §4, §9).
+  Lookup lookup(SessionAuthority &authority,
+      const Credentials &credentials,
+      const OperationRef &ref) const
+  {
+    Lookup out;
+    out.code = operations::fromSessionCode(authority.authenticate(credentials));
+    if (out.code != Outcome::OK)
+      return out;
+    std::optional<Entry> e;
+    {
+      std::lock_guard<std::mutex> lock(m_mutex);
+      for (auto &s : m_slots)
+        if (s.entry.ref && s.entry.ref->sessionId == ref.sessionId
+            && s.entry.ref->requestId == ref.requestId)
+          e = s.entry;
+    }
+    if (!e) {
+      out.code = Outcome::OUTCOME_UNAVAILABLE;
+      return out;
+    }
+    // Discovery covers exactly the targets its page lists; like the engine,
+    // an empty page is readable by any live session (spec §9).
+    bool readAll = !e->targets.empty() || e->kind == OperationKind::DISCOVERY;
+    for (auto &t : e->targets)
+      if (authority.authorizeExecution(
+              credentials.sessionId, t, Capability::READ)
+          != session::Code::OK)
+        readAll = false;
+    const bool own = ref.sessionId == credentials.sessionId;
+    if (!readAll && !own) {
+      out.code = Outcome::FORBIDDEN; // whole record or nothing
+      return out;
+    }
+    if (own)
+      out.receipt = receiptOf(*e);
+    if (readAll)
+      out.record = std::move(e);
+    return out;
+  }
+
+  Usage usage() const
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_usage;
+  }
+
+  static std::size_t cost(const Entry &e)
+  {
+    std::size_t c = ENTRY_OVERHEAD + e.result.size() + e.restorationBytes
+        + e.targets.size() * sizeof(Target);
+    if (e.ref)
+      c += e.ref->sessionId.size();
+    if (e.batchRef)
+      c += e.batchRef->launchId.size() + e.batchRef->batchId.size();
+    if (e.clientSummary)
+      c += e.clientSummary->text.size();
+    return c;
+  }
+
+  static Receipt receiptOf(const Entry &e)
+  {
+    Receipt r;
+    if (e.ref)
+      r.ref = *e.ref;
+    r.kind = e.kind;
+    r.progress = e.progress;
+    r.terminal = e.terminal;
+    r.committed = e.committed;
+    r.admittedAt = e.admittedAt;
+    r.finishedAt = e.finishedAt;
+    r.cleanupElapsedSeconds = e.cleanupElapsedSeconds;
+    r.heldSlots = e.heldSlots;
+    return r;
+  }
+
+ private:
+  struct Slot
+  {
+    Id id{0};
+    bool pinned{false};
+    bool restorationReserved{false}; // reserved, not yet published
+    Entry entry;
+  };
+  using Slots = std::list<Slot>;
+
+  Slots::iterator findId(Id id)
+  {
+    for (auto it = m_slots.begin(); it != m_slots.end(); ++it)
+      if (it->id == id)
+        return it;
+    return m_slots.end();
+  }
+  Slots::const_iterator findId(Id id) const
+  {
+    for (auto it = m_slots.begin(); it != m_slots.end(); ++it)
+      if (it->id == id)
+        return it;
+    return m_slots.end();
+  }
+
+  bool safe(const Slot &s) const
+  {
+    return !s.entry.active && !s.pinned;
+  }
+
+  bool setEligibility(const BatchRef &ref, Eligibility to)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    for (auto &s : m_slots) {
+      if (!s.entry.batchRef || !(*s.entry.batchRef == ref))
+        continue;
+      if (s.entry.eligibility != Eligibility::ELIGIBLE)
+        return false;
+      loseEligibility(s, to);
+      return true;
+    }
+    return false;
+  }
+
+  void loseEligibility(Slot &s, Eligibility to)
+  {
+    s.entry.eligibility = to;
+    m_usage.restorableBatches--;
+    m_usage.bytes -= s.entry.restorationBytes;
+    s.entry.restorationBytes = 0; // payload released
+  }
+
+  // Oldest safe restorable batch visibly expires; its metadata stays.
+  // Unpublished reservations count against the limit and are never expired.
+  // Makes room for one more.
+  bool makeRestorableRoom()
+  {
+    if (m_reservedRestorable >= m_limits.restorableBatches)
+      return false;
+    while (m_usage.restorableBatches + m_reservedRestorable
+        >= m_limits.restorableBatches) {
+      Slot *victim = nullptr;
+      for (auto &s : m_slots)
+        if (safe(s) && s.entry.eligibility == Eligibility::ELIGIBLE) {
+          victim = &s;
+          break;
+        }
+      if (!victim)
+        return false;
+      loseEligibility(*victim, Eligibility::EXPIRED);
+    }
+    return true;
+  }
+
+  bool fits(std::size_t bytes, std::size_t entries) const
+  {
+    return m_usage.bytes + bytes <= m_limits.bytes
+        && m_usage.entries + entries <= m_limits.entries;
+  }
+
+  // True when evicting every safe record would make room.
+  bool feasible(std::size_t bytes, std::size_t entries) const
+  {
+    if (bytes > m_limits.bytes)
+      return false;
+    std::size_t freeBytes = 0, freeEntries = 0;
+    for (auto &s : m_slots)
+      if (safe(s))
+        freeBytes += cost(s.entry), freeEntries++;
+    return m_usage.bytes - freeBytes + bytes <= m_limits.bytes
+        && m_usage.entries - freeEntries + entries <= m_limits.entries;
+  }
+
+  bool makeRoom(std::size_t bytes, std::size_t entries)
+  {
+    // Check feasibility first so a failing append evicts nothing.
+    if (!feasible(bytes, entries))
+      return false;
+    auto it = m_slots.begin();
+    while (!fits(bytes, entries)) {
+      while (!safe(*it))
+        ++it;
+      m_usage.bytes -= cost(it->entry);
+      m_usage.entries--;
+      m_usage.imageBytes -= it->entry.image.size();
+      if (it->entry.eligibility == Eligibility::ELIGIBLE)
+        m_usage.restorableBatches--;
+      if (it->restorationReserved)
+        m_reservedRestorable--;
+      it = m_slots.erase(it);
+    }
+    return true;
+  }
+
+  // Oldest safe retained images are dropped; their records stay.
+  bool makeImageRoom(std::size_t bytes)
+  {
+    for (auto &s : m_slots) {
+      if (m_usage.imageBytes + bytes <= m_limits.imageBytes)
+        break;
+      if (!safe(s) || s.entry.image.empty())
+        continue;
+      m_usage.imageBytes -= s.entry.image.size();
+      s.entry.image.clear();
+      s.entry.image.shrink_to_fit();
+      s.entry.imageEvicted = true;
+    }
+    return m_usage.imageBytes + bytes <= m_limits.imageBytes;
+  }
+
+  Limits m_limits;
+  mutable std::mutex m_mutex;
+  Slots m_slots; // oldest first
+  Usage m_usage;
+  std::size_t m_reservedRestorable{0};
+  Id m_serial{0};
+};
+
+// Maps an operations::Request kind string onto an OperationKind; unknown
+// kinds (e.g. test or host-defined work) record as inspection.
+inline OperationKind operationKindOf(const std::string &kind)
+{
+  for (auto k : {OperationKind::DISCOVERY,
+           OperationKind::INSPECTION,
+           OperationKind::RENDER,
+           OperationKind::EDIT,
+           OperationKind::RESTORE,
+           OperationKind::RESYNCHRONIZE,
+           OperationKind::STATUS_LOOKUP})
+    if (kind == operationKindName(k))
+      return k;
+  return OperationKind::INSPECTION;
+}
+
+// Feeds OperationEngine transitions into an ActivityLog. Install with
+// OperationEngine::setActivitySink(&sink); the sink must outlive that
+// installation. Only VSR-observed fields are written: a client summary
+// already on the entry is preserved across updates.
+class EngineActivitySink : public operations::ActivitySink
+{
+ public:
+  EngineActivitySink(ActivityLog &log, const Integration &integration)
+      : m_log(log), m_integration(integration)
+  {}
+
+  std::optional<Id> admitted(const operations::ActivityEvent &ev) override
+  {
+    Entry e;
+    e.ref = ev.ref;
+    e.localRef = ev.localRef;
+    e.kind = operationKindOf(ev.kind);
+    e.targets = coveredTargets(e.kind, ev.target, m_integration);
+    e.admittedAt = ev.now;
+    apply(e, ev);
+    return m_log.append(std::move(e));
+  }
+
+  void updated(Id id, const operations::ActivityEvent &ev) override
+  {
+    auto e = m_log.get(id);
+    if (!e)
+      return; // cannot happen while active; evicted once terminal
+    apply(*e, ev);
+    // Session-wide work learns its covered targets only on completion.
+    if (e->kind == OperationKind::DISCOVERY && ev.status.terminal)
+      e->targets =
+          coveredTargets(e->kind, ev.target, m_integration, ev.covered);
+    Entry trimmed = *e;
+    if (m_log.update(id, std::move(*e)))
+      return;
+    // The grown result does not fit: keep the state, drop the payload, so
+    // the record still becomes evictable.
+    trimmed.result.clear();
+    m_log.update(id, std::move(trimmed));
+  }
+
+  bool reserveRestoration(Id id,
+      std::size_t bytes,
+      const std::string &launchId,
+      const std::string &batchId) override
+  {
+    return m_log.reserveRestoration(id, bytes, BatchRef{launchId, batchId});
+  }
+  void cancelRestoration(Id id) override
+  {
+    m_log.cancelRestoration(id);
+  }
+  void publishRestoration(Id id) override
+  {
+    m_log.publishRestoration(id);
+  }
+  bool restorationRetained(
+      const std::string &launchId, const std::string &batchId) override
+  {
+    return m_log.eligibility(BatchRef{launchId, batchId})
+        == Eligibility::ELIGIBLE;
+  }
+  void restorationRestored(
+      const std::string &launchId, const std::string &batchId) override
+  {
+    m_log.markRestored(BatchRef{launchId, batchId});
+  }
+  void restorationConflicting(
+      const std::string &launchId, const std::string &batchId) override
+  {
+    m_log.markConflicting(BatchRef{launchId, batchId});
+  }
+
+ private:
+  static void apply(Entry &e, const operations::ActivityEvent &ev)
+  {
+    const auto &s = ev.status;
+    e.progress = s.progress;
+    if (s.terminal && !e.terminal)
+      e.finishedAt = ev.now;
+    e.terminal = s.terminal;
+    e.committed = s.committed;
+    e.cleanupElapsedSeconds = s.cleanupElapsedSeconds;
+    e.heldSlots = s.heldSlots;
+    if (s.terminal)
+      e.result = s.result;
+    // Evictable once terminal and no backend resources remain held.
+    e.active = !s.terminal || s.heldSlots > 0;
+  }
+
+  ActivityLog &m_log;
+  const Integration &m_integration;
+};
+
+} // namespace vsr::integration::activity
