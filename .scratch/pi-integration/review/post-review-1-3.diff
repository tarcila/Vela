+  using clock = std::chrono::steady_clock;
+  std::atomic<bool> stop{false};
+  std::atomic<bool> firstByte{false};
+  std::thread reader([&] {
+    const auto limit = clock::now() + std::chrono::seconds(20);
+    while (!stop && clock::now() < limit) {
+      pollfd p{fd, POLLIN, 0};
+      if (::poll(&p, 1, 10) > 0) {
+        char c;
+        if (::recv(fd, &c, 1, 0) <= 0)
