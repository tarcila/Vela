+    // only complete if the client actually reads it.
+    mcp::Tool big;
+    big.name = "big";
+    big.description = std::string(32u << 20, 'x');
+    big.handler = [](const session::Credentials &, const mcp::json::Value &) {
+      return mcp::ToolResult{};
+    };
+    c.tools.push_back(std::move(big));
+  });
