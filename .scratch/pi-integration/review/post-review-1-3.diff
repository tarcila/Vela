 inline const std::string *McpServer::header(
     const HttpRequest &req, std::string_view name, int &count)
 {
   const std::string *found = nullptr;
   count = 0;
   for (const auto &[n, v] : req.headers)
     if (n == name) {
       ++count;
       found = &v;
     }
   return found;
 }
 
